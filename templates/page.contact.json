    "contact_cta": {
      "type": "ellora-contact-cta",
      "settings": {
        "title": "Ready to shortlist the right surface?",
        "description": "",
        "btn1_text": "Ask on Whatsapp",
        "btn1_link": "#",
        "btn2_text": "Explore the Collection",
        "btn2_link": "/collections/all",
        "padding_top": 40,
        "padding_bottom": 80
      }
    }
  },
  "order": [
    "contact_hero",
    "contact_form",
    "contact_cta"
  ]
}
{
  "wrapper": "main.main-content",
  "sections": {
    "contact_hero": {
      "type": "ellora-contact-hero",
      "settings": {
        "title": "Tell us about your room,<br>wall, floor or surface idea.",
        "description": "",
        "aspect_ratio": "banner",
        "image_radius": 6,
        "padding_top": 60,
        "padding_bottom": 40
      }
    },
    "contact_form": {
      "type": "ellora-contact-form",
      "settings": {
        "title": "Send the key details in<br>one place.",
        "description": "Share a few project details so Ellora can guide you with the right tile, wallpaper or mural option. Add your room type, approximate wall or floor size, product interest and any specific requirement you have in mind.",
        "name_label": "Name",
        "name_placeholder": "Your Name",
        "name_required": true,
        "email_label": "Email",
        "email_placeholder": "Your Email",
        "email_required": true,
        "phone_label": "Phone",
        "phone_placeholder": "Optional",
        "phone_required": false,
        "project_type_label": "Project Type",
        "project_type_required": true,
        "product_interest_label": "Product Interest",
        "product_interest_required": true,
        "size_label": "Room or Wall Size",
        "size_placeholder": "Example 400 x 280cm",
        "size_required": true,
        "message_label": "Message",
        "message_placeholder": "Tell us what you are trying to create...",
        "message_required": true,
        "btn_text": "Submit",
        "padding_top": 60,
        "padding_bottom": 70

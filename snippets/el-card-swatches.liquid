{% comment %}
  ==========================================================================
  ELLORA SPACES — PRODUCT CARD COLOR SWATCHES SNIPPET
  File: snippets/el-card-swatches.liquid
  Renders luxury circular color swatch dots on product cards across the theme.
  Accepts:
  - product: Product object (optional)
  - show_swatches: Boolean (defaults to true)
  - block_color: String of comma-separated color names (optional fallback for static blocks)
  ==========================================================================
{% endcomment %}

{%- if show_swatches != false -%}
  {%- assign product_colors_arr = '' -%}
  {%- if product != blank -%}
    {%- for opt in product.options_with_values -%}
      {%- assign opt_name_down = opt.name | downcase -%}
      {%- if opt_name_down contains 'color' or opt_name_down contains 'colour' -%}
        {%- for val in opt.values -%}
          {%- assign product_colors_arr = product_colors_arr | append: ',' | append: val -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if product_colors_arr == '' -%}
      {%- for tag in product.tags -%}
        {%- assign tag_low = tag | downcase -%}
        {%- if tag_low contains 'gold' or tag_low contains 'silver' or tag_low contains 'ivory' or tag_low contains 'white' or tag_low contains 'beige' or tag_low contains 'terracotta' or tag_low contains 'charcoal' or tag_low contains 'anthracite' or tag_low contains 'slate' or tag_low contains 'green' or tag_low contains 'rose' -%}
          {%- assign product_colors_arr = product_colors_arr | append: ',' | append: tag -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- elsif block_color != blank -%}
    {%- assign product_colors_arr = block_color -%}
  {%- endif -%}

  {%- assign product_colors_list = product_colors_arr | remove_first: ',' | split: ',' | uniq -%}

  {%- if product_colors_list.size > 0 -%}
    <div class="el-card-color-swatches" aria-label="Available Colors" style="display:inline-flex;align-items:center;gap:5px;margin:0;flex-shrink:0;">
      {%- for clr in product_colors_list limit: 5 -%}
        {%- assign clr_clean = clr | strip -%}
        {%- assign clr_low = clr_clean | downcase -%}
        {%- assign dot_color = '#d8c7b5' -%}
        {%- if clr_low contains 'ivory' or clr_low contains 'white' -%}{%- assign dot_color = '#F5F2EB' -%}
        {%- elsif clr_low contains 'beige' or clr_low contains 'sand' or clr_low contains 'travertine' -%}{%- assign dot_color = '#D8C7B5' -%}
        {%- elsif clr_low contains 'burgundy' or clr_low contains 'wine' -%}{%- assign dot_color = '#6A2B35' -%}
        {%- elsif clr_low contains 'rose' or clr_low contains 'pink' or clr_low contains 'blush' -%}{%- assign dot_color = '#C89D91' -%}
        {%- elsif clr_low contains 'anthracite' or clr_low contains 'charcoal' -%}{%- assign dot_color = '#2E2D2B' -%}
        {%- elsif clr_low contains 'slate' or clr_low contains 'grey' or clr_low contains 'gray' or clr_low contains 'concrete' -%}{%- assign dot_color = '#7E8082' -%}
        {%- elsif clr_low contains 'emerald' -%}{%- assign dot_color = '#1B4D3E' -%}
        {%- elsif clr_low contains 'olive' or clr_low contains 'cypress' -%}{%- assign dot_color = '#4B5320' -%}
        {%- elsif clr_low contains 'sage' -%}{%- assign dot_color = '#9CAF88' -%}
        {%- elsif clr_low contains 'green' -%}{%- assign dot_color = '#2D5A43' -%}
        {%- elsif clr_low contains 'cream' or clr_low contains 'bone' or clr_low contains 'calacatta' -%}{%- assign dot_color = '#FDF6E2' -%}
        {%- elsif clr_low contains 'black' or clr_low contains 'nero' -%}{%- assign dot_color = '#1E1B18' -%}
        {%- elsif clr_low contains 'terracotta' or clr_low contains 'cotto' or clr_low contains 'sienna' -%}{%- assign dot_color = '#CC9E8F' -%}
        {%- elsif clr_low contains 'ochre' or clr_low contains 'mustard' or clr_low contains 'gold' -%}{%- assign dot_color = '#C4823F' -%}
        {%- elsif clr_low contains 'silver' -%}{%- assign dot_color = '#C5C6C7' -%}
        {%- elsif clr_low contains 'walnut' or clr_low contains 'wood' or clr_low contains 'brown' -%}{%- assign dot_color = '#5C4033' -%}
        {%- elsif clr_low contains 'sepia' or clr_low contains 'taupe' -%}{%- assign dot_color = '#7F675B' -%}
        {%- elsif clr_low contains 'indigo' or clr_low contains 'navy' or clr_low contains 'midnight' -%}{%- assign dot_color = '#1E293B' -%}
        {%- elsif clr_low contains 'blue' -%}{%- assign dot_color = '#8BAAC1' -%}
        {%- elsif clr_low contains 'sisal' or clr_low contains 'jute' or clr_low contains 'natural' -%}{%- assign dot_color = '#C7B198' -%}
        {%- endif -%}
        <span class="el-card-swatch-dot" style="background-color: {{ dot_color }};width:12px;height:12px;border-radius:50%;border:1px solid rgba(0,0,0,0.15);display:inline-block;flex-shrink:0;box-shadow:inset 0 1px 2px rgba(0,0,0,0.1);transition:transform 0.15s ease;" title="{{ clr_clean | escape }}"></span>
      {%- endfor -%}
      {%- if product_colors_list.size > 5 -%}
        <span class="el-card-swatch-more" style="font-size:11px;color:#8C827A;font-weight:500;line-height:1;">+{{ product_colors_list.size | minus: 5 }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}

{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 7: FEATURED SPACE (QUIET FOUNDATIONS)
  File: sections/ellora-featured-space.liquid
  Pixel-perfect implementation matching Figma UI (Bleed to Left Edge)
  Features:
  - Left photo touches the left screen edge with rounded right corners (0 20px 20px 0)
  - Interactive space item rows with thumbnail, title, tags, and arrow
  - Active state with warm blush highlight (#FFF9F8)
  - Smooth image crossfade transition on click
  - Full Shopify customizer control over texts, tags, images, links & spacing
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-space-wrapper" id="ellora-space-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-space-{{ section.id }} {
      --el-bg-main: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: #1C1B19;
      --el-muted: #736E67;
      --el-border: #E8E3DC;
      --el-primary: #CC9E8F;
      --el-title-color: {{ section.settings.title_color | default: '#805D52' }};
      --el-active-bg: {{ section.settings.active_bg | default: '#FFF9F8' }};
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --el-img-radius: {{ section.settings.image_radius | default: 20 }}px;
      --el-row-radius: {{ section.settings.row_radius | default: 6 }}px;

      background-color: var(--el-bg-main);
      padding-top: {{ section.settings.padding_top | default: 60 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
      width: 100%;
      overflow: hidden;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-space-{{ section.id }} *,
    #ellora-space-{{ section.id }} *::before,
    #ellora-space-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* -----------------------------------------------------------------------
       FULL-WIDTH GRID: Left photo touches screen edge, Right content aligns with page
       ----------------------------------------------------------------------- */
    #ellora-space-{{ section.id }} .el-space-grid {
      display: grid !important;
      grid-template-columns: 48% 1fr !important;
      gap: {{ section.settings.column_gap | default: 60 }}px !important;
      align-items: center !important;
      width: 100%;
    }

    /* -----------------------------------------------------------------------
       LEFT: Visual Photo touching left corner, rounded on right edge
       ----------------------------------------------------------------------- */
    #ellora-space-{{ section.id }} .el-space-visual {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 500px;
      max-height: 620px;
      aspect-ratio: 4 / 3.05;
      border-radius: 0 var(--el-img-radius) var(--el-img-radius) 0;
      overflow: hidden;
      background-color: #E2DDD5;
      box-shadow: 0 14px 38px rgba(0, 0, 0, 0.05);
    }

    #ellora-space-{{ section.id }} .el-space-visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: opacity 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.6s ease;
    }

    /* -----------------------------------------------------------------------
       RIGHT: Content & Interactive List Rows aligned with 90% container
       ----------------------------------------------------------------------- */
    #ellora-space-{{ section.id }} .el-space-content {
      display: flex;
      flex-direction: column;
      padding-right: max(5vw, calc((100vw - 1720px) / 2));
      padding-left: 0;
      max-width: 680px;
    }

    #ellora-space-{{ section.id }} .el-space-kicker {
      font-family: var(--el-font-sans);
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-weight: 600;
      color: #1C1B19;
      margin-bottom: 14px;
      display: block;
    }

    #ellora-space-{{ section.id }} .el-space-title {
      font-family: var(--el-font-serif);
      font-size: 48px;
      line-height: 1.12;
      color: #805D52;
      font-weight: 400;
      margin-bottom: 18px;
      letter-spacing: -0.01em;
    }

    #ellora-space-{{ section.id }} .el-space-desc {
      font-family: var(--el-font-sans);
      font-size: 15px;
      color: #55514C;
      line-height: 1.68;
      margin-bottom: 36px;
      max-width: 530px;
      font-weight: 400;
    }

    #ellora-space-{{ section.id }} .el-space-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      width: 100%;
    }

    /* Row item */
    #ellora-space-{{ section.id }} .el-space-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--el-border);
      border-radius: var(--el-row-radius);
      background-color: transparent;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    }

    #ellora-space-{{ section.id }} .el-space-item:hover {
      background-color: rgba(255, 249, 248, 0.6);
    }

    #ellora-space-{{ section.id }} .el-space-item.active {
      background-color: var(--el-active-bg);
      border-bottom-color: transparent;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
    }

    #ellora-space-{{ section.id }} .el-space-item-left {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    #ellora-space-{{ section.id }} .el-space-thumb {
      width: 54px;
      height: 54px;
      border-radius: 4px;
      overflow: hidden;
      background-color: #E2DDD5;
      flex-shrink: 0;
    }

    #ellora-space-{{ section.id }} .el-space-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #ellora-space-{{ section.id }} .el-space-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    #ellora-space-{{ section.id }} .el-space-name {
      font-family: var(--el-font-serif);
      font-size: 21px;
      font-weight: 500;
      color: var(--el-dark);
      line-height: 1.2;
    }

    #ellora-space-{{ section.id }} .el-space-tags {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    #ellora-space-{{ section.id }} .el-space-tag {
      font-family: var(--el-font-sans);
      font-size: 12px;
      color: var(--el-muted);
      font-weight: 400;
      line-height: 1.4;
      text-decoration: none;
      transition: color 0.25s ease;
    }

    #ellora-space-{{ section.id }} .el-space-tag:hover {
      color: var(--el-primary);
      text-decoration: underline;
    }

    #ellora-space-{{ section.id }} .el-space-arrow {
      color: #805D52;
      display: flex;
      align-items: center;
      transition: transform 0.25s ease, color 0.25s ease;
      text-decoration: none;
      padding: 6px;
    }

    #ellora-space-{{ section.id }} .el-space-item.active .el-space-arrow {
      color: var(--el-title-color);
      transform: translate(2px, -2px);
    }

    #ellora-space-{{ section.id }} .el-space-item:hover .el-space-arrow {
      color: var(--el-title-color);
      transform: translate(2px, -2px);
    }

    /* -----------------------------------------------------------------------
       RESPONSIVE BREAKPOINTS
       ----------------------------------------------------------------------- */
    @media (max-width: 1024px) {
      #ellora-space-{{ section.id }} .el-space-grid {
        grid-template-columns: 1fr !important;
        gap: 36px !important;
      }
      #ellora-space-{{ section.id }} .el-space-visual {
        border-radius: 0 16px 16px 0;
        min-height: 380px;
        aspect-ratio: 16 / 10;
        max-height: none;
      }
      #ellora-space-{{ section.id }} .el-space-content {
        padding-left: 5vw;
        padding-right: 5vw;
        max-width: 100%;
      }
    }

    @media (max-width: 640px) {
      #ellora-space-{{ section.id }} .el-space-visual {
        border-radius: 0 14px 14px 0;
        min-height: 280px;
        aspect-ratio: 4 / 3;
      }
      #ellora-space-{{ section.id }} .el-space-title {
        font-size: 32px !important;
        line-height: 1.2;
      }
      #ellora-space-{{ section.id }} .el-space-item {
        padding: 12px 14px;
      }
      #ellora-space-{{ section.id }} .el-space-item-left {
        gap: 14px;
      }
      #ellora-space-{{ section.id }} .el-space-thumb {
        width: 48px;
        height: 48px;
      }
      #ellora-space-{{ section.id }} .el-space-name {
        font-size: 19px;
      }
    }
  </style>

  <div class="el-space-grid">
    <!-- Left: Bleed Photo Touching Left Edge -->
    <div class="el-space-visual">
      {%- assign first_block = section.blocks.first -%}
      {%- if first_block.settings.room_image != blank -%}
        <img id="elSpaceMainImg-{{ section.id }}" src="{{ first_block.settings.room_image | image_url: width: 1400 }}" alt="{{ first_block.settings.title }}" loading="lazy">
      {%- else -%}
        <img id="elSpaceMainImg-{{ section.id }}" src="{{ first_block.settings.fallback_room_image | default: 'https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec7_space_01_yoga_room.jpg?v=1789453289' }}" alt="{{ first_block.settings.title }}" loading="lazy">
      {%- endif -%}
    </div>

    <!-- Right: Content & List Aligned with Container -->
    <div class="el-space-content">
      {%- if section.settings.kicker != blank -%}
        <span class="el-space-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="el-space-title">{{ section.settings.heading }}</h2>
      <p class="el-space-desc">
        {{ section.settings.description }}
      </p>

      <div class="el-space-list">
        {%- for block in section.blocks -%}
          {%- capture room_img -%}
            {%- if block.settings.room_image != blank -%}
              {{ block.settings.room_image | image_url: width: 1400 }}
            {%- else -%}
              {{ block.settings.fallback_room_image }}
            {%- endif -%}
          {%- endcapture -%}

          <div 
            class="el-space-item {% if forloop.first %}active{% endif %}" 
            data-img="{{ room_img | strip }}" 
            data-link="{{ block.settings.link | default: '/collections/all' }}"
            {{ block.shopify_attributes }}>
            
            <div class="el-space-item-left">
              <div class="el-space-thumb">
                {%- if block.settings.thumb_image != blank -%}
                  {{ block.settings.thumb_image | image_url: width: 150 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- elsif block.settings.room_image != blank -%}
                  {{ block.settings.room_image | image_url: width: 150 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- elsif block.settings.fallback_thumb_image != blank -%}
                  <img src="{{ block.settings.fallback_thumb_image }}" alt="{{ block.settings.title }}" loading="lazy">
                {%- else -%}
                  <img src="{{ room_img | strip }}" alt="{{ block.settings.title }}" loading="lazy">
                {%- endif -%}
              </div>
              
              <div class="el-space-text">
                <h3 class="el-space-name">{{ block.settings.title }}</h3>
                <div class="el-space-tags">
                  {%- if block.settings.tag_1 != blank -%}
                    <a href="{{ block.settings.tag_1_link | default: '/collections/all' }}" class="el-space-tag" onclick="event.stopPropagation()">
                      {{ block.settings.tag_1 }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.tag_2 != blank -%}
                    <a href="{{ block.settings.tag_2_link | default: '/collections/all' }}" class="el-space-tag" onclick="event.stopPropagation()">
                      {{ block.settings.tag_2 }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <a href="{{ block.settings.link | default: '/collections/all' }}" class="el-space-arrow" aria-label="Explore {{ block.settings.title }}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                <path d="M7 17L17 7M17 7H7M17 7V17"></path>
              </svg>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
    (function() {
      const container = document.getElementById('ellora-space-{{ section.id }}');
      if (!container) return;

      const spaceItems = container.querySelectorAll('.el-space-item');
      const mainImg = document.getElementById('elSpaceMainImg-{{ section.id }}');

      spaceItems.forEach(item => {
        item.addEventListener('click', function(e) {
          // If clicking a tag link or arrow, navigate directly
          if (e.target.closest('a')) return;

          spaceItems.forEach(i => i.classList.remove('active'));
          this.classList.add('active');

          const newImg = this.getAttribute('data-img');
          if (newImg && mainImg) {
            mainImg.style.opacity = '0.3';
            setTimeout(() => {
              mainImg.src = newImg;
              mainImg.style.opacity = '1';
            }, 160);
          }
        });
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "Ellora Featured Space",
  "tag": "section",
  "class": "section-ellora-featured-space",
  "settings": [
    {
      "type": "header",

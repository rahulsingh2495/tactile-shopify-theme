<!-- ========================================================================
     JAVASCRIPT: LIVE COLLECTION SEARCH, ACCORDION TOGGLES & CLEAR FILTERS
     ======================================================================== -->
<script>
  (function() {
    var sectionId = "{{ section.id }}";
    var root = document.getElementById('ellora-collection-' + sectionId);
    if (!root) return;

    // Mobile Slide-out Filter Drawer Controls
    var filterToggleBtn = root.querySelector('#elFilterToggle-' + sectionId);
    var filterSidebar = root.querySelector('#elFilterSidebar-' + sectionId);
    var filterBackdrop = root.querySelector('#elFilterBackdrop-' + sectionId);
    var filterCloseBtn = root.querySelector('#elFilterClose-' + sectionId);
    var filterApplyBtn = root.querySelector('#elFilterApply-' + sectionId);

    function openFilterDrawer() {
      if (filterSidebar) filterSidebar.classList.add('is-open');
      if (filterBackdrop) filterBackdrop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeFilterDrawer() {
      if (filterSidebar) filterSidebar.classList.remove('is-open');
      if (filterBackdrop) filterBackdrop.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (filterToggleBtn) filterToggleBtn.addEventListener('click', openFilterDrawer);
    if (filterCloseBtn) filterCloseBtn.addEventListener('click', closeFilterDrawer);
    if (filterBackdrop) filterBackdrop.addEventListener('click', closeFilterDrawer);

    // Native Shopify Facet Form Sanitization & Change Handling
    var facetForm = root.querySelector('#FacetFiltersForm');
    function sanitizeFacetInputs(form) {
      if (!form) return;
      var inputs = form.querySelectorAll('input[type="number"], input[type="text"]:not([name="sort_by"])');
      inputs.forEach(function(input) {
        if (!input.value || !input.value.trim()) {
          input.disabled = true;
        }
      });
    }

    if (facetForm) {
      // Auto-submit native checkboxes (e.g. Availability, List filters) when toggled
      facetForm.addEventListener('change', function(e) {
        if (e.target && e.target.matches('input[type="checkbox"]:not(.el-tag-filter)')) {
          sanitizeFacetInputs(facetForm);
          if (facetForm.requestSubmit) {
            facetForm.requestSubmit();
          } else {
            facetForm.submit();
          }
        }
      });

      // Intercept submit (e.g. Price "Go" button or pressing Enter) to strip empty price fields
      facetForm.addEventListener('submit', function() {
        sanitizeFacetInputs(facetForm);
      });
    }

    if (filterApplyBtn) {
      filterApplyBtn.addEventListener('click', function() {
        closeFilterDrawer();
        if (facetForm) {
          sanitizeFacetInputs(facetForm);
          if (facetForm.requestSubmit) {
            facetForm.requestSubmit();
          } else {
            facetForm.submit();
          }
        }
      });
    }

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && filterSidebar && filterSidebar.classList.contains('is-open')) {
        closeFilterDrawer();
      }
    });

    // Reset drawer state if window is resized to desktop
    window.addEventListener('resize', function() {
      if (window.innerWidth > 992 && filterSidebar && filterSidebar.classList.contains('is-open')) {
        closeFilterDrawer();
      }
    });

    // Filter Accordion Toggles
    var accBtns = root.querySelectorAll('.el-accordion-btn');
    accBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = btn.nextElementSibling;
        if (body) {
          var isCurrentlyHidden = body.classList.contains('is-hidden');
          body.classList.toggle('is-hidden');
          btn.classList.toggle('is-collapsed');
          btn.setAttribute('aria-expanded', isCurrentlyHidden ? 'true' : 'false');
        }
      });
    });

    // Auto-expand any accordion containing active or checked inputs
    root.querySelectorAll('.el-filter-accordion').forEach(function(acc) {
      var hasChecked = acc.querySelector('input:checked');
      if (hasChecked) {
        var btn = acc.querySelector('.el-accordion-btn');
        var body = acc.querySelector('.el-accordion-body');
        if (btn && body) {
          btn.classList.remove('is-collapsed');
          btn.setAttribute('aria-expanded', 'true');
          body.classList.remove('is-hidden');
        }
      }
    });

    // Dynamic Filter & Search System + Pagination
    var searchInput = root.querySelector('#elCollectionSearch');
    var searchResultsPill = root.querySelector('#elSearchResultsPill');
    var tagCheckboxes = root.querySelectorAll('.el-tag-filter');
    var countText = root.querySelector('.el-col-count-text');
    var cards = Array.prototype.slice.call(root.querySelectorAll('.el-product-card'));
    var emptyFilterState = root.querySelector('#elEmptyFilterState');
    var paginationEl = root.querySelector('#elPagination');
    var totalCards = cards.length;
    var pageSize = {{ products_limit | default: 12 }};
    var currentPage = 1;

    function renderPagination(totalPages) {
      if (!paginationEl) return;

      // If only 1 page or 0 items, hide pagination completely
      if (totalPages <= 1) {
        paginationEl.style.display = 'none';
        paginationEl.innerHTML = '';
        return;
      }

      paginationEl.style.display = 'flex';
      var html = '';

      // Prev Button
      if (currentPage > 1) {
        html += '<button type="button" class="el-page-btn el-page-arrow" data-page="' + (currentPage - 1) + '" aria-label="Previous page">&larr; Prev</button>';
      } else {
        html += '<span class="el-page-btn el-page-arrow disabled" aria-disabled="true">&larr; Prev</span>';
      }

      // Page Numbers
      for (var p = 1; p <= totalPages; p++) {
        if (p === currentPage) {
          html += '<span class="el-page-btn is-active" aria-current="page">' + p + '</span>';
        } else {
          html += '<button type="button" class="el-page-btn" data-page="' + p + '" aria-label="Page ' + p + '">' + p + '</button>';
        }
      }

      // Next Button
      if (currentPage < totalPages) {
        html += '<button type="button" class="el-page-btn el-page-arrow" data-page="' + (currentPage + 1) + '" aria-label="Next page">Next &rarr;</button>';
      } else {
        html += '<span class="el-page-btn el-page-arrow disabled" aria-disabled="true">Next &rarr;</span>';
      }

      paginationEl.innerHTML = html;

      // Attach Click Handlers to pagination buttons
      var pageButtons = paginationEl.querySelectorAll('button[data-page]');
      pageButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var targetPage = parseInt(btn.getAttribute('data-page'), 10);
          if (!isNaN(targetPage) && targetPage !== currentPage) {
            currentPage = targetPage;
            applyDynamicFilters(false);
            var grid = root.querySelector('#elProductGrid');
            if (grid) {
              grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });
    }

    function applyDynamicFilters(resetPage) {
      if (resetPage !== false) {
        currentPage = 1;
      }

      var searchTerm = (searchInput ? searchInput.value.toLowerCase().trim() : '');
      
      // Group active tag filters by data-group
      var activeFiltersByGroup = {};
      var totalActiveFilterCount = 0;
      tagCheckboxes.forEach(function(cb) {
        if (cb.checked) {
          totalActiveFilterCount++;
          var grp = cb.getAttribute('data-group') || 'tag';
          if (!activeFiltersByGroup[grp]) activeFiltersByGroup[grp] = [];
          activeFiltersByGroup[grp].push(cb.value.toLowerCase());
        }
      });

      var isFilteringActive = (searchTerm.length > 0 || totalActiveFilterCount > 0);
      var matchedCards = [];

      cards.forEach(function(card) {
        var title = (card.getAttribute('data-title') || '').toLowerCase();
        var cardType = (card.getAttribute('data-type') || '').toLowerCase();
        var cardTags = (card.getAttribute('data-tags') || '').toLowerCase();
        var cardColors = (card.getAttribute('data-colors') || '').toLowerCase();

        // 1. Search term check
        var matchesSearch = true;
        if (searchTerm) {
          matchesSearch = (title.indexOf(searchTerm) > -1 || cardTags.indexOf(searchTerm) > -1 || cardType.indexOf(searchTerm) > -1 || cardColors.indexOf(searchTerm) > -1);
        }

        // 2. Tag filter groups check (AND across groups, OR within group)
        var matchesTags = true;
        for (var grp in activeFiltersByGroup) {
          var values = activeFiltersByGroup[grp];
          if (values.length > 0) {
            var groupMatched = false;
            for (var i = 0; i < values.length; i++) {
              var val = values[i];
              if (grp === 'type') {
                if (cardType === val || cardType.indexOf(val) > -1) {
                  groupMatched = true;
                  break;
                }
              } else if (grp === 'color') {
                if (cardColors.indexOf(val) > -1 || cardTags.indexOf(val) > -1 || title.indexOf(val) > -1) {
                  groupMatched = true;
                  break;
                }
              } else {
                if (cardTags.indexOf(val) > -1) {
                  groupMatched = true;
                  break;
                }
              }
            }
            if (!groupMatched) {
              matchesTags = false;
              break;
            }
          }
        }

        if (matchesSearch && matchesTags) {
          matchedCards.push(card);
        } else {
          card.style.display = 'none';
        }
      });

      var totalMatched = matchedCards.length;
      var totalPages = Math.ceil(totalMatched / pageSize);

      if (currentPage > totalPages) {
        currentPage = 1;
      }

      // Paginate only matched cards
      var startIndex = (currentPage - 1) * pageSize;
      var endIndex = startIndex + pageSize;

      matchedCards.forEach(function(card, idx) {
        if (idx >= startIndex && idx < endIndex) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });

      // Update Top Right Pill & Stats Count
      if (isFilteringActive) {
        if (searchResultsPill) {
          searchResultsPill.innerHTML = '<span class="el-found-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <span class="el-pill-num">' + totalMatched + '</span> ' + (totalMatched === 1 ? 'Product' : 'Products') + ' Found</span>';
        }
        if (countText) {
          if (totalMatched > 0) {
            countText.textContent = 'Found ' + totalMatched + ' ' + (totalMatched === 1 ? 'Product' : 'Products');
          } else {
            countText.textContent = '0 Products match selected filters';
          }
        }
      } else {
        if (searchResultsPill) {
          searchResultsPill.innerHTML = 'Showing all <strong>' + totalCards + '</strong> Products';
        }
        if (countText) {
          if (totalCards > 0) {
            var pageStart = startIndex + 1;
            var pageEnd = Math.min(endIndex, totalCards);
            countText.textContent = 'Showing ' + pageStart + '–' + pageEnd + ' of ' + totalCards + ' Products';
          } else {
            countText.textContent = 'Showing 0 Products';
          }
        }
      }

      // Empty State
      if (emptyFilterState) {
        if (totalMatched === 0 && totalCards > 0) {
          emptyFilterState.style.display = 'block';
        } else {
          emptyFilterState.style.display = 'none';
        }
      }

      // Render or Hide Pagination
      renderPagination(totalPages);
    }

    // Parse URL curation parameter (e.g. ?curation=best-sellers or ?curation=trending)
    var urlParams = new URLSearchParams(window.location.search);
    var curationParam = (urlParams.get('curation') || '').toLowerCase();
    if (curationParam) {
      var activePill = root.querySelector('.el-curation-pill[data-curation="' + curationParam + '"]');
      if (activePill) {
        var allItem = root.querySelector('#elCatItemAll');
        if (allItem) allItem.classList.remove('is-active');
        activePill.classList.add('is-active');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        applyDynamicFilters(true);
      });
    }

    tagCheckboxes.forEach(function(cb) {
      cb.addEventListener('change', function() {
        applyDynamicFilters(true);
      });
    });

    var resetBtn = root.querySelector('#elResetFiltersBtn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        if (searchInput) searchInput.value = '';
        tagCheckboxes.forEach(function(cb) { cb.checked = false; });
        applyDynamicFilters(true);
      });
    }

    // Initial Filter & Pagination Run
    applyDynamicFilters(false);

    // Clear all filters
    var clearBtn = root.querySelector('#elClearFilters');
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        if (searchInput) searchInput.value = '';
        tagCheckboxes.forEach(function(cb) { cb.checked = false; });
        applyDynamicFilters(true);
        var form = root.querySelector('#FacetFiltersForm');
        var cleanUrl = (form && form.getAttribute('action')) ? form.getAttribute('action') : window.location.pathname;
        window.location.href = cleanUrl;
      });
    }

    // Wishlist LocalStorage Integration
    function getWishlist() {
      try {
        return JSON.parse(localStorage.getItem('ellora_wishlist') || '[]');
      } catch(e) {
        return [];
      }
    }

    function saveWishlist(items) {
      localStorage.setItem('ellora_wishlist', JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('ellora:wishlist:updated', { detail: { items: items } }));
    }

    function syncWishlistButtons() {
      var list = getWishlist();
      var buttons = root.querySelectorAll('.el-wishlist-btn');
      buttons.forEach(function(btn) {
        var id = btn.getAttribute('data-product-id');
        var handle = btn.getAttribute('data-product-handle');
        var title = btn.getAttribute('data-product-title');
        var inList = list.some(function(item) {
          if (id && item.id && String(item.id) === String(id)) return true;
          if (handle && item.handle && item.handle === handle) return true;
          if (title && item.title && item.title.toLowerCase() === title.toLowerCase()) return true;
          return false;
        });
        if (inList) {
          btn.classList.add('is-active');
        } else {
          btn.classList.remove('is-active');
        }
      });
    }

    var toastTimeout;
    function showWishlistToast(msg) {
      var toast = document.getElementById('elWishlistGlobalToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'elWishlistGlobalToast';
        toast.className = 'el-wishlist-toast';
        toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#1C1B19;color:#FFFFFF;padding:12px 20px;border-radius:4px;font-family:sans-serif;font-size:13.5px;font-weight:500;box-shadow:0 4px 16px rgba(0,0,0,0.2);z-index:99999;opacity:0;transform:translateY(12px);transition:all 0.3s ease;pointer-events:none;display:flex;align-items:center;gap:10px;';
        document.body.appendChild(toast);
      }
      toast.innerHTML = '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#CC9E8F\" stroke=\"#CC9E8F\" stroke-width=\"1.5\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path></svg> <span>' + msg + '</span>';
      toast.style.opacity = '1';
      toast.style.transform = 'translateY(0)';
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(12px)';
      }, 2500);
    }

    root.addEventListener('click', function(e) {
      var btn = e.target.closest('.el-wishlist-btn');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      var card = btn.closest('.el-product-card');
      var id = btn.getAttribute('data-product-id') || (card ? card.getAttribute('data-product-id') : '') || ('item-' + Date.now());
      var handle = btn.getAttribute('data-product-handle') || (card ? card.getAttribute('data-product-handle') : '') || '';
      var title = btn.getAttribute('data-product-title') || (card && card.querySelector('.el-card-title') ? card.querySelector('.el-card-title').textContent.trim() : '') || 'Ellora Surface';
      var price = btn.getAttribute('data-product-price') || (card && card.querySelector('.el-card-price') ? card.querySelector('.el-card-price').textContent.trim() : '') || '';
      var image = btn.getAttribute('data-product-image') || (card && card.querySelector('.el-card-img') ? card.querySelector('.el-card-img').getAttribute('src') : '') || '';
      var url = btn.getAttribute('data-product-url') || (card && card.querySelector('a') ? card.querySelector('a').getAttribute('href') : '') || '/collections/all';

      var list = getWishlist();
      var existingIndex = list.findIndex(function(item) {
        if (id && item.id && String(item.id) === String(id)) return true;
        if (handle && item.handle && item.handle === handle) return true;
        if (title && item.title && item.title.toLowerCase() === title.toLowerCase()) return true;
        return false;
      });

      if (existingIndex > -1) {
        list.splice(existingIndex, 1);
        btn.classList.remove('is-active');
        showWishlistToast('Removed from your Wishlist');
      } else {
        list.push({
          id: id,
          handle: handle,
          title: title,
          price: price,
          image: image,
          url: url
        });
        btn.classList.add('is-active');
        showWishlistToast('Added to your Wishlist');
      }

      saveWishlist(list);
    });

    // Add to Cart AJAX Handler
    root.addEventListener('click', function(e) {
      var btn = e.target.closest('.el-card-add-btn');
      if (!btn || btn.classList.contains('is-loading') || btn.classList.contains('is-soldout')) return;
      e.preventDefault();
      e.stopPropagation();

      var variantId = btn.getAttribute('data-variant-id');
      var title = btn.getAttribute('data-product-title') || 'Product';
      var originalHTML = btn.innerHTML;

      // Demo/Fallback Card Simulation
      if (!variantId) {
        btn.classList.add('is-success');
        btn.innerHTML = '&#10003; Added to Basket';
        showWishlistToast('Added ' + title + ' to basket');
        window.dispatchEvent(new CustomEvent('ellora:cart:open'));
        setTimeout(function() {
          btn.classList.remove('is-success');
          btn.innerHTML = originalHTML;
        }, 2000);
        return;
      }

      btn.classList.add('is-loading');
      btn.innerHTML = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: Number(variantId),
          quantity: 1
        })
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Add to cart failed');
        return res.json();
      })
      .then(function(item) {
        btn.classList.remove('is-loading');
        btn.classList.add('is-success');
        btn.innerHTML = '&#10003; Added to Basket';
        showWishlistToast('Added ' + (item.title || title) + ' to basket');

        // Trigger header badge refresh and cart drawer
        window.dispatchEvent(new CustomEvent('ellora:cart:refresh'));
        window.dispatchEvent(new CustomEvent('ellora:cart:updated', { detail: item }));
        window.dispatchEvent(new CustomEvent('cart:updated'));
        window.dispatchEvent(new CustomEvent('cart:refresh'));
        window.dispatchEvent(new CustomEvent('ellora:cart:open'));

        setTimeout(function() {
          btn.classList.remove('is-success');
          btn.innerHTML = originalHTML;
        }, 2200);
      })
      .catch(function(err) {
        console.error('Error adding to cart:', err);
        btn.classList.remove('is-loading');
        btn.innerHTML = originalHTML;
      });
    });

    syncWishlistButtons();
    window.addEventListener('ellora:wishlist:updated', syncWishlistButtons);
    window.addEventListener('storage', syncWishlistButtons);
  })();
</script>


{% comment %}
  ==========================================================================
  ELLORA SPACES — TRADE BENEFITS SECTION
  File: sections/ellora-trade-benefits.liquid
  Theme Editor Name: Trade Benefits
  Features:
  - 4-column luxury value proposition cards for trade partners
  - Repeatable draggable benefit blocks
  - Custom SVG icons with terracotta signature styling
  - Warm beige hover cards and crisp editorial typography
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-trade-benefits" id="ellora-trade-benefits-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-trade-benefits-{{ section.id }} {
      --el-tb-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
      --el-tb-primary: {{ section.settings.primary_color | default: '#8E6356' }};
      --el-tb-dark: {{ section.settings.text_dark | default: '#1C1B19' }};
      --el-tb-muted: {{ section.settings.text_muted | default: '#68645F' }};
      --el-tb-border: {{ section.settings.border_color | default: '#ECE7E1' }};
      --el-tb-card: {{ section.settings.card_bg | default: '#FFFFFF' }};

      --el-tb-pt: {{ section.settings.padding_top | default: 80 }}px;
      --el-tb-pb: {{ section.settings.padding_bottom | default: 80 }}px;

      background-color: var(--el-tb-bg);
      color: var(--el-tb-dark);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      padding-top: var(--el-tb-pt);
      padding-bottom: var(--el-tb-pb);
    }

    #ellora-trade-benefits-{{ section.id }} *,
    #ellora-trade-benefits-{{ section.id }} *::before,
    #ellora-trade-benefits-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1720 }}px;
      margin: 0 auto;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-header {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 50px auto;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-kicker {
      font-size: 11.5px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-tb-primary);
      margin-bottom: 10px;
      display: block;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 38px;
      font-weight: 400;
      color: var(--el-tb-dark);
      line-height: 1.2;
      margin-bottom: 14px;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-sub {
      font-size: 15px;
      color: var(--el-tb-muted);
      line-height: 1.6;
    }

    /* Benefits Grid */
    #ellora-trade-benefits-{{ section.id }} .el-tb-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: 24px;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-card {
      background: var(--el-tb-card);
      border: 1px solid var(--el-tb-border);
      border-radius: 2px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
      border-color: var(--el-tb-primary);
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 2px;
      background: var(--el-tb-bg);
      border: 1px solid var(--el-tb-border);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-icon-box svg {
      width: 22px;
      height: 22px;
      stroke: var(--el-tb-primary);
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-card-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22px;
      font-weight: 500;
      color: var(--el-tb-dark);
      line-height: 1.25;
    }

    #ellora-trade-benefits-{{ section.id }} .el-tb-card-desc {
      font-size: 13.5px;
      color: var(--el-tb-muted);
      line-height: 1.65;
    }

    @media (max-width: 1024px) {
      #ellora-trade-benefits-{{ section.id }} .el-tb-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      #ellora-trade-benefits-{{ section.id }} .el-tb-grid {
        grid-template-columns: 1fr;
      }
      #ellora-trade-benefits-{{ section.id }} .el-tb-title {
        font-size: 30px;
      }
    }
  </style>

  <div class="el-tb-container">
    <div class="el-tb-header">
      {%- if section.settings.kicker != blank -%}
        <span class="el-tb-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="el-tb-title">{{ section.settings.title | default: 'Designed for Professional Workflows' }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="el-tb-sub">{{ section.settings.sub }}</p>
      {%- endif -%}
    </div>

    <div class="el-tb-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="el-tb-card" {{ block.shopify_attributes }}>
            <div class="el-tb-icon-box">
              {%- case block.settings.icon -%}
                {%- when 'discount' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
                {%- when 'swatch' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                {%- when 'concierge' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {%- when 'freight' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
              {%- endcase -%}
            </div>
            <h3 class="el-tb-card-title">{{ block.settings.title }}</h3>
            <p class="el-tb-card-desc">{{ block.settings.desc }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default 4 pillars -->
        <div class="el-tb-card">
          <div class="el-tb-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
          </div>
          <h3 class="el-tb-card-title">Tiered Trade Pricing</h3>
          <p class="el-tb-card-desc">Access wholesale margin discounts across our entire catalog of natural stone tiles, fluted panels, and wallpapers.</p>
        </div>

        <div class="el-tb-card">
          <div class="el-tb-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          </div>
          <h3 class="el-tb-card-title">Bespoke Fabrication</h3>
          <p class="el-tb-card-desc">Custom-sized slabs, custom edge beveling, and bespoke wallpaper mural dimensions tailored to exact architectural CAD drawings.</p>
        </div>

        <div class="el-tb-card">
          <div class="el-tb-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          </div>
          <h3 class="el-tb-card-title">Complimentary Samples</h3>
          <p class="el-tb-card-desc">Request complimentary full-scale stone swatches and client presentation material sample kits delivered to your studio within 48 hours.</p>
        </div>

        <div class="el-tb-card">
          <div class="el-tb-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <h3 class="el-tb-card-title">Site Logistics &amp; Staging</h3>
          <p class="el-tb-card-desc">Coordinate timed job-site deliveries with tail-lift offloading and batch-matched stone reserved in advance of contractor start dates.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trade Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "WHY PARTNER WITH ELLORA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Designed for Professional Workflows"
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Subtitle",
      "default": "Comprehensive support, dedicated account management, and quarry-direct procurement for architects and interior creators."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1720
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#8E6356"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Dark Text Color",
      "default": "#1C1B19"
    },
    {
      "type": "color",
      "id": "text_muted",
      "label": "Muted Text Color",
      "default": "#68645F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECE7E1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Trade Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "discount", "label": "Discount / Margin" },
            { "value": "swatch", "label": "Samples / Star" },
            { "value": "concierge", "label": "Account Concierge" },
            { "value": "freight", "label": "Delivery / Truck" },
            { "value": "cube", "label": "Materials / Layers" }
          ],
          "default": "discount"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tiered Trade Pricing"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Access wholesale margin discounts across our entire catalog of natural stone tiles, fluted panels, and wallpapers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "discount", "title": "Tiered Trade Pricing", "desc": "Access wholesale margin discounts across our entire catalog of natural stone tiles, fluted panels, and wallpapers." } },
        { "type": "benefit", "settings": { "icon": "cube", "title": "Bespoke Fabrication", "desc": "Custom-sized slabs, custom edge beveling, and bespoke wallpaper mural dimensions tailored to exact architectural CAD drawings." } },
        { "type": "benefit", "settings": { "icon": "swatch", "title": "Complimentary Samples", "desc": "Request complimentary full-scale stone swatches and client presentation material sample kits delivered to your studio within 48 hours." } },
        { "type": "benefit", "settings": { "icon": "freight", "title": "Site Logistics & Staging", "desc": "Coordinate timed job-site deliveries with tail-lift offloading and batch-matched stone reserved in advance of contractor start dates." } }
      ]
    }
  ]
}
{% endschema %}

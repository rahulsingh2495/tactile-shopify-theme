            "link": "/collections/all"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Shop By Room",
            "action_label": "Shop Now",
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec4_surface_04_checkered.jpg?v=1789453290",
            "link": "/collections/all"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "title": "Warm Neutrals",
            "action_label": "Shop Now",
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec4_surface_05_warm_neutrals.jpg?v=1789453290",
            "link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}

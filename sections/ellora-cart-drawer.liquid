      "default": "#ECE7E1"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card & Footer Background",
      "default": "#FAF8F5"
    }
  ],
  "presets": [
    {
      "name": "Ellora Slide Cart Drawer"
    }
  ]
}

{% comment %}
  ==========================================================================
  ELLORA SPACES — CONTINUOUS FULL-WIDTH SLIDING IMAGE MARQUEE
  File: sections/ellora-image-marquee.liquid
  Features:
  - Infinite smooth continuous sliding from right to left
  - Zero stutter, seamless loop with duplicated track
  - Hover zoom on images + optional pause on hover
  - Full theme customizer controls for speed, size, gap, radius & padding
  - Editable image blocks with custom links
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-img-marquee-wrapper" id="ellora-marquee-{{ section.id }}">
  <style>
    #ellora-marquee-{{ section.id }} {
      --el-bg: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-card-w: {{ section.settings.card_width | default: 300 }}px;
      --el-card-h: {{ section.settings.card_height | default: 360 }}px;
      --el-gap: {{ section.settings.gap | default: 20 }}px;
      --el-radius: {{ section.settings.card_radius | default: 10 }}px;
      --el-speed: {{ section.settings.scroll_speed | default: 32 }}s;

      background-color: var(--el-bg);
      padding-top: {{ section.settings.padding_top | default: 30 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 30 }}px;
      width: 100%;
      overflow: hidden;
      position: relative;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-marquee-{{ section.id }} *,
    #ellora-marquee-{{ section.id }} *::before,
    #ellora-marquee-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* Container Track */
    #ellora-marquee-{{ section.id }} .el-marquee-viewport {
      width: 100%;
      overflow: hidden;
      position: relative;
      display: flex;
    }

    #ellora-marquee-{{ section.id }} .el-marquee-track {
      display: flex;
      gap: var(--el-gap);
      flex-shrink: 0;
      align-items: center;
      animation: elSlideLoop-{{ section.id }} var(--el-speed) linear infinite;
      will-change: transform;
    }

    {%- if section.settings.pause_on_hover -%}
      #ellora-marquee-{{ section.id }}:hover .el-marquee-track {
        animation-play-state: paused;
      }
    {%- endif -%}

    /* Each Slide Item */
    #ellora-marquee-{{ section.id }} .el-marquee-slide {
      flex: 0 0 var(--el-card-w);
      width: var(--el-card-w);
      height: var(--el-card-h);
      border-radius: var(--el-radius);
      overflow: hidden;
      background-color: #E2DDD5;
      position: relative;
      display: block;
      text-decoration: none;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    #ellora-marquee-{{ section.id }} .el-marquee-slide:hover {
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
      transform: translateY(-3px);
    }

    #ellora-marquee-{{ section.id }} .el-marquee-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #ellora-marquee-{{ section.id }} .el-marquee-slide:hover img {
      transform: scale(1.05);
    }

    /* Infinite Animation */
    {%- if section.settings.direction == 'left_to_right' -%}
      @keyframes elSlideLoop-{{ section.id }} {
        0% { transform: translateX(-50%); }
        100% { transform: translateX(0); }
      }
    {%- else -%}
      @keyframes elSlideLoop-{{ section.id }} {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
    {%- endif -%}

    /* Responsive adjustments */
    @media (max-width: 900px) {
      #ellora-marquee-{{ section.id }} {
        --el-card-w: {{ section.settings.card_width | times: 0.85 | round }}px;
        --el-card-h: {{ section.settings.card_height | times: 0.85 | round }}px;
        --el-gap: 16px;
      }
    }

    @media (max-width: 640px) {
      #ellora-marquee-{{ section.id }} {
        --el-card-w: {{ section.settings.card_width | times: 0.72 | round }}px;
        --el-card-h: {{ section.settings.card_height | times: 0.72 | round }}px;
        --el-gap: 12px;
      }
    }
  </style>

  <div class="el-marquee-viewport" aria-label="Continuous Sliding Showcase">
    <div class="el-marquee-track">
      <!-- Primary Loop -->
      {%- for block in section.blocks -%}
        <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} 
          class="el-marquee-slide" 
          {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.alt_text | default: 'Ellora Tile Surface' }}
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.alt_text | default: 'Ellora Tile Surface' }}" loading="lazy">
          {%- else -%}
            <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_01_stone_vase.jpg?v=1789453288" alt="Ellora Tile Surface" loading="lazy">
          {%- endif -%}
        </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
      {%- endfor -%}

      <!-- Duplicate Loop (Ensures 100% seamless infinite scroll without blank spaces) -->
      {%- for block in section.blocks -%}
        <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} 
          class="el-marquee-slide" 
          aria-hidden="true" 
          tabindex="-1">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image }}" alt="" loading="lazy">
          {%- else -%}
            <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_01_stone_vase.jpg?v=1789453288" alt="" loading="lazy">
          {%- endif -%}
        </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ellora Image Marquee",
  "tag": "section",
  "class": "section-ellora-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Scroll & Motion Settings"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed Duration (Lower is Faster)",
      "default": 32
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        { "value": "right_to_left", "label": "Right to Left (Continuous)" },
        { "value": "left_to_right", "label": "Left to Right" }
      ],
      "default": "right_to_left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Scroll on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Dimensions & Style"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Slide Card Width",
      "default": 300
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 240,
      "max": 480,
      "step": 10,
      "unit": "px",
      "label": "Slide Card Height",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space Between Cards",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Spacing & Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "marquee_image",
      "name": "Marquee Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback CDN Photo URL"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text (Accessibility)",
          "default": "Ellora Stone Surface"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Click Link URL (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellora Image Marquee",
      "blocks": [
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_01_stone_vase.jpg?v=1789453288",
            "alt_text": "Artisan stone wall with vase and olive sprig"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_02_terrace_tree.jpg?v=1789453290",
            "alt_text": "Courtyard terrace with tree and modern lounge chair"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_03_historic_courtyard.jpg?v=1789453291",
            "alt_text": "Stone paved courtyard and historic building"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_04_sandstone_slabs.jpg?v=1789453291",
            "alt_text": "Sandstone paving slabs with dark slatted chair"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_05_rustic_chair.jpg?v=1789453291",
            "alt_text": "Aura ivory stone tile floor with rustic chair"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_06_checkered_floor.jpg?v=1789453291",
            "alt_text": "Patterned checkered tile floor with potted plant"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_07_natural_flagstone.jpg?v=1789453290",
            "alt_text": "Natural stone flag floor with armchair"
          }
        },
        {
          "type": "marquee_image",
          "settings": {
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_marquee_08_niche_bathroom.jpg?v=1789453290",
            "alt_text": "Warm niche bathroom stone"
          }

      "default": "Our surface specialists review architectural drawings, calculate layout formulas, and recommend stone finishes tailored to your space."
    },
    {
      "type": "text",
      "id": "consult_btn_text",
      "label": "Button Text",
      "default": "Book Design Consultation"
    },
    {
      "type": "url",
      "id": "consult_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1720
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Consultation Card Background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#8E6356"
    },
    {
      "type": "color",
      "id": "primary_hover",
      "label": "Primary Accent Hover",
      "default": "#734E43"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Dark Text Color",
      "default": "#1C1B19"
    },
    {
      "type": "color",
      "id": "text_muted",
      "label": "Muted Text Color",
      "default": "#68645F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECE7E1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Custom Guide Article",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "select",
          "id": "topic",
          "label": "Topic Category",
          "options": [
            { "value": "care", "label": "Sealing & Stone Care" },
            { "value": "installation", "label": "Substrate & Laying" },
            { "value": "sizing", "label": "Wastage & Sizing" },
            { "value": "finishes", "label": "Material Finishes" }
          ],
          "default": "care"

        {
          "type": "text",
          "id": "date",
          "label": "Date / Edition",
          "default": "October 2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article Title",
          "default": "How to Seal & Maintain Roman Travertine"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Summary Excerpt",
          "default": "Understanding porous stone breathability, penetrating impregnators vs surface coatings, and everyday pH-neutral cleaning protocols."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advice Hub Guides Grid"
    }
  ]

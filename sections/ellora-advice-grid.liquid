{% comment %}
  ==========================================================================
  ELLORA SPACES — ADVICE HUB FAQ HUB
  File: sections/ellora-advice-grid.liquid
  Theme Editor Name: Advice Hub FAQ Grid
  Features:
  - Architectural FAQ Hub inspired by Mandarin Stone
  - Categorized into Delivery, Orders, Samples, Returns & Care
  - Live filtering synced with Advice Hub Hero tabs
  - Expandable accordion disclosures
  - Fallback to rich pre-populated FAQ answers
  - Bottom design consultation & concierge card
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-advice-grid" id="ellora-advice-grid-{{ section.id }}">
  {%- assign ag_primary = section.settings.primary_color -%}
  {%- if ag_primary == blank or ag_primary == '#8E6356' or ag_primary == '#8e6356' or ag_primary == '#754F43' or ag_primary == '#754f43' or ag_primary == '#BA9587' or ag_primary == '#ba9587' or ag_primary == '#734E43' or ag_primary == '#734e43' or ag_primary == '#A36854' or ag_primary == '#a36854' -%}
    {%- assign ag_primary = '#CC9E8F' -%}
  {%- endif -%}
  {%- assign ag_primary_hover = section.settings.primary_hover -%}
  {%- if ag_primary_hover == blank or ag_primary_hover == '#8E6356' or ag_primary_hover == '#8e6356' or ag_primary_hover == '#754F43' or ag_primary_hover == '#754f43' or ag_primary_hover == '#BA9587' or ag_primary_hover == '#ba9587' or ag_primary_hover == '#734E43' or ag_primary_hover == '#734e43' or ag_primary_hover == '#A36854' or ag_primary_hover == '#a36854' -%}
    {%- assign ag_primary_hover = '#BF8673' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-advice-grid-{{ section.id }} {
      --el-ag-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
      --el-ag-primary: {{ ag_primary }};
      --el-ag-primary-hover: {{ ag_primary_hover }};
      --el-ag-dark: {{ section.settings.text_dark | default: '#1C1B19' }};
      --el-ag-muted: {{ section.settings.text_muted | default: '#68645F' }};
      --el-ag-border: {{ section.settings.border_color | default: '#ECE7E1' }};
      --el-ag-card-bg: {{ section.settings.card_bg | default: '#FAF8F5' }};

      --el-ag-pt: {{ section.settings.padding_top | default: 20 }}px;
      --el-ag-pb: {{ section.settings.padding_bottom | default: 100 }}px;

      background-color: var(--el-ag-bg);
      color: var(--el-ag-dark);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      padding-top: var(--el-ag-pt);
      padding-bottom: var(--el-ag-pb);
    }

    #ellora-advice-grid-{{ section.id }} *,
    #ellora-advice-grid-{{ section.id }} *::before,
    #ellora-advice-grid-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1100 }}px;
      margin: 0 auto;
    }

    /* FAQ List Layout */
    #ellora-advice-grid-{{ section.id }} .el-faq-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 64px;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-item {
      background: #FFFFFF;
      border: 1px solid var(--el-ag-border);
      border-radius: 4px;
      overflow: hidden;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-item:hover {
      border-color: var(--el-ag-primary);
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-item.is-open {
      border-color: var(--el-ag-primary);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-item.is-hidden {
      display: none !important;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-q {
      width: 100%;
      background: none;
      border: none;
      padding: 22px 26px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      text-align: left;
      cursor: pointer;
      font-family: inherit;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-q-left {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-cat-badge {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #805D52;
      background: #FAF6F4;
      padding: 3px 8px;
      border-radius: 2px;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 20.5px;
      font-weight: 500;
      color: var(--el-ag-dark);
      line-height: 1.35;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-icon {
      width: 32px;
      height: 32px;
      min-width: 32px;
      border-radius: 50%;
      background: #FAF8F5;
      border: 1px solid var(--el-ag-border);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--el-ag-primary);
      transition: transform 0.25s ease, background-color 0.2s ease;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-item.is-open .el-faq-icon {
      transform: rotate(45deg);
      background: var(--el-ag-primary);
      color: #FFFFFF;
      border-color: var(--el-ag-primary);
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-a {
      display: none;
      padding: 0 26px 24px 26px;
      color: var(--el-ag-muted);
      font-size: 15px;
      line-height: 1.7;
      border-top: 1px dashed #F0ECE7;
      margin-top: -4px;
      padding-top: 18px;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-item.is-open .el-faq-a {
      display: block;
    }

    #ellora-advice-grid-{{ section.id }} .el-faq-a p {
      margin-bottom: 12px;
    }
    #ellora-advice-grid-{{ section.id }} .el-faq-a p:last-child {
      margin-bottom: 0;
    }

    /* Consultation Concierge Banner */
    #ellora-advice-grid-{{ section.id }} .el-ag-consult-card {
      background: var(--el-ag-card-bg);
      border: 1px solid var(--el-ag-border);
      border-radius: 4px;
      padding: 44px 36px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-consult-text {
      max-width: 640px;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-consult-title {
      color: #805D52;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 26px;
      font-weight: 500;
      color: var(--el-ag-dark);
      margin-bottom: 8px;
      line-height: 1.25;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-consult-desc {
      font-size: 14.5px;
      color: var(--el-ag-muted);
      line-height: 1.6;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-consult-actions {
      display: flex;
      gap: 12px;
      flex-shrink: 0;
      flex-wrap: wrap;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-consult-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--el-ag-primary, #CC9E8F) !important;
      color: #FFFFFF !important;
      padding: 13px 26px;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 2px;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-consult-btn:hover {
      background: var(--el-ag-primary-hover, #805D52) !important;
      transform: translateY(-1px);
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-whatsapp-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FFFFFF;
      color: #25D366 !important;
      border: 1px solid #25D366;
      padding: 13px 22px;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 2px;
      transition: all 0.2s ease;
    }

    #ellora-advice-grid-{{ section.id }} .el-ag-whatsapp-btn:hover {
      background: #25D366;
      color: #FFFFFF !important;
    }

    @media (max-width: 860px) {
      #ellora-advice-grid-{{ section.id }} .el-ag-consult-card {
        flex-direction: column;
        text-align: center;
        padding: 32px 24px;
      }
      #ellora-advice-grid-{{ section.id }} .el-ag-consult-text {
        max-width: 100%;
      }
      #ellora-advice-grid-{{ section.id }} .el-ag-consult-actions {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <div class="el-ag-container">

    <!-- FAQ Accordion List -->
    <div class="el-faq-list" id="elFaqList-{{ section.id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="el-faq-item" data-topic="{{ block.settings.category | default: 'delivery' }}" {{ block.shopify_attributes }}>
            <button type="button" class="el-faq-q" aria-expanded="false">
              <div class="el-faq-q-left">
                <span class="el-faq-cat-badge">{{ block.settings.category_label | default: block.settings.category | capitalize }}</span>
                <h3 class="el-faq-title">{{ block.settings.question }}</h3>
              </div>
              <span class="el-faq-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </span>
            </button>
            <div class="el-faq-a">
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Pre-populated Mandarin Stone Inspired FAQ Edits -->

        <!-- Delivery & Logistics -->
        <div class="el-faq-item is-open" data-topic="delivery">
          <button type="button" class="el-faq-q" aria-expanded="true">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Delivery &amp; Logistics</span>
              <h3 class="el-faq-title">How is my tile or stone panel order delivered?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>All tile crates, fluted slabs, and stone panels are securely strapped to timber freight pallets and delivered via specialist tail-lift freight vehicles.</p>
            <p>Delivery is strictly kerbside to the nearest flat, firm, accessible hard surface at your delivery address. Drivers cannot carry goods inside residences, navigate staircases, or traverse gravel paths.</p>
          </div>
        </div>

        <div class="el-faq-item" data-topic="delivery">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Delivery &amp; Logistics</span>
              <h3 class="el-faq-title">What site access is required for heavy pallet delivery?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Pallet delivery lorries typically weigh up to 18 tonnes and require adequate road access without severe low bridges, narrow single tracks, or weight restrictions. Manual pump trucks used to lower the pallet require smooth, flat concrete or tarmac surfaces.</p>
          </div>
        </div>

        <div class="el-faq-item" data-topic="delivery">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Delivery &amp; Logistics</span>
              <h3 class="el-faq-title">Can I track my delivery and specify an arrival date?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Yes. Once your order leaves our stone depot, you will receive tracking notifications via email and SMS. The local courier hub will contact you prior to delivery to confirm the scheduled date.</p>
          </div>
        </div>

        <!-- Orders & Checkout -->
        <div class="el-faq-item" data-topic="orders">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Orders &amp; Checkout</span>
              <h3 class="el-faq-title">How do I calculate how many tiles or square meters to order?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Measure the length and width of each surface to calculate total square meters (M&sup2;). We advise adding a <strong>minimum 10% to 15% allowance</strong> (or 20% for herringbone or complex layouts) to accommodate cuts, corner shaping, and future attic stock.</p>
          </div>
        </div>

        <div class="el-faq-item" data-topic="orders">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Orders &amp; Checkout</span>
              <h3 class="el-faq-title">Can I add extra boxes to my order later?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Natural stone is extracted from distinct quarry veins. While you can order additional boxes, variations in shade, veining, and calibration between separate batches can occur. Ordering all required material together ensures optimal batch harmony.</p>
          </div>
        </div>

        <!-- Ordering Samples -->
        <div class="el-faq-item" data-topic="samples">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Ordering Samples</span>
              <h3 class="el-faq-title">How does your sample service work?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>We provide sample swatches to help you assess stone density, tactile surface finishes (honed, brushed, fluted), and coloration under natural lighting within your space.</p>
          </div>
        </div>

        <div class="el-faq-item" data-topic="samples">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Ordering Samples</span>
              <h3 class="el-faq-title">Why do some products request a design consultation instead of a sample order?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Due to high demand and quarry extraction cycles, certain rare marble and custom stone panels are currently reserved for 1-on-1 consultations where we review live slab photographs and batch coordinates directly with your project specifiers.</p>
          </div>
        </div>

        <!-- Returns & Damaged Goods -->
        <div class="el-faq-item" data-topic="returns">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Returns &amp; Damaged Goods</span>
              <h3 class="el-faq-title">What is your returns policy?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>We accept returns of full, unopened, undamaged crates or boxes within 14 calendar days of delivery. Due to batch variation management and pallet repackaging requirements, we cannot accept returns of partial boxes or installed tiles.</p>
          </div>
        </div>

        <div class="el-faq-item" data-topic="returns">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Returns &amp; Damaged Goods</span>
              <h3 class="el-faq-title">What should I do if any tiles arrive damaged in transit?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Inspect the pallet shrink-wrap immediately upon arrival. Mark the carrier proof-of-delivery note as 'Damaged' and photograph the broken pieces. Notify our support desk within 48 hours for expedited replacements.</p>
          </div>
        </div>

        <!-- Installation & Care -->
        <div class="el-faq-item" data-topic="care">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Installation &amp; Care</span>
              <h3 class="el-faq-title">Does natural stone tile require sealing?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Yes. All natural travertine, limestone, marble, and cotto surfaces require a high-grade penetrating impregnator. We recommend applying an initial coat prior to grouting to prevent grout pigmentation absorption, followed by a final coat after thorough drying.</p>
          </div>
        </div>

        <div class="el-faq-item" data-topic="care">
          <button type="button" class="el-faq-q" aria-expanded="false">
            <div class="el-faq-q-left">
              <span class="el-faq-cat-badge">Installation &amp; Care</span>
              <h3 class="el-faq-title">How should I clean and maintain natural stone everyday?</h3>
            </div>
            <span class="el-faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </button>
          <div class="el-faq-a">
            <p>Always clean with a dedicated pH-neutral stone cleaner. Avoid standard multi-surface sprays, acidic bathroom descalers, or bleach, as these react with calcium carbonate in natural stone and cause surface etching.</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Consultation Banner -->
    {%- if section.settings.show_consult_card -%}
      <div class="el-ag-consult-card">
        <div class="el-ag-consult-text">
          <h3 class="el-ag-consult-title">{{ section.settings.consult_title | default: 'Have a specific architectural query?' }}</h3>
          <p class="el-ag-consult-desc">{{ section.settings.consult_desc | default: 'Our surface specialists review project schedules, examine site access, and advise on substrate preparation and stone care.' }}</p>
        </div>
        <div class="el-ag-consult-actions">
          <a href="{{ section.settings.consult_link | default: '/pages/contact' }}" class="el-ag-consult-btn">
            {{ section.settings.consult_btn_text | default: 'Speak to a Specialist' }}
          </a>
          <a href="https://wa.me/" target="_blank" rel="noopener noreferrer" class="el-ag-whatsapp-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.53 1.951.815 2.791.815 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.704 0-3.327-.432-4.757-1.196l-5.243 1.371 1.396-5.105c-.868-1.503-1.396-3.239-1.396-5.07 0-5.514 4.486-10 10-10s10 4.486 10 10z"/></svg>
            Help on WhatsApp
          </a>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function() {
    var root = document.getElementById('ellora-advice-grid-{{ section.id }}');
    if (!root) return;

    var faqList = root.querySelector('#elFaqList-{{ section.id }}');
    if (!faqList) return;

    // Accordion Toggle
    faqList.addEventListener('click', function(e) {
      var btn = e.target.closest('.el-faq-q');
      if (!btn) return;
      var item = btn.closest('.el-faq-item');
      if (!item) return;

      var isOpen = item.classList.contains('is-open');
      item.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', !isOpen);
    });

    // Topic Filter Event Listener from Advice Hero Pills
    window.addEventListener('ellora:advice:filter', function(e) {
      var topic = e.detail && e.detail.topic;
      if (!topic) return;

      var items = faqList.querySelectorAll('.el-faq-item');
      items.forEach(function(item) {
        var itemTopic = item.getAttribute('data-topic');
        if (topic === 'all' || itemTopic === topic) {
          item.classList.remove('is-hidden');
        } else {
          item.classList.add('is-hidden');
        }
      });
    });
  })();
</script>


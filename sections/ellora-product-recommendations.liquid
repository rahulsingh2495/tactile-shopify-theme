{% comment %}
  ==========================================================================
  ELLORA SPACES — PAIRED RECOMMENDATIONS SECTION
  File: sections/ellora-product-recommendations.liquid
  Theme Editor Name: Paired Recommendations
  Features:
  - 100% Dynamic related products powered by product collections
  - Automatically identifies the most specific collection the product belongs to
  - Excludes the current product being viewed
  - Optional fallback to manual collection or store catalog
  - 4:5 luxury product card grid with hover elevation & zoom
  - Wishlist heart sync with localStorage ('ellora_wishlist')
  - Responsive grid layout
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-prod-recs" id="ellora-prod-recs-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- assign pr_primary = section.settings.primary_color -%}
  {%- if pr_primary == blank or pr_primary == '#8E6356' or pr_primary == '#8e6356' or pr_primary == '#754F43' or pr_primary == '#754f43' or pr_primary == '#BA9587' or pr_primary == '#ba9587' or pr_primary == '#734E43' or pr_primary == '#734e43' or pr_primary == '#A36854' or pr_primary == '#a36854' -%}
    {%- assign pr_primary = '#CC9E8F' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-prod-recs-{{ section.id }} {
      --el-pr-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
      --el-pr-primary: {{ pr_primary }};
      --el-pr-dark: #1C1B19;
      --el-pr-muted: #68645F;
      --el-pr-border: #ECE7E1;
      --el-pr-card-bg: #FFFFFF;

      --el-pr-pt: {{ section.settings.padding_top | default: 80 }}px;
      --el-pr-pb: {{ section.settings.padding_bottom | default: 90 }}px;

      background-color: var(--el-pr-bg);
      color: var(--el-pr-dark);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      padding-top: var(--el-pr-pt);
      padding-bottom: var(--el-pr-pb);
      border-top: 1px solid var(--el-pr-border);
    }

    #ellora-prod-recs-{{ section.id }} *,
    #ellora-prod-recs-{{ section.id }} *::before,
    #ellora-prod-recs-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1280 }}px;
      margin: 0 auto;
    }

    /* Header */
    #ellora-prod-recs-{{ section.id }} .el-pr-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 40px;
      border-bottom: 1px solid var(--el-pr-border);
      padding-bottom: 24px;
      flex-wrap: wrap;
      gap: 20px;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-kicker {
      font-size: 11.5px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-pr-primary);
      margin-bottom: 8px;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(28px, 3.2vw, 38px);
      font-weight: 400;
      line-height: 1.15;
      color: var(--el-pr-dark);
      letter-spacing: -0.01em;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-subtitle {
      font-size: 14px;
      color: var(--el-pr-muted);
      margin-top: 6px;
      max-width: 520px;
      line-height: 1.5;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-all-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 500;
      color: var(--el-pr-dark);
      text-decoration: none;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--el-pr-dark);
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-all-link:hover {
      color: var(--el-pr-primary);
      border-color: var(--el-pr-primary);
    }

    #ellora-prod-recs-{{ section.id }} .el-slider-nav-wrap {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    #ellora-prod-recs-{{ section.id }} .el-slider-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #FFFFFF;
      border: 1px solid var(--el-pr-border);
      color: var(--el-pr-dark);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.22s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }

    #ellora-prod-recs-{{ section.id }} .el-slider-btn:hover {
      background: var(--el-pr-primary);
      border-color: var(--el-pr-primary);
      color: #FFFFFF;
    }

    /* Grid */
    #ellora-prod-recs-{{ section.id }} .el-pr-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: 32px 24px;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-grid.is-slider {
      display: flex !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 24px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 8px;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-grid.is-slider::-webkit-scrollbar {
      display: none;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-grid.is-slider .el-pr-card {
      flex: 0 0 calc((100% - ({{ section.settings.columns_desktop | default: 4 }} - 1) * 24px) / {{ section.settings.columns_desktop | default: 4 }});
      min-width: 250px;
      scroll-snap-align: start;
    }

    /* Card matching collection grid */
    #ellora-prod-recs-{{ section.id }} .el-pr-card {
      background: transparent;
      border: none;
      display: flex;
      flex-direction: column;
      height: 100%;
      text-decoration: none;
      position: relative;
    }

    /* Media 4:5 ratio */
    #ellora-prod-recs-{{ section.id }} .el-pr-media-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: 8px;
      overflow: hidden;
      background: #EDE8E2;
      margin-bottom: 14px;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-card:hover .el-pr-img {
      transform: scale(1.04);
    }

    /* Wishlist Heart Button matching collection */
    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #FFFFFF;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 3;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn:hover {
      transform: scale(1.08);
      background: #FAF2ED;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn svg {
      width: 15px;
      height: 15px;
      stroke: var(--el-pr-dark);
      fill: none;
      stroke-width: 1.6;
      transition: all 0.2s ease;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn.is-active,
    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn.active {
      background: #FAF2ED;
      transform: scale(1.08);
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn.is-active svg,
    #ellora-prod-recs-{{ section.id }} .el-pr-wish-btn.active svg {
      stroke: var(--el-pr-primary, #CC9E8F);
      fill: var(--el-pr-primary, #CC9E8F);
    }

    /* Details matching collection */
    #ellora-prod-recs-{{ section.id }} .el-pr-info {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      gap: 0;
      padding: 0;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-prod-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 20px;
      font-weight: 400;
      color: var(--el-pr-dark);
      margin: 0 0 4px;
      letter-spacing: -0.01em;
      line-height: 1.25;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-card:hover .el-pr-prod-title {
      color: #805D52;
    }

    #ellora-prod-recs-{{ section.id }} .el-pr-price {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px;
      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1.4;
      color: var(--el-pr-muted);
      margin: 0 0 14px;
    }

    /* Card Price & Color Swatches Row */
    #ellora-prod-recs-{{ section.id }} .el-card-price-row {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      width: 100%;
      margin: 0 0 14px;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-price-row .el-pr-price {
      margin: 0 !important;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-price-row .el-card-color-swatches {
      margin: 0 !important;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-color-swatches {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin: 0;
      flex-shrink: 0;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-swatch-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, 0.15);
      display: inline-block;
      flex-shrink: 0;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
      transition: transform 0.15s ease;
      cursor: pointer;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-swatch-dot:hover {
      transform: scale(1.25);
    }

    #ellora-prod-recs-{{ section.id }} .el-card-swatch-more {
      font-size: 11px;
      color: var(--el-pr-muted, #7A7269);
      font-weight: 500;
    }

    /* Luxury Add to Cart Button matching collection */
    #ellora-prod-recs-{{ section.id }} .el-card-add-btn {
      margin-top: auto;
      width: 100%;
      height: 38px;
      padding: 0 14px;
      background: #FFFFFF;
      color: #1E1B18;
      border: 1px solid var(--el-pr-border, #ECE7E1);
      border-radius: 4px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: all 0.22s ease;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-add-btn:hover {
      background: #805D52;
      border-color: #805D52;
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(204, 158, 143, 0.22);
    }

    #ellora-prod-recs-{{ section.id }} .el-card-add-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      transition: stroke 0.2s ease;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-add-btn.is-loading {
      opacity: 0.7;
      pointer-events: none;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-add-btn.is-success {
      background: #4A6B53 !important;
      border-color: #4A6B53 !important;
      color: #FFFFFF !important;
    }

    #ellora-prod-recs-{{ section.id }} .el-card-add-btn.is-soldout {
      background: #F5F3EF;
      border-color: #E8E4DD;
      color: #A39D94;
      cursor: not-allowed;
    }

    @media (max-width: 1024px) {
      #ellora-prod-recs-{{ section.id }} .el-pr-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
      #ellora-prod-recs-{{ section.id }} .el-pr-grid.is-slider .el-pr-card {
        flex: 0 0 calc((100% - 20px) / 2);
        min-width: 220px;
      }
    }

    @media (max-width: 640px) {
      #ellora-prod-recs-{{ section.id }} .el-pr-grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile | default: '2' }}, 1fr);
        gap: 14px;
      }
      #ellora-prod-recs-{{ section.id }} .el-pr-grid.is-slider .el-pr-card {
        flex: 0 0 calc((100% - ({{ section.settings.columns_mobile | default: '2' }} - 1) * 14px) / {{ section.settings.columns_mobile | default: '2' }});
        min-width: 160px;
      }
      #ellora-prod-recs-{{ section.id }} .el-pr-prod-title {
        font-size: 17px;
        line-height: 1.25;
        margin-bottom: 4px;
      }
      #ellora-prod-recs-{{ section.id }} .el-card-price-row {
        margin-bottom: 12px;
      }
      #ellora-prod-recs-{{ section.id }} .el-pr-price {
        font-size: 13px;
        line-height: 1.4;
        margin-bottom: 0 !important;
      }
      #ellora-prod-recs-{{ section.id }} .el-pr-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  {% comment %}
    DYNAMIC COLLECTION DETERMINATION:
    1. If user came from a collection, use that collection
    2. Otherwise, look through product.collections and select the most specific collection (avoiding 'all' or 'frontpage')
    3. Fallback to manually selected collection in section settings
    4. Fallback to collections.all
  {% endcomment %}
  {%- assign dynamic_col = null -%}

  {%- if section.settings.recommendation_source == 'manual_collection' and section.settings.fallback_collection != blank -%}
    {%- assign dynamic_col = collections[section.settings.fallback_collection] -%}
  {%- elsif collection != blank and collection.products_count > 1 -%}
    {%- assign dynamic_col = collection -%}
  {%- elsif product != blank and product.collections.size > 0 -%}
    {%- for col in product.collections -%}
      {%- unless col.handle == 'frontpage' or col.handle == 'all' -%}
        {%- if col.products_count > 1 -%}
          {%- assign dynamic_col = col -%}
          {%- break -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if dynamic_col == null -%}
      {%- assign dynamic_col = product.collections.first -%}
    {%- endif -%}
  {%- endif -%}

  {%- if dynamic_col == null and section.settings.fallback_collection != blank -%}
    {%- assign dynamic_col = collections[section.settings.fallback_collection] -%}
  {%- endif -%}

  {%- if dynamic_col == null -%}
    {%- assign dynamic_col = collections.all -%}
  {%- endif -%}

  {%- assign limit_count = section.settings.products_to_show | default: 4 -%}
  {%- assign current_rendered = 0 -%}

  <div class="el-pr-container">
    <div class="el-pr-header">
      <div>
        {% if section.settings.kicker != blank %}
          <div class="el-pr-kicker">{{ section.settings.kicker | escape }}</div>
        {% endif %}
        <h2 class="el-pr-title">
          {{ section.settings.title | default: "Complementary Surfaces & Stone" | escape }}
        </h2>
        {% if section.settings.subtitle != blank %}
          <p class="el-pr-subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
      </div>
      <div style="display: flex; align-items: center; gap: 18px;">
        {%- if section.settings.layout_type == 'slider' -%}
          <div class="el-slider-nav-wrap">
            <button type="button" class="el-slider-btn el-slider-prev" aria-label="Previous products">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="el-slider-btn el-slider-next" aria-label="Next products">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
        {% if section.settings.view_all_url != blank %}
          <a href="{{ section.settings.view_all_url }}" class="el-pr-all-link">
            {{ section.settings.view_all_text | default: "Explore Entire Catalog" | escape }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% elsif dynamic_col != blank and dynamic_col.url != blank %}
          <a href="{{ dynamic_col.url }}" class="el-pr-all-link">
            Explore {{ dynamic_col.title | escape }}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="el-pr-grid{% if section.settings.layout_type == 'slider' %} is-slider{% endif %}" id="el-pr-grid-{{ section.id }}">
      {%- if dynamic_col != blank and dynamic_col.products_count > 0 -%}
        {%- for prod in dynamic_col.products -%}
          {%- comment -%} Exclude the product currently being viewed {%- endcomment -%}
          {%- if product != blank and prod.id == product.id -%}
            {%- continue -%}
          {%- endif -%}

          {%- if current_rendered >= limit_count -%}
            {%- break -%}
          {%- endif -%}

          {%- assign current_rendered = current_rendered | plus: 1 -%}

          <article class="el-pr-card" data-product-handle="{{ prod.handle }}" data-product-id="{{ prod.id }}">
            <div class="el-pr-media-wrap">
              <button type="button" class="el-pr-wish-btn" aria-label="Save {{ prod.title | escape }} to wishlist" data-wishlist-id="{{ prod.id }}" data-wishlist-handle="{{ prod.handle }}" data-wishlist-title="{{ prod.title | escape }}" data-wishlist-price="{{ prod.price | money }}" data-wishlist-image="{{ prod.featured_image | image_url: width: 400 }}" data-wishlist-url="{{ prod.url }}">
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>
              <a href="{{ prod.url }}">
                {% if prod.featured_image %}
                  <img src="{{ prod.featured_image | image_url: width: 800 }}" alt="{{ prod.title | escape }}" class="el-pr-img" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'el-pr-img' }}
                {% endif %}
              </a>
            </div>
            <div class="el-pr-info">
              <a href="{{ prod.url }}" style="text-decoration: none;">
                <h3 class="el-pr-prod-title">{{ prod.title | escape }}</h3>
              </a>
              <div class="el-card-price-row">
                <p class="el-pr-price">{{ prod.price | money }} /M2</p>
                {% render 'el-card-swatches', product: prod, show_swatches: section.settings.show_color_swatches %}
              </div>

              {%- assign default_variant = prod.selected_or_first_available_variant -%}
              {%- if default_variant.available -%}
                <button type="button" 
                  class="el-card-add-btn" 
                  data-variant-id="{{ default_variant.id }}"
                  data-product-title="{{ prod.title | escape }}"
                  aria-label="Add {{ prod.title | escape }} to cart">
                  <svg viewBox="0 0 24 24"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>
                  <span>Add to Cart</span>
                </button>
              {%- else -%}
                <button type="button" class="el-card-add-btn is-soldout" disabled>
                  <span>Sold Out</span>
                </button>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Supplementary fallback if collection only had 1 product or was too small {%- endcomment -%}
      {%- if current_rendered < limit_count and collections.all != blank -%}
        {%- for prod in collections.all.products -%}
          {%- if product != blank and prod.id == product.id -%}
            {%- continue -%}
          {%- endif -%}

          {%- if current_rendered >= limit_count -%}
            {%- break -%}
          {%- endif -%}

          {%- assign current_rendered = current_rendered | plus: 1 -%}

          <article class="el-pr-card" data-product-handle="{{ prod.handle }}" data-product-id="{{ prod.id }}">
            <div class="el-pr-media-wrap">
              <button type="button" class="el-pr-wish-btn" aria-label="Save {{ prod.title | escape }} to wishlist" data-wishlist-id="{{ prod.id }}" data-wishlist-handle="{{ prod.handle }}" data-wishlist-title="{{ prod.title | escape }}" data-wishlist-price="{{ prod.price | money }}" data-wishlist-image="{{ prod.featured_image | image_url: width: 400 }}" data-wishlist-url="{{ prod.url }}">
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>
              <a href="{{ prod.url }}">
                {% if prod.featured_image %}
                  <img src="{{ prod.featured_image | image_url: width: 800 }}" alt="{{ prod.title | escape }}" class="el-pr-img" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'el-pr-img' }}
                {% endif %}
              </a>
            </div>
            <div class="el-pr-info">
              <a href="{{ prod.url }}" style="text-decoration: none;">
                <h3 class="el-pr-prod-title">{{ prod.title | escape }}</h3>
              </a>
              <div class="el-card-price-row">
                <p class="el-pr-price">{{ prod.price | money }} /M2</p>
                {% render 'el-card-swatches', product: prod, show_swatches: section.settings.show_color_swatches %}
              </div>

              {%- assign default_variant = prod.selected_or_first_available_variant -%}
              {%- if default_variant.available -%}
                <button type="button" 
                  class="el-card-add-btn" 
                  data-variant-id="{{ default_variant.id }}"
                  data-product-title="{{ prod.title | escape }}"
                  aria-label="Add {{ prod.title | escape }} to cart">
                  <svg viewBox="0 0 24 24"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>
                  <span>Add to Cart</span>
                </button>
              {%- else -%}
                <button type="button" class="el-card-add-btn is-soldout" disabled>
                  <span>Sold Out</span>
                </button>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <script>
    (function() {
      const root = document.getElementById('ellora-prod-recs-{{ section.id }}');
      if (!root) return;

      // Slider navigation
      var prevBtn = root.querySelector('.el-slider-prev');
      var nextBtn = root.querySelector('.el-slider-next');
      var gridTrack = root.querySelector('.el-pr-grid.is-slider');

      if (gridTrack && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', function() {
          var scrollAmount = gridTrack.clientWidth * 0.75;
          gridTrack.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function() {
          var scrollAmount = gridTrack.clientWidth * 0.75;
          gridTrack.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }

      // Wishlist synchronization for recommended cards
      function getWishlist() {
        try {
          return JSON.parse(localStorage.getItem('ellora_wishlist')) || [];
        } catch(e) {
          return [];
        }
      }

      function showWishlistToast(msg) {
        var toast = document.getElementById('elWishlistGlobalToast');
        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'elWishlistGlobalToast';
          toast.className = 'el-wishlist-toast';
          toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#1C1B19;color:#FFFFFF;padding:12px 20px;border-radius:4px;font-family:sans-serif;font-size:13.5px;font-weight:500;box-shadow:0 4px 16px rgba(0,0,0,0.2);z-index:99999;opacity:0;transform:translateY(12px);transition:all 0.3s ease;pointer-events:none;display:flex;align-items:center;gap:10px;';
          document.body.appendChild(toast);
        }
        toast.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="#CC9E8F" stroke="#CC9E8F" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg> <span>' + msg + '</span>';
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        clearTimeout(window.elToastTimeout);
        window.elToastTimeout = setTimeout(function() {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(12px)';
        }, 2500);
      }

      function syncWishlistButtons() {
        const list = getWishlist();
        const ids = new Set(list.map(item => String(item.id || item.handle)));
        root.querySelectorAll('.el-pr-wish-btn').forEach(btn => {
          const id = btn.dataset.wishlistId || btn.dataset.wishlistHandle;
          if (ids.has(String(id))) {
            btn.classList.add('is-active', 'active');
          } else {
            btn.classList.remove('is-active', 'active');
          }
        });
      }

      root.querySelectorAll('.el-pr-wish-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const list = getWishlist();
          const id = this.dataset.wishlistId || this.dataset.wishlistHandle;
          const idx = list.findIndex(item => String(item.id || item.handle) === String(id));

          if (idx > -1) {
            list.splice(idx, 1);
            this.classList.remove('is-active', 'active');
            showWishlistToast('Removed from your Wishlist');
          } else {
            list.push({
              id: id,
              handle: this.dataset.wishlistHandle || id,
              title: this.dataset.wishlistTitle || '',
              price: this.dataset.wishlistPrice || '',
              image: this.dataset.wishlistImage || '',
              url: this.dataset.wishlistUrl || ('/products/' + (this.dataset.wishlistHandle || id))
            });
            this.classList.add('is-active', 'active');
            showWishlistToast('Added to your Wishlist');
          }

          localStorage.setItem('ellora_wishlist', JSON.stringify(list));
          window.dispatchEvent(new CustomEvent('ellora:wishlist:updated', { detail: { count: list.length } }));
        });
      });

      // AJAX Add to Cart Handler
      root.addEventListener('click', function(e) {
        var btn = e.target.closest('.el-card-add-btn');
        if (!btn || btn.classList.contains('is-loading') || btn.classList.contains('is-soldout')) return;
        e.preventDefault();
        e.stopPropagation();

        var variantId = btn.getAttribute('data-variant-id');
        var title = btn.getAttribute('data-product-title') || 'Product';
        var originalHTML = btn.innerHTML;

        if (!variantId) {
          btn.classList.add('is-success');
          btn.innerHTML = '&#10003; Added to Basket';
          window.dispatchEvent(new CustomEvent('ellora:cart:open'));
          setTimeout(function() {
            btn.classList.remove('is-success');
            btn.innerHTML = originalHTML;
          }, 2000);
          return;
        }

        btn.classList.add('is-loading');
        btn.innerHTML = 'Adding...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: Number(variantId),
            quantity: 1
          })
        })
        .then(function(res) {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(function(item) {
          btn.classList.remove('is-loading');
          btn.classList.add('is-success');
          btn.innerHTML = '&#10003; Added to Basket';

          // Trigger header badge refresh and cart drawer
          window.dispatchEvent(new CustomEvent('ellora:cart:refresh'));
          window.dispatchEvent(new CustomEvent('ellora:cart:updated', { detail: item }));
          window.dispatchEvent(new CustomEvent('cart:updated'));
          window.dispatchEvent(new CustomEvent('cart:refresh'));
          window.dispatchEvent(new CustomEvent('ellora:cart:open'));

          setTimeout(function() {
            btn.classList.remove('is-success');
            btn.innerHTML = originalHTML;
          }, 2200);
        })
        .catch(function(err) {
          console.error('Error adding to cart:', err);
          btn.classList.remove('is-loading');
          btn.innerHTML = originalHTML;
        });
      });

      syncWishlistButtons();
      window.addEventListener('storage', syncWishlistButtons);
      window.addEventListener('ellora:wishlist:updated', syncWishlistButtons);
    })();
  </script>
</div>

{% schema %}
{
  "name": "Paired Recommendations",
  "tag": "section",
  "class": "ellora-section-product-recs",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Editorial Kicker",
      "default": "Harmonious Combinations"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Complementary Surfaces & Stone"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated pairings designed to work harmoniously together across architectural walls and floors."
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show Color Swatches on Product Cards",
      "default": true,
      "info": "Display color preview dots under product titles on cards"
    },
    {
      "type": "select",
      "id": "recommendation_source",
      "label": "Recommendation Source",
      "options": [
        { "value": "auto_collection", "label": "Dynamic (Product's Collection)" },
        { "value": "manual_collection", "label": "Manual Fallback Collection" }
      ],
      "default": "auto_collection"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback Collection"
    },
    {
      "type": "header",
      "content": "Layout & Grid Settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout Style",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider (Carousel)" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "Explore Entire Catalog"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL"
    },
    {
      "type": "header",
      "content": "Appearance & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Accent Color",
      "default": "#CC9E8F"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "Paired Recommendations"
    }
  ]
}
{% endschema %}

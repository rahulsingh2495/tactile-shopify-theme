        },
        {
          "type": "text",
          "id": "role",
          "label": "Author Role / Title",
          "default": "FOUNDER"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Avatar Photo"
        },
        {
          "type": "text",
          "id": "fallback_avatar",
          "label": "Fallback Avatar CDN URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellora Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Working with Ellora completely changed how our brand feels online. The attention to detail, visual direction, and user experience made our platform feel premium without losing simplicity.",
            "author": "Priya Mehta",
            "role": "FOUNDER",
            "fallback_avatar": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec9_review_author_priya.jpg?v=1789453286"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The travertine pavers completely transformed our terrace into a tranquil sunlit sanctuary. The natural surface depth and quality are unrivaled in the architectural stone market.",
            "author": "Sophia M.",
            "role": "INTERIOR ARCHITECT",
            "fallback_avatar": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec9_review_author_priya.jpg?v=1789453286"
          }
        },
        {
          "type": "review",
          "settings": {

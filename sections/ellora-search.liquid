{% comment %}
  ==========================================================================
  ELLORA SPACES — SEARCH RESULTS SECTION TEMPLATE
  File: sections/ellora-search.liquid
  Theme Editor Name: Ellora Search
  Features:
  - Live instant search bar with search icon, clear button & quick tags
  - Exact same product card grids & UI as Ellora Collection & Wishlist pages
  - Native Shopify search integration ({% paginate search.results %})
  - Wishlist heart buttons hooked directly to Ellora wishlist storage
  - High-end Empty State with recommended surface categories
  - 9 fallback reference products for customizer preview
  ==========================================================================
{% endcomment %}

{%- assign search_limit = section.settings.products_per_page | default: 12 -%}
{%- paginate search.results by search_limit -%}

<div class="el-section-wrapper el-sec-search" id="ellora-search-{{ section.id }}">
  {%- assign sr_btn_bg = section.settings.btn_bg -%}
  {%- if sr_btn_bg == blank or sr_btn_bg == '#8E6356' or sr_btn_bg == '#8e6356' or sr_btn_bg == '#754F43' or sr_btn_bg == '#754f43' or sr_btn_bg == '#BA9587' or sr_btn_bg == '#ba9587' or sr_btn_bg == '#734E43' or sr_btn_bg == '#734e43' or sr_btn_bg == '#A36854' or sr_btn_bg == '#a36854' -%}
    {%- assign sr_btn_bg = '#CC9E8F' -%}
  {%- endif -%}
  {%- assign sr_btn_hover = section.settings.btn_hover -%}
  {%- if sr_btn_hover == blank or sr_btn_hover == '#8E6356' or sr_btn_hover == '#8e6356' or sr_btn_hover == '#754F43' or sr_btn_hover == '#754f43' or sr_btn_hover == '#BA9587' or sr_btn_hover == '#ba9587' or sr_btn_hover == '#734E43' or sr_btn_hover == '#734e43' or sr_btn_hover == '#A36854' or sr_btn_hover == '#a36854' -%}
    {%- assign sr_btn_hover = '#BF8673' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-search-{{ section.id }} {
      --el-sr-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
      --el-sr-primary: {{ section.settings.primary_color | default: '#CC9E8F' }};
      --el-sr-dark: {{ section.settings.text_dark | default: '#1C1B19' }};
      --el-sr-muted: {{ section.settings.text_muted | default: '#68645F' }};
      --el-sr-border: {{ section.settings.border_color | default: '#ECE7E1' }};
      --el-sr-input-bg: {{ section.settings.input_bg | default: '#FAF8F5' }};
      --el-sr-btn-bg: {{ sr_btn_bg }};
      --el-sr-btn-hover: {{ sr_btn_hover }};
      --el-sr-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-sr-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      width: 100%;
      background-color: var(--el-sr-bg);
      font-family: var(--el-sr-font-sans);
      color: var(--el-sr-dark);
      box-sizing: border-box;
      padding-top: {{ section.settings.padding_top | default: 50 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
      position: relative;
    }

    #ellora-search-{{ section.id }} *,
    #ellora-search-{{ section.id }} *::before,
    #ellora-search-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-search-{{ section.id }} .el-sr-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1280 }}px;
      margin: 0 auto;
    }

    /* Breadcrumbs */
    #ellora-search-{{ section.id }} .el-sr-breadcrumbs {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--el-sr-muted);
      margin-bottom: 24px;
    }
    #ellora-search-{{ section.id }} .el-sr-breadcrumbs a {
      color: var(--el-sr-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }
    #ellora-search-{{ section.id }} .el-sr-breadcrumbs a:hover {
      color: var(--el-sr-primary);
    }
    #ellora-search-{{ section.id }} .el-sr-breadcrumbs span.sep {
      opacity: 0.5;
    }
    #ellora-search-{{ section.id }} .el-sr-breadcrumbs span.current {
      color: var(--el-sr-dark);
      font-weight: 500;
    }

    /* Search Header & Centered Search Form */
    #ellora-search-{{ section.id }} .el-sr-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 40px auto;
    }

    #ellora-search-{{ section.id }} .el-sr-kicker {
      font-size: 11.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 600;
      color: #1C1B19;
      margin-bottom: 8px;
      display: block;
    }

    #ellora-search-{{ section.id }} .el-sr-headline {
      color: #805D52;
      font-family: var(--el-sr-font-serif);
      font-size: {{ section.settings.title_size_desktop | default: 48 }}px;
      line-height: 1.16;
      font-weight: {{ section.settings.title_weight | default: 400 }};
      color: var(--el-sr-primary);
      letter-spacing: -0.01em;
      margin-bottom: 12px;
    }

    #ellora-search-{{ section.id }} .el-sr-subheading {
      font-size: 14px;
      line-height: 1.6;
      color: var(--el-sr-muted);
      margin-bottom: 28px;
    }

    /* Live Search Box */
    #ellora-search-{{ section.id }} .el-sr-search-bar {
      position: relative;
      width: 100%;
      margin: 0 auto;
    }

    #ellora-search-{{ section.id }} .el-sr-search-form {
      position: relative;
      display: flex;
      align-items: center;
    }

    #ellora-search-{{ section.id }} .el-sr-search-icon {
      position: absolute;
      left: 18px;
      width: 18px;
      height: 18px;
      stroke: var(--el-sr-muted);
      fill: none;
      stroke-width: 1.8;
      pointer-events: none;
    }

    #ellora-search-{{ section.id }} .el-sr-input {
      width: 100%;
      height: 52px;
      background: var(--el-sr-input-bg);
      border: 1px solid var(--el-sr-border);
      border-radius: 4px;
      padding: 0 50px 0 48px;
      font-family: var(--el-sr-font-sans);
      font-size: 14.5px;
      color: var(--el-sr-dark);
      outline: none;
      transition: all 0.25s ease;
    }

    #ellora-search-{{ section.id }} .el-sr-input:focus {
      background: #FFFFFF;
      border-color: var(--el-sr-primary);
      box-shadow: 0 0 0 1px var(--el-sr-primary);
    }

    #ellora-search-{{ section.id }} .el-sr-input::placeholder {
      color: #A49F98;
    }

    #ellora-search-{{ section.id }} .el-sr-clear-btn {
      position: absolute;
      right: 16px;
      width: 24px;
      height: 24px;
      background: #ECE7E1;
      border: none;
      border-radius: 50%;
      color: var(--el-sr-dark);
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, background 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-sr-clear-btn.is-visible {
      opacity: 1;
      pointer-events: auto;
    }

    #ellora-search-{{ section.id }} .el-sr-clear-btn:hover {
      background: #DDD7CE;
    }

    /* Popular Search Pills */
    #ellora-search-{{ section.id }} .el-sr-tags-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    #ellora-search-{{ section.id }} .el-sr-tags-label {
      font-size: 12px;
      color: var(--el-sr-muted);
      font-weight: 500;
    }

    #ellora-search-{{ section.id }} .el-sr-tag-pill {
      background: #FAF8F5;
      border: 1px solid var(--el-sr-border);
      border-radius: 14px;
      padding: 3px 11px;
      font-size: 11.5px;
      color: var(--el-sr-dark);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-sr-tag-pill:hover {
      background: #FAF2ED;
      border-color: var(--el-sr-primary);
      color: var(--el-sr-primary);
    }

    /* Results Status Bar */
    #ellora-search-{{ section.id }} .el-sr-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
      margin-bottom: 32px;
      border-top: 1px solid var(--el-sr-border);
      border-bottom: 1px solid var(--el-sr-border);
      font-size: 13.5px;
    }

    #ellora-search-{{ section.id }} .el-sr-count-text {
      color: var(--el-sr-muted);
    }
    #ellora-search-{{ section.id }} .el-sr-count-text strong {
      color: var(--el-sr-dark);
    }

    /* Exact Product Grid (Matching Collection & Wishlist) */
    #ellora-search-{{ section.id }} .el-product-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
      gap: 32px 24px;
      margin-bottom: 48px;
    }

    #ellora-search-{{ section.id }} .el-product-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      text-decoration: none;
      position: relative;
    }

    #ellora-search-{{ section.id }} .el-card-media {
      position: relative;
      aspect-ratio: 4 / 5;
      width: 100%;
      overflow: hidden;
      background: #EDE8E2;
      border-radius: 8px;
      margin-bottom: 14px;
    }

    #ellora-search-{{ section.id }} .el-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #ellora-search-{{ section.id }} .el-product-card:hover .el-card-img {
      transform: scale(1.04);
    }

    /* Wishlist Heart Icon (Linked to Ellora Wishlist Storage) */
    #ellora-search-{{ section.id }} .el-wishlist-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      background: #FFFFFF;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: none;
      cursor: pointer;
      z-index: 3;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-wishlist-btn:hover {
      transform: scale(1.08);
      background: #FAF2ED;
    }

    #ellora-search-{{ section.id }} .el-wishlist-btn svg {
      width: 15px;
      height: 15px;
      stroke: var(--el-sr-dark);
      fill: none;
      stroke-width: 1.6;
      transition: all 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-wishlist-btn.is-active {
      background: #FAF2ED;
      transform: scale(1.08);
    }

    #ellora-search-{{ section.id }} .el-wishlist-btn.is-active svg {
      stroke: var(--el-sr-primary);
      fill: var(--el-sr-primary);
    }

    /* Product Card Info */
    #ellora-search-{{ section.id }} .el-card-info {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      gap: 0;
    }

    #ellora-search-{{ section.id }} .el-card-title {
      font-family: var(--el-sr-font-serif);
      font-size: 20px;
      font-weight: 400;
      color: var(--el-sr-dark);
      margin: 0 0 4px;
      letter-spacing: -0.01em;
      line-height: 1.25;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-product-card:hover .el-card-title {
      color: #805D52;
    }

    #ellora-search-{{ section.id }} .el-card-price {
      font-family: var(--el-sr-font-sans);
      font-size: 14px;
      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1.4;
      color: var(--el-sr-muted);
      margin: 0 0 14px;
    }

    /* Card Price & Color Swatches Row */
    #ellora-search-{{ section.id }} .el-card-price-row {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      width: 100%;
      margin: 0 0 14px;
    }

    #ellora-search-{{ section.id }} .el-card-price-row .el-card-price {
      margin: 0 !important;
    }

    #ellora-search-{{ section.id }} .el-card-price-row .el-card-color-swatches {
      margin: 0 !important;
    }

    #ellora-search-{{ section.id }} .el-card-color-swatches {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin: 0;
      flex-shrink: 0;
    }

    #ellora-search-{{ section.id }} .el-card-swatch-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, 0.15);
      display: inline-block;
      flex-shrink: 0;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
      transition: transform 0.15s ease;
      cursor: pointer;
    }

    #ellora-search-{{ section.id }} .el-card-swatch-dot:hover {
      transform: scale(1.25);
    }

    #ellora-search-{{ section.id }} .el-card-swatch-more {
      font-size: 11px;
      color: var(--el-sr-muted, #7A7269);
      font-weight: 500;
    }

    /* Luxury Add to Cart Button */
    #ellora-search-{{ section.id }} .el-card-add-btn {
      margin-top: auto;
      width: 100%;
      height: 38px;
      padding: 0 14px;
      background: #FFFFFF;
      color: #1E1B18;
      border: 1px solid var(--el-sr-border, #ECE7E1);
      border-radius: 4px;
      font-family: var(--el-sr-font-sans);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: all 0.22s ease;
    }

    #ellora-search-{{ section.id }} .el-card-add-btn:hover {
      background: var(--el-sr-primary, #CC9E8F);
      border-color: var(--el-sr-primary, #CC9E8F);
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(204, 158, 143, 0.22);
    }

    #ellora-search-{{ section.id }} .el-card-add-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      transition: stroke 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-card-add-btn.is-loading {
      opacity: 0.7;
      pointer-events: none;
    }

    #ellora-search-{{ section.id }} .el-card-add-btn.is-success {
      background: #4A6B53 !important;
      border-color: #4A6B53 !important;
      color: #FFFFFF !important;
    }

    #ellora-search-{{ section.id }} .el-card-add-btn.is-soldout {
      background: #F5F3EF;
      border-color: #E8E4DD;
      color: #A39D94;
      cursor: not-allowed;
    }

    /* Real Native Pagination */
    #ellora-search-{{ section.id }} .el-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding-top: 24px;
      border-top: 1px solid var(--el-sr-border);
    }

    #ellora-search-{{ section.id }} .el-page-btn {
      min-width: 34px;
      height: 34px;
      padding: 0 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 400;
      color: var(--el-sr-dark);
      background: #FFFFFF;
      border: 1px solid var(--el-sr-border);
      border-radius: 2px;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    #ellora-search-{{ section.id }} .el-page-btn.is-active,
    #ellora-search-{{ section.id }} .el-page-btn:hover:not(.disabled) {
      background: var(--el-sr-primary);
      border-color: var(--el-sr-primary);
      color: #FFFFFF;
    }

    /* Empty State */
    #ellora-search-{{ section.id }} .el-sr-empty-card {
      background: #FFFAF8;
      border: 1px solid #F2E8E2;
      border-radius: 4px;
      padding: 64px 24px;
      text-align: center;
      margin: 20px 0 40px 0;
    }

    #ellora-search-{{ section.id }} .el-sr-empty-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 18px auto;
      border-radius: 50%;
      background: #FAF2ED;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #ellora-search-{{ section.id }} .el-sr-empty-icon svg {
      width: 24px;
      height: 24px;
      stroke: var(--el-sr-primary);
      fill: none;
      stroke-width: 1.6;
    }

    #ellora-search-{{ section.id }} .el-sr-empty-title {
      font-family: var(--el-sr-font-serif);
      font-size: 32px;
      color: #805D52;
      margin-bottom: 10px;
    }

    #ellora-search-{{ section.id }} .el-sr-empty-desc {
      font-size: 14px;
      line-height: 1.6;
      color: var(--el-sr-muted);
      max-width: 480px;
      margin: 0 auto 24px auto;
    }

    #ellora-search-{{ section.id }} .el-sr-empty-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--el-sr-btn-bg, #CC9E8F) !important;
      color: #FFFFFF !important;
      border: 1px solid var(--el-sr-btn-bg, #CC9E8F) !important;
      border-radius: 3px;
      padding: 0 32px;
      height: 46px;
      font-size: 13.5px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.25s ease, border-color 0.25s ease;
    }

    #ellora-search-{{ section.id }} .el-sr-empty-btn:hover {
      background: var(--el-sr-btn-hover, #BF8673) !important;
      border-color: var(--el-sr-btn-hover, #BF8673) !important;
    }

    /* Responsive */
    @media (max-width: 1100px) {
      #ellora-search-{{ section.id }} .el-product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px 18px;
      }
    }

    @media (max-width: 768px) {
      #ellora-search-{{ section.id }} .el-sr-headline {
        font-size: {{ section.settings.title_size_mobile | default: 32 }}px;
      }
      #ellora-search-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile | default: 36 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 50 }}px;
      }
    }

    @media (max-width: 640px) {
      #ellora-search-{{ section.id }} .el-product-grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile | default: '2' }}, 1fr);
        gap: 14px;
      }
      #ellora-search-{{ section.id }} .el-card-title {
        font-size: 17px;
        line-height: 1.25;
        margin-bottom: 4px;
      }
      #ellora-search-{{ section.id }} .el-card-price-row {
        margin-bottom: 12px;
      }
      #ellora-search-{{ section.id }} .el-card-price {
        font-size: 13px;
        line-height: 1.4;
        margin-bottom: 0 !important;
      }
      #ellora-search-{{ section.id }} .el-sr-status-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
    }
  </style>

  <div class="el-sr-container">

    <!-- Breadcrumb -->
    <nav class="el-sr-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">/</span>
      <span class="current">Search</span>
    </nav>

    <!-- Search Header & Search Form -->
    <div class="el-sr-header">
      <span class="el-sr-kicker">{{ section.settings.kicker | default: 'EXPLORE OUR CATALOGUE' }}</span>
      <h1 class="el-sr-headline">
        {%- if search.performed and search.terms != blank -%}
          Results for &ldquo;{{ search.terms }}&rdquo;
        {%- else -%}
          {{ section.settings.title | default: 'Search Surfaces' }}
        {%- endif -%}
      </h1>
      <p class="el-sr-subheading">
        {{ section.settings.subtitle | default: 'Find the ideal stone slabs, architectural tiles, and bespoke wallpapers for your room.' }}
      </p>

      <!-- Live Search Form -->
      <div class="el-sr-search-bar">
        <form action="{{ routes.search_url }}" method="get" role="search" class="el-sr-search-form" id="elSearchForm-{{ section.id }}">
          <input type="hidden" name="type" value="product">
          <svg class="el-sr-search-icon" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            name="q"
            id="elSearchInput-{{ section.id }}"
            class="el-sr-input"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Search tiles, wallpapers, marble surfaces, sizes...' }}"
            autocomplete="off"
            spellcheck="false"
          >
          <button type="button" class="el-sr-clear-btn" id="elSearchClear-{{ section.id }}" aria-label="Clear search">
            &times;
          </button>
        </form>
      </div>

      <!-- Quick Suggested Search Tags -->
      {%- if section.settings.show_tags -%}
        <div class="el-sr-tags-row">
          <span class="el-sr-tags-label">Popular:</span>
          {%- assign tags_array = section.settings.popular_tags | split: ',' -%}
          {%- for tag in tags_array -%}
            {%- assign clean_tag = tag | strip -%}
            {%- if clean_tag != blank -%}
              <a href="{{ routes.search_url }}?type=product&q={{ clean_tag | url_encode }}" class="el-sr-tag-pill" data-query="{{ clean_tag }}">
                {{ clean_tag }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Status & Results Count -->
    <div class="el-sr-status-bar">
      <div class="el-sr-count-text" id="elSrCountText">
        {%- if search.performed -%}
          Showing <strong>{{ search.results_count }}</strong> {{ search.results_count | pluralize: 'result', 'results' }}
          {%- if search.terms != blank -%} for &ldquo;<strong>{{ search.terms }}</strong>&rdquo;{%- endif -%}
        {%- else -%}

{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 6: OUR MOST LOVED TILES (ELLORA EDITS)
  File: sections/ellora-loved-tiles.liquid
  Fully customizable via Shopify Theme Customizer
  Supports Shopify Collection, Product List, or Custom Product Blocks
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-edits-wrapper" id="ellora-edits-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-edits-{{ section.id }} {
      --el-bg-main: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: #1C1B19;
      --el-muted: #736E67;
      --el-primary: #CC9E8F;
      --el-border: #E8E3DC;
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --el-radius-sm: 4px;

      background-color: var(--el-bg-main);
      padding: {{ section.settings.padding_top | default: 50 }}px 0 {{ section.settings.padding_bottom | default: 50 }}px;
      border-top: 1px solid var(--el-border);
      width: 100%;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-edits-{{ section.id }} *,
    #ellora-edits-{{ section.id }} *::before,
    #ellora-edits-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-edits-{{ section.id }} .el-sec-edits-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
    }

    #ellora-edits-{{ section.id }} .el-section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 36px;
    }

    #ellora-edits-{{ section.id }} .el-kicker {
      font-family: var(--el-font-sans);
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-weight: 600;
      color: var(--el-muted);
      margin-bottom: 14px;
      display: inline-block;
    }

    #ellora-edits-{{ section.id }} .el-section-title {
      font-family: var(--el-font-serif);
      font-size: 48px;
      line-height: 1.15;
      font-weight: 400;
      color: var(--el-dark);
      letter-spacing: -0.01em;
    }

    #ellora-edits-{{ section.id }} .el-link-arrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13.5px;
      font-weight: 500;
      color: var(--el-dark);
      letter-spacing: 0.02em;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
      transition: color 0.25s ease;
    }

    #ellora-edits-{{ section.id }} .el-header-controls {
      display: inline-flex;
      align-items: center;
      gap: 18px;
      flex-shrink: 0;
    }

    #ellora-edits-{{ section.id }} .el-link-arrow svg {
      transition: transform 0.25s ease;
    }

    #ellora-edits-{{ section.id }} .el-link-arrow:hover {
      color: var(--el-primary);
    }

    #ellora-edits-{{ section.id }} .el-link-arrow:hover svg {
      transform: translate(3px, -3px);
    }

    #ellora-edits-{{ section.id }} .el-slider-nav-wrap {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    #ellora-edits-{{ section.id }} .el-slider-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #FFFFFF;
      border: 1px solid var(--el-border);
      color: var(--el-dark);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.22s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }

    #ellora-edits-{{ section.id }} .el-slider-btn:hover {
      background: var(--el-primary);
      border-color: var(--el-primary);
      color: #FFFFFF;
    }

    #ellora-edits-{{ section.id }} .el-products-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: 26px;
      align-items: stretch;
    }

    #ellora-edits-{{ section.id }} .el-products-grid.is-slider {
      display: flex !important;
      align-items: stretch;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 24px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 8px;
    }

    #ellora-edits-{{ section.id }} .el-products-grid.is-slider::-webkit-scrollbar {
      display: none;
    }

    #ellora-edits-{{ section.id }} .el-products-grid.is-slider .el-product-card {
      flex: 0 0 calc((100% - ({{ section.settings.columns_desktop | default: 4 }} - 1) * 24px) / {{ section.settings.columns_desktop | default: 4 }});
      min-width: 250px;
      scroll-snap-align: start;
    }

    #ellora-edits-{{ section.id }} .el-product-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      position: relative;
      text-decoration: none;
      color: inherit;
    }

    #ellora-edits-{{ section.id }} .el-product-media {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      background-color: #EDE8E2;
      margin-bottom: 14px;
    }

    #ellora-edits-{{ section.id }} .el-product-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
      display: block;
    }

    #ellora-edits-{{ section.id }} .el-product-card:hover .el-product-media img {
      transform: scale(1.05);
    }

    /* Wishlist Heart Icon */
    #ellora-edits-{{ section.id }} .el-wishlist-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 32px;
      height: 32px;
      background: #FFFFFF;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      border: none;
      cursor: pointer;
      z-index: 3;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    #ellora-edits-{{ section.id }} .el-wishlist-btn:hover {
      transform: scale(1.08);
      background: #FAF2ED;
    }

    #ellora-edits-{{ section.id }} .el-wishlist-btn svg {
      width: 15px;
      height: 15px;
      stroke: var(--el-dark, #1C1B19);
      fill: none;
      stroke-width: 1.6;
      transition: all 0.2s ease;
    }

    #ellora-edits-{{ section.id }} .el-wishlist-btn.is-active,
    #ellora-edits-{{ section.id }} .el-wishlist-btn.active {
      background: #FAF2ED;
      transform: scale(1.08);
    }

    #ellora-edits-{{ section.id }} .el-wishlist-btn.is-active svg,
    #ellora-edits-{{ section.id }} .el-wishlist-btn.active svg {
      stroke: var(--el-primary, #CC9E8F);
      fill: var(--el-primary, #CC9E8F);
    }

    #ellora-edits-{{ section.id }} .el-product-tag {
      position: absolute;
      top: 14px;
      left: 14px;
      background-color: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      padding: 4px 10px;
      border-radius: 3px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--el-dark);
      z-index: 2;
    }

    /* Product Card Info */
    #ellora-edits-{{ section.id }} .el-card-info {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      gap: 0;
    }

    #ellora-edits-{{ section.id }} .el-card-details {
      min-height: 74px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      margin-bottom: 12px;
    }

    #ellora-edits-{{ section.id }} .el-card-info a,
    #ellora-edits-{{ section.id }} .el-card-details a {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    #ellora-edits-{{ section.id }} .el-product-title {
      font-family: var(--el-font-serif);
      font-size: 20px;
      color: var(--el-dark);
      font-weight: 400;
      line-height: 1.25;
      letter-spacing: -0.01em;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0 0 4px;
      transition: color 0.25s ease;
    }

    #ellora-edits-{{ section.id }} .el-product-card:hover .el-product-title {
      color: var(--el-primary);
    }

    #ellora-edits-{{ section.id }} .el-product-finish {
      font-size: 13px;
      color: var(--el-muted);
      margin-bottom: 2px;
    }

    #ellora-edits-{{ section.id }} .el-product-price {
      font-family: var(--el-font-sans);
      font-size: 14px;
      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1.4;
      color: var(--el-muted);
      margin: 0;
    }

    /* Uniform Add to Cart Button */
    #ellora-edits-{{ section.id }} .el-card-add-btn {
      margin-top: auto;
      width: 100%;
      height: 38px;
      padding: 0 14px;
      background: #FFFFFF;
      color: var(--el-dark, #1C1B19);
      border: 1px solid var(--el-border, #E8E3DC);
      border-radius: 4px;
      font-family: var(--el-font-sans);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: all 0.22s ease;
    }

    #ellora-edits-{{ section.id }} .el-card-add-btn:hover {
      background: var(--el-primary, #CC9E8F);
      border-color: var(--el-primary, #CC9E8F);
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(204, 158, 143, 0.22);
    }

    #ellora-edits-{{ section.id }} .el-card-add-btn svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      transition: stroke 0.2s ease;
    }

    #ellora-edits-{{ section.id }} .el-card-add-btn.is-loading {
      opacity: 0.7;
      pointer-events: none;
    }

    #ellora-edits-{{ section.id }} .el-card-add-btn.is-success {
      background: #4A6B53 !important;
      border-color: #4A6B53 !important;
      color: #FFFFFF !important;
    }

    #ellora-edits-{{ section.id }} .el-card-add-btn.is-soldout {
      background: #F5F3EF;
      border-color: #E8E4DD;
      color: #A39D94;
      cursor: not-allowed;
    }

    @media (max-width: 1024px) {
      #ellora-edits-{{ section.id }} .el-products-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
      #ellora-edits-{{ section.id }} .el-products-grid.is-slider .el-product-card {
        flex: 0 0 calc((100% - 20px) / 2);
        min-width: 220px;
      }
    }

    @media (max-width: 640px) {
      #ellora-edits-{{ section.id }} .el-section-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 24px;
      }
      #ellora-edits-{{ section.id }} .el-header-controls {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      #ellora-edits-{{ section.id }} .el-link-arrow {
        margin-left: auto;
      }
      #ellora-edits-{{ section.id }} .el-slider-nav-wrap + .el-link-arrow {
        margin-left: 0;
      }
      #ellora-edits-{{ section.id }} .el-products-grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile | default: '2' }}, 1fr);
        gap: 14px;
      }
      #ellora-edits-{{ section.id }} .el-products-grid.is-slider .el-product-card {
        flex: 0 0 calc((100% - ({{ section.settings.columns_mobile | default: '2' }} - 1) * 14px) / {{ section.settings.columns_mobile | default: '2' }});
        min-width: 160px;
      }
      #ellora-edits-{{ section.id }} .el-section-title {
        font-size: 34px;
      }
      #ellora-edits-{{ section.id }} .el-card-details {
        min-height: 64px;
        margin-bottom: 10px;
      }
      #ellora-edits-{{ section.id }} .el-product-title {
        font-size: 17px;
        line-height: 1.25;
        margin-bottom: 4px;
      }
      #ellora-edits-{{ section.id }} .el-product-price {
        font-size: 13px;
        line-height: 1.4;
        margin-bottom: 0;
      }
    }
  </style>

  <div class="el-sec-edits-container">
    <div class="el-section-header">
      <div>
        {%- if section.settings.kicker != blank -%}
          <span class="el-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="el-section-title">{{ section.settings.heading }}</h2>
      </div>
      <div class="el-header-controls">
        {%- if section.settings.layout_type == 'slider' -%}
          <div class="el-slider-nav-wrap">
            <button type="button" class="el-slider-btn el-slider-prev" aria-label="Previous products">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="el-slider-btn el-slider-next" aria-label="Next products">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
        {%- if section.settings.view_all_label != blank -%}
          <a href="{{ section.settings.collection.url | default: section.settings.view_all_link | default: '/collections/all' }}" class="el-link-arrow">
            <span>{{ section.settings.view_all_label }}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="el-products-grid{% if section.settings.layout_type == 'slider' %} is-slider{% endif %}">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <div class="el-product-card" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
            <div class="el-product-media">
              <button type="button" class="el-wishlist-btn" aria-label="Add {{ product.title }} to wishlist" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}" data-product-price="{{ product.price | money }} / m²" data-product-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 }}{% endif %}" data-product-url="{{ product.url }}" data-wishlist-id="{{ product.id }}" data-wishlist-handle="{{ product.handle }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-price="{{ product.price | money }} / m²" data-wishlist-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 }}{% endif %}" data-wishlist-url="{{ product.url }}">
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>
              <a href="{{ product.url }}" style="display:block; width:100%; height:100%;">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
            </div>
            <div class="el-card-info">
              <div class="el-card-details">
                <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
                  <h3 class="el-product-title">{{ product.title }}</h3>
                </a>
                {% render 'el-card-swatches', product: product, show_swatches: section.settings.show_color_swatches %}
                <p class="el-product-price">{{ product.price | money }} / m²</p>
              </div>
              {%- assign default_variant = product.selected_or_first_available_variant -%}
              {%- if default_variant.available -%}
                <button type="button" class="el-card-add-btn" data-variant-id="{{ default_variant.id }}" data-product-title="{{ product.title | escape }}" aria-label="Add {{ product.title }} to cart">
                  <svg viewBox="0 0 24 24"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>
                  <span>Add to Cart</span>
                </button>
              {%- else -%}
                <button type="button" class="el-card-add-btn is-soldout" disabled>
                  <span>Sold Out</span>
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="el-product-card" {{ block.shopify_attributes }} data-product-id="block-{{ block.id }}" data-product-handle="{{ block.settings.title | handleize }}">
            <div class="el-product-media">
              <button type="button" class="el-wishlist-btn" aria-label="Add {{ block.settings.title }} to wishlist" data-product-id="block-{{ block.id }}" data-product-handle="{{ block.settings.title | handleize }}" data-product-title="{{ block.settings.title | escape }}" data-product-price="{{ block.settings.price }}" data-product-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% elsif block.settings.fallback_image != blank %}{{ block.settings.fallback_image }}{% endif %}" data-product-url="{{ block.settings.link | default: '/collections/all' }}" data-wishlist-id="block-{{ block.id }}" data-wishlist-handle="{{ block.settings.title | handleize }}" data-wishlist-title="{{ block.settings.title | escape }}" data-wishlist-price="{{ block.settings.price }}" data-wishlist-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% elsif block.settings.fallback_image != blank %}{{ block.settings.fallback_image }}{% endif %}" data-wishlist-url="{{ block.settings.link | default: '/collections/all' }}">
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>
              <a href="{{ block.settings.link | default: '/collections/all' }}" style="display:block; width:100%; height:100%;">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- elsif block.settings.fallback_image != blank -%}
                  <img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.title }}" loading="lazy">
                {%- else -%}
                  <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec6_tile1.jpg?v=1789453290" alt="{{ block.settings.title }}" loading="lazy">
                {%- endif -%}
              </a>
            </div>
            <div class="el-card-info">
              <div class="el-card-details">
                <a href="{{ block.settings.link | default: '/collections/all' }}" style="text-decoration:none; color:inherit;">
                  <h3 class="el-product-title">{{ block.settings.title }}</h3>
                </a>
                {% render 'el-card-swatches', block_color: block.settings.swatch_colors, show_swatches: section.settings.show_color_swatches %}
                <p class="el-product-price">{{ block.settings.price }}</p>
              </div>
              <button type="button" class="el-card-add-btn" data-product-title="{{ block.settings.title | escape }}" aria-label="Add {{ block.settings.title }} to cart">
                <svg viewBox="0 0 24 24"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>
                <span>Add to Cart</span>
              </button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <script>
    (function() {
      const root = document.getElementById('ellora-edits-{{ section.id }}');
      if (!root) return;

      // Slider navigation
      var prevBtn = root.querySelector('.el-slider-prev');
      var nextBtn = root.querySelector('.el-slider-next');
      var gridTrack = root.querySelector('.el-products-grid.is-slider');

      if (gridTrack && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', function() {
          var scrollAmount = gridTrack.clientWidth * 0.75;
          gridTrack.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function() {
          var scrollAmount = gridTrack.clientWidth * 0.75;
          gridTrack.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }

      // Wishlist synchronization
      function getWishlist() {
        try {
          return JSON.parse(localStorage.getItem('ellora_wishlist') || '[]');
        } catch(e) {
          return [];
        }
      }

      function syncWishlistButtons() {
        var list = getWishlist();
        var buttons = root.querySelectorAll('.el-wishlist-btn');
        buttons.forEach(function(btn) {
          var id = btn.getAttribute('data-product-id') || btn.getAttribute('data-wishlist-id');
          var handle = btn.getAttribute('data-product-handle') || btn.getAttribute('data-wishlist-handle');
          var title = btn.getAttribute('data-product-title') || btn.getAttribute('data-wishlist-title');
          var inList = list.some(function(item) {
            if (id && item.id && String(item.id) === String(id)) return true;
            if (handle && item.handle && item.handle === handle) return true;
            if (title && item.title && item.title.toLowerCase() === title.toLowerCase()) return true;
            return false;
          });
          if (inList) {
            btn.classList.add('is-active', 'active');
          } else {
            btn.classList.remove('is-active', 'active');
          }
        });
      }

      function showWishlistToast(msg) {
        var toast = document.getElementById('elWishlistGlobalToast');
        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'elWishlistGlobalToast';
          toast.className = 'el-wishlist-toast';
          toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#1C1B19;color:#FFFFFF;padding:12px 20px;border-radius:4px;font-family:sans-serif;font-size:13.5px;font-weight:500;box-shadow:0 4px 16px rgba(0,0,0,0.2);z-index:99999;opacity:0;transform:translateY(12px);transition:all 0.3s ease;pointer-events:none;display:flex;align-items:center;gap:10px;';
          document.body.appendChild(toast);
        }
        toast.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="#CC9E8F" stroke="#CC9E8F" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg> <span>' + msg + '</span>';
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        clearTimeout(window.elToastTimeout);
        window.elToastTimeout = setTimeout(function() {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(12px)';
        }, 2500);
      }

      root.addEventListener('click', function(e) {
        var btn = e.target.closest('.el-wishlist-btn');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();

        var card = btn.closest('.el-product-card');
        var id = btn.getAttribute('data-product-id') || btn.getAttribute('data-wishlist-id') || (card ? card.getAttribute('data-product-id') : '') || ('item-' + Date.now());
        var handle = btn.getAttribute('data-product-handle') || btn.getAttribute('data-wishlist-handle') || (card ? card.getAttribute('data-product-handle') : '') || '';
        var title = btn.getAttribute('data-product-title') || btn.getAttribute('data-wishlist-title') || (card && card.querySelector('.el-product-title') ? card.querySelector('.el-product-title').textContent.trim() : '') || 'Ellora Surface';
        var price = btn.getAttribute('data-product-price') || btn.getAttribute('data-wishlist-price') || (card && card.querySelector('.el-product-price') ? card.querySelector('.el-product-price').textContent.trim() : '') || '';
        var image = btn.getAttribute('data-product-image') || btn.getAttribute('data-wishlist-image') || (card && card.querySelector('img') ? card.querySelector('img').getAttribute('src') : '') || '';
        var url = btn.getAttribute('data-product-url') || btn.getAttribute('data-wishlist-url') || (card && card.querySelector('a') ? card.querySelector('a').getAttribute('href') : '') || '/collections/all';

        var list = getWishlist();
        var existingIndex = list.findIndex(function(item) {
          if (id && item.id && String(item.id) === String(id)) return true;
          if (handle && item.handle && item.handle === handle) return true;
          if (title && item.title && item.title.toLowerCase() === title.toLowerCase()) return true;
          return false;
        });

        if (existingIndex > -1) {
          list.splice(existingIndex, 1);
          btn.classList.remove('is-active', 'active');
          showWishlistToast('Removed from your Wishlist');
        } else {
          list.push({
            id: id,
            handle: handle,
            title: title,
            price: price,
            image: image,
            url: url
          });
          btn.classList.add('is-active', 'active');
          showWishlistToast('Added to your Wishlist');
        }

        localStorage.setItem('ellora_wishlist', JSON.stringify(list));
        window.dispatchEvent(new CustomEvent('ellora:wishlist:updated', { detail: { count: list.length, items: list } }));
        syncWishlistButtons();
      });

      // AJAX Add to Cart Handler
      root.addEventListener('click', function(e) {
        var btn = e.target.closest('.el-card-add-btn');
        if (!btn || btn.classList.contains('is-loading') || btn.classList.contains('is-soldout')) return;
        e.preventDefault();
        e.stopPropagation();

        var variantId = btn.getAttribute('data-variant-id');
        var originalHTML = btn.innerHTML;

        if (!variantId) {
          btn.classList.add('is-success');
          btn.innerHTML = '&#10003; Added to Basket';
          window.dispatchEvent(new CustomEvent('ellora:cart:open'));
          setTimeout(function() {
            btn.classList.remove('is-success');
            btn.innerHTML = originalHTML;
          }, 2000);
          return;
        }

        btn.classList.add('is-loading');
        btn.innerHTML = 'Adding...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: Number(variantId),
            quantity: 1
          })
        })
        .then(function(res) {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(function(item) {
          btn.classList.remove('is-loading');
          btn.classList.add('is-success');
          btn.innerHTML = '&#10003; Added to Basket';

          window.dispatchEvent(new CustomEvent('ellora:cart:refresh'));
          window.dispatchEvent(new CustomEvent('ellora:cart:updated', { detail: item }));
          window.dispatchEvent(new CustomEvent('cart:updated'));
          window.dispatchEvent(new CustomEvent('cart:refresh'));
          window.dispatchEvent(new CustomEvent('ellora:cart:open'));

          setTimeout(function() {
            btn.classList.remove('is-success');
            btn.innerHTML = originalHTML;
          }, 2200);
        })
        .catch(function(err) {
          console.error('Error adding to cart:', err);
          btn.classList.remove('is-loading');
          btn.innerHTML = originalHTML;
        });
      });

      syncWishlistButtons();
      window.addEventListener('storage', syncWishlistButtons);
      window.addEventListener('ellora:wishlist:updated', syncWishlistButtons);
    })();
  </script>
</div>


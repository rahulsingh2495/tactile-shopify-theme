{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 8: COMMUNITY & UGC GALLERY (#ElloraLiving)
  File: sections/ellora-community.liquid
  Pixel-perfect implementation matching the UI reference image
  Features:
  - Header: 'SHARED BY OUR COMMUNITY' kicker, serif '#ElloraLiving', subtitle
  - 4 UGC photo cards with floating white Instagram handle badges
  - Centered 'See all projects ↗' CTA link with underline
  - Optional infinite marquee showcase strip
  - Full Shopify customizer control over texts, tags, images, links & spacing
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-community-wrapper" id="ellora-community-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-community-{{ section.id }} {
      --el-bg-main: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: #1C1B19;
      --el-muted: #736E67;
      --el-primary: #B86B53;
      --el-title-color: {{ section.settings.title_color | default: '#8E6356' }};
      --el-border: #E8E3DC;
      --el-badge-bg: {{ section.settings.badge_bg | default: '#FFFFFF' }};
      --el-badge-text: {{ section.settings.badge_text_color | default: '#2D2A28' }};
      --el-card-radius: {{ section.settings.card_radius | default: 8 }}px;
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      background-color: var(--el-bg-main);
      padding-top: {{ section.settings.padding_top | default: 70 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 70 }}px;
      width: 100%;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      overflow: hidden;
    }

    #ellora-community-{{ section.id }} *,
    #ellora-community-{{ section.id }} *::before,
    #ellora-community-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-community-{{ section.id }} .el-sec-community-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
    }

    #ellora-community-{{ section.id }} .el-community-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 42px;
    }

    #ellora-community-{{ section.id }} .el-kicker {
      font-family: var(--el-font-sans);
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-weight: 600;
      color: var(--el-muted);
      margin-bottom: 14px;
      display: inline-block;
    }

    #ellora-community-{{ section.id }} .el-community-header h2 {
      font-family: var(--el-font-serif);
      font-size: {{ section.settings.heading_size | default: 52 }}px;
      line-height: 1.15;
      font-weight: 400;
      color: var(--el-title-color);
      letter-spacing: -0.01em;
      margin-bottom: 12px;
    }

    #ellora-community-{{ section.id }} .el-community-header p {
      font-size: 15px;
      color: var(--el-muted);
      line-height: 1.6;
    }

    /* -----------------------------------------------------------------------
       4-COLUMN UGC CARDS GRID
       ----------------------------------------------------------------------- */
    #ellora-community-{{ section.id }} .el-community-cards-grid {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: {{ section.settings.grid_gap | default: 24 }}px !important;
      margin-bottom: 42px;
    }

    #ellora-community-{{ section.id }} .el-community-card {
      position: relative;
      border-radius: var(--el-card-radius);
      overflow: hidden;
      aspect-ratio: 1 / 1.34;
      background-color: #E5E0D8;
      display: block;
      text-decoration: none;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
      transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    #ellora-community-{{ section.id }} .el-community-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      display: block;
    }

    #ellora-community-{{ section.id }} .el-community-card:hover img {
      transform: scale(1.05);
    }

    /* -----------------------------------------------------------------------
       WHITE INSTAGRAM HANDLE BADGE (Pixel-Perfect from UI Reference)
       ----------------------------------------------------------------------- */
    #ellora-community-{{ section.id }} .el-community-badge {
      position: absolute;
      bottom: 16px;
      left: 16px;
      background: var(--el-badge-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      padding: 6px 14px;
      border-radius: 4px;
      font-size: 12.5px;
      font-weight: 500;
      color: var(--el-badge-text);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.7);
      z-index: 2;
      transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    #ellora-community-{{ section.id }} .el-community-card:hover .el-community-badge {
      background: #FFFFFF;
      color: var(--el-primary);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    }

    /* -----------------------------------------------------------------------
       CENTERED CTA: 'See all projects ↗'
       ----------------------------------------------------------------------- */
    #ellora-community-{{ section.id }} .el-community-action-wrap {
      text-align: center;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    #ellora-community-{{ section.id }} .el-community-cta-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--el-font-sans);
      font-size: 14px;
      font-weight: 500;
      color: var(--el-dark);
      letter-spacing: 0.02em;
      text-decoration: none;
      border-bottom: 1px solid #1C1B19;
      padding-bottom: 4px;
      transition: color 0.25s ease, border-color 0.25s ease;
    }

    #ellora-community-{{ section.id }} .el-community-cta-link:hover {
      color: var(--el-primary);
      border-bottom-color: var(--el-primary);
    }

    #ellora-community-{{ section.id }} .el-community-cta-link svg {
      transition: transform 0.25s ease;
    }

    #ellora-community-{{ section.id }} .el-community-cta-link:hover svg {
      transform: translate(2px, -2px);
    }

    /* -----------------------------------------------------------------------
       OPTIONAL INFINITE MARQUEE SHOWCASE
       ----------------------------------------------------------------------- */
    #ellora-community-{{ section.id }} .el-marquee-bar {
      width: 100%;
      overflow: hidden;
      white-space: nowrap;
      padding: 18px 0;
      border-top: 1px solid var(--el-border);
      border-bottom: 1px solid var(--el-border);
      background-color: #FAF9F6;
      display: flex;
      margin-top: 50px;
    }

    #ellora-community-{{ section.id }} .el-marquee-track {
      display: flex;
      gap: 40px;
      animation: elCommunityMarquee-{{ section.id }} {{ section.settings.marquee_speed | default: 28 }}s linear infinite;
      flex-shrink: 0;
    }

    #ellora-community-{{ section.id }} .el-marquee-item {
      font-family: var(--el-font-sans);
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--el-dark);
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 40px;
    }

    #ellora-community-{{ section.id }} .el-marquee-item span::after {
      content: '•';
      color: var(--el-primary);
      margin-left: 40px;
    }

    @keyframes elCommunityMarquee-{{ section.id }} {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }

    /* -----------------------------------------------------------------------
       RESPONSIVE BREAKPOINTS
       ----------------------------------------------------------------------- */
    @media (max-width: 1024px) {
      #ellora-community-{{ section.id }} .el-community-cards-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 18px !important;
      }
    }

    @media (max-width: 640px) {
      #ellora-community-{{ section.id }} .el-community-header h2 {
        font-size: 34px;
      }
      #ellora-community-{{ section.id }} .el-community-cards-grid {
        grid-template-columns: 1fr !important;
        gap: 16px !important;
      }
      #ellora-community-{{ section.id }} .el-community-card {
        aspect-ratio: 1 / 1.25;
      }
    }
  </style>

  <div class="el-sec-community-container">
    <!-- Header -->
    <div class="el-community-header">
      {%- if section.settings.kicker != blank -%}
        <span class="el-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p>{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- 4 UGC Photo Cards -->
    <div class="el-community-cards-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: section.settings.instagram_url | default: 'https://instagram.com' }}" target="_blank" rel="noopener noreferrer" class="el-community-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.handle }}
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.handle }}" loading="lazy">
          {%- else -%}
            <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_community_card_01_dining.jpg?v=1789453289" alt="{{ block.settings.handle }}" loading="lazy">
          {%- endif -%}
          
          <!-- White Floating Handle Badge -->
          {%- if block.settings.handle != blank -%}
            <span class="el-community-badge">
              {{ block.settings.handle }}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    <!-- Centered 'See all projects ↗' CTA -->
    {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
      <div class="el-community-action-wrap">
        <a href="{{ section.settings.cta_link | default: '/pages/about' }}" class="el-community-cta-link">
          <span>{{ section.settings.cta_text }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>

  <!-- Optional Infinite Marquee Ticker -->
  {%- if section.settings.show_marquee -%}
    <div class="el-marquee-bar" aria-hidden="true">
      <div class="el-marquee-track">
        <div class="el-marquee-item">
          <span>{{ section.settings.marquee_text | default: 'Architectural Stone' }}</span>
          <span>Living Wellness Surfaces</span>
          <span>Natural Quarry Curation</span>
          <span>Crafted For Enduring Homes</span>
          <span>Free Sample Service</span>
        </div>
      </div>
      <div class="el-marquee-track" aria-hidden="true">
        <div class="el-marquee-item">
          <span>{{ section.settings.marquee_text | default: 'Architectural Stone' }}</span>
          <span>Living Wellness Surfaces</span>
          <span>Natural Quarry Curation</span>
          <span>Crafted For Enduring Homes</span>
          <span>Free Sample Service</span>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ellora Community & UGC",
  "tag": "section",
  "class": "section-ellora-community",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "SHARED BY OUR COMMUNITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "#ElloraLiving"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#8E6356"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 52
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Tag @ElloraSpaces and use #ElloraLiving for a chance to be featured."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Default Instagram Profile Link"
    },
    {
      "type": "header",
      "content": "Bottom CTA Button ('See all projects ↗')"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Bottom CTA Link",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Link Text",
      "default": "See all projects"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link URL"
    },
    {
      "type": "header",
      "content": "Card & Badge Appearance"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Handle Badge Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Handle Badge Text Color",
      "default": "#2D2A28"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space Between Cards",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 70
    },
    {
      "type": "header",
      "content": "Optional Infinite Marquee Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Enable Bottom Marquee Ticker",
      "default": false
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Primary Marquee Phrase",
      "default": "Architectural Stone"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Marquee Speed (Lower is Faster)",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "ugc_card",
      "name": "Community Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "UGC Lifestyle Photo"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Photo CDN URL"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle / Attribution Label",
          "default": "@houseofmaaya"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram Post or Project Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellora Community & UGC",
      "blocks": [
        {
          "type": "ugc_card",
          "settings": {
            "handle": "@houseofmaaya",
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_community_card_01_dining.jpg?v=1789453289",
            "link": "https://www.instagram.com/houseofmaaya/"
          }
        },
        {
          "type": "ugc_card",
          "settings": {
            "handle": "@houseofmaaya",
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_community_card_02_mandir.jpg?v=1789453288",
            "link": "https://www.instagram.com/houseofmaaya/"
          }
        },
        {
          "type": "ugc_card",
          "settings": {
            "handle": "@houseofmaaya",
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_community_card_03_yoga_bamboo.jpg?v=1789453291",
            "link": "https://www.instagram.com/houseofmaaya/"
          }
        },
        {
          "type": "ugc_card",
          "settings": {
            "handle": "@houseofmaaya",
            "fallback_image": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec8_community_card_04_luxury_washroom.jpg?v=1789453288",
            "link": "https://www.instagram.com/houseofmaaya/"
          }
        }
      ]
    }
  ]
}
{% endschema %}

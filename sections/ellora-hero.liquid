{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 1: HERO & FLOATING UTILITIES
  File: sections/ellora-hero.liquid
  Fully customizable via Shopify Theme Customizer
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-hero-wrapper" id="ellora-hero-{{ section.id }}">
  {%- assign hero_accent = section.settings.accent_color -%}
  {%- if hero_accent == blank or hero_accent == '#8E6356' or hero_accent == '#8e6356' or hero_accent == '#754F43' or hero_accent == '#754f43' or hero_accent == '#BA9587' or hero_accent == '#ba9587' or hero_accent == '#734E43' or hero_accent == '#734e43' or hero_accent == '#A36854' or hero_accent == '#a36854' -%}
    {%- assign hero_accent = '#CC9E8F' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-hero-{{ section.id }} {
      --el-primary: {{ hero_accent }};
      --el-primary-hover: #BF8673;
      --el-dark: #1C1B19;
      --el-text: #2D2A28;
      --el-muted: #736E67;
      --el-border: #E8E3DC;
      --el-bg-main: #FAF9F6;
      --el-white: #FFFFFF;
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --el-radius-sm: 4px;
      --el-transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);

      width: 100%;
      position: relative;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-hero-{{ section.id }} *,
    #ellora-hero-{{ section.id }} *::before,
    #ellora-hero-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-hero-{{ section.id }} .el-hero {
      position: relative;
      width: 100%;
      height: {{ section.settings.desktop_height | default: '92vh' }};
      min-height: 640px;
      max-height: 980px;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      padding-bottom: 64px;
    }

    #ellora-hero-{{ section.id }} .el-hero-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      overflow: hidden;
    }

    #ellora-hero-{{ section.id }} .el-hero-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.image_alignment | default: 'center bottom' }};
      transition: transform 10s cubic-bezier(0.1, 1, 0.1, 1);
      display: block;
    }

    #ellora-hero-{{ section.id }} .el-hero:hover .el-hero-img {
      transform: scale(1.03);
    }

    #ellora-hero-{{ section.id }} .el-hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.0) 40%, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.15 }}) 100%);
      z-index: 2;
      pointer-events: none;
    }

    #ellora-hero-{{ section.id }} .el-hero-content {
      position: relative;
      z-index: 3;
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
      padding: 0;
    }

    #ellora-hero-{{ section.id }} .el-hero-box {
      background: #FFFFFF;
      max-width: 530px;
      padding: 44px 48px;
      border-radius: var(--el-radius-sm);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
      border: 1px solid rgba(232, 227, 220, 0.8);
    }

    #ellora-hero-{{ section.id }} .el-hero-title {
      font-family: var(--el-font-serif);
      font-size: 48px;
      line-height: 1.12;
      margin-bottom: 14px;
      color: var(--el-dark);
      font-weight: 400;
      letter-spacing: -0.01em;
    }

    #ellora-hero-{{ section.id }} .el-hero-desc {
      font-size: 15px;
      color: #58544E;
      line-height: 1.62;
      margin-bottom: 28px;
      font-weight: 400;
    }

    #ellora-hero-{{ section.id }} .el-hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    #ellora-hero-{{ section.id }} .el-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 30px;
      font-size: 13.5px;
      font-weight: 500;
      letter-spacing: 0.03em;
      border-radius: var(--el-radius-sm);
      transition: var(--el-transition);
      text-decoration: none;
      cursor: pointer;
    }

    #ellora-hero-{{ section.id }} .el-btn-primary {
      background-color: var(--el-primary, #CC9E8F) !important;
      color: #FFFFFF !important;
      border: 1px solid var(--el-primary, #CC9E8F) !important;
    }
    #ellora-hero-{{ section.id }} .el-btn-primary:hover {
      background-color: var(--el-primary-hover, #BF8673) !important;
      border-color: var(--el-primary-hover, #BF8673) !important;
      box-shadow: 0 6px 20px rgba(204, 158, 143, 0.28) !important;
    }

    #ellora-hero-{{ section.id }} .el-btn-outline {
      background-color: rgba(255, 255, 255, 0.9);
      color: var(--el-dark);
      border: 1px solid var(--el-border);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    #ellora-hero-{{ section.id }} .el-btn-outline:hover {
      background-color: var(--el-primary, #CC9E8F) !important;
      border-color: var(--el-primary, #CC9E8F) !important;
      color: #FFFFFF !important;
      box-shadow: 0 6px 20px rgba(204, 158, 143, 0.28) !important;
    }

    /* Scroll Indicator */
    #ellora-hero-{{ section.id }} .el-hero-scroll-indicator {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 4px;
      color: var(--el-primary);
      border: 1px solid rgba(232, 227, 220, 0.6);
      text-decoration: none;
      transition: transform 0.25s ease, background 0.25s ease;
    }
    #ellora-hero-{{ section.id }} .el-hero-scroll-indicator:hover {
      background: #FFFFFF;
      transform: translateX(-50%) translateY(3px);
    }
    #ellora-hero-{{ section.id }} .el-hero-scroll-indicator svg {
      width: 18px;
      height: 18px;
      stroke: var(--el-primary);
      stroke-width: 2;
    }

    /* Hero-scoped Side Sign Up Tab (only if hero signup is enabled) */
    #ellora-hero-{{ section.id }} .el-side-signup-tab {
      position: fixed;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      background: #FFFFFF;
      color: var(--el-primary, #CC9E8F);
      border: 1px solid var(--el-border, #E8E3DC);
      border-left: none;
      padding: 14px 10px;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      letter-spacing: 0.16em;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      cursor: pointer;
      z-index: 998;
      border-radius: 0 8px 8px 0;
      box-shadow: 2px 4px 18px rgba(0,0,0,0.08);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
    }
    #ellora-hero-{{ section.id }} .el-side-signup-tab:hover {
      background: var(--el-primary, #CC9E8F);
      color: #FFFFFF !important;
      box-shadow: 4px 6px 22px rgba(204, 158, 143, 0.32);
    }
    #ellora-hero-{{ section.id }} .el-side-signup-tab svg {
      width: 14px;
      height: 14px;
      transform: rotate(90deg);
    }

    /* Side Sign Up Modal Overlay */
    .el-signup-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(28, 27, 25, 0.52);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 999998;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .el-signup-modal-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }
    .el-signup-modal {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.95);
      background: #FFFFFF;
      max-width: 460px;
      width: 90%;
      border-radius: 12px;
      padding: 38px 32px 32px;
      box-shadow: 0 24px 60px rgba(0,0,0,0.22);
      z-index: 999999;
      opacity: 0;
      visibility: hidden;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.3s ease;
      font-family: var(--el-font-sans, -apple-system, sans-serif);
      text-align: center;
      box-sizing: border-box;
    }
    .el-signup-modal.is-open {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
      visibility: visible;
    }
    .el-signup-modal-close {
      position: absolute;
      top: 14px;
      right: 14px;
      background: transparent;
      border: none;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      color: #736E67;
      padding: 6px;
      transition: color 0.2s;
    }
    .el-signup-modal-close:hover {
      color: #1C1B19;
    }
    .el-signup-modal-kicker {
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-primary, #CC9E8F);
      margin-bottom: 8px;
    }
    .el-signup-modal-title {
      font-family: var(--el-font-serif, serif);
      font-size: 28px;
      font-weight: 400;
      color: #1C1B19;
      margin-bottom: 10px;
      line-height: 1.2;
    }
    .el-signup-modal-sub {
      font-size: 13.5px;
      line-height: 1.55;
      color: #5C554E;
      margin-bottom: 24px;
    }
    .el-signup-form-row {
      display: flex;
      gap: 10px;
    }
    .el-signup-input {
      flex: 1;
      padding: 12px 14px;
      border: 1px solid #E8E3DC;
      border-radius: 4px;
      font-size: 14px;
      font-family: inherit;
    }
    .el-signup-input:focus {
      outline: none;
      border-color: var(--el-primary, #CC9E8F);
    }
    .el-signup-submit-btn {
      padding: 12px 20px;
      background: var(--el-primary, #CC9E8F);
      color: #FFFFFF;
      border: none;
      border-radius: 4px;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: background 0.2s ease;
      white-space: nowrap;
    }
    .el-signup-submit-btn:hover {
      background: var(--el-primary-hover, #BF8673);
    }

    /* WhatsApp Float */
    .el-whatsapp-float {
      position: fixed;
      bottom: 32px;
      right: 32px;
      width: 56px;
      height: 56px;
      background-color: #25D366;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 26px rgba(37, 211, 102, 0.38);
      z-index: 999;
      color: #FFF !important;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .el-whatsapp-float:hover {
      transform: scale(1.08);
      box-shadow: 0 14px 30px rgba(37, 211, 102, 0.48);
    }
    .el-whatsapp-float svg {
      width: 30px;
      height: 30px;
      fill: currentColor;
    }

    @media (max-width: 900px) {
      #ellora-hero-{{ section.id }} .el-hero {
        height: 80vh;
        min-height: 620px;
        padding-bottom: 40px;
      }
      #ellora-hero-{{ section.id }} .el-hero-box {
        max-width: 480px;
        padding: 36px 32px;
      }
    }

    @media (max-width: 640px) {
      #ellora-hero-{{ section.id }} .el-hero {
        min-height: 560px;
        height: auto;
        padding-top: 140px;
        padding-bottom: 30px;
      }
      #ellora-hero-{{ section.id }} .el-hero-box {
        padding: 30px 24px;
        max-width: 100%;
      }
      #ellora-hero-{{ section.id }} .el-hero-title {
        font-size: 34px;
      }
      #ellora-hero-{{ section.id }} .el-hero-scroll-indicator {
        display: none;
      }
    }
  </style>

  <section class="el-hero">
    <div class="el-hero-bg">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'el-hero-img', loading: 'eager', alt: section.settings.heading }}
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec1_hero_bg.jpg?v=1789453290" alt="{{ section.settings.heading }}" class="el-hero-img" loading="eager">
      {%- endif -%}
    </div>
    <div class="el-hero-overlay"></div>

    {%- if section.settings.show_scroll_indicator -%}
      <a href="{{ section.settings.scroll_target | default: '#about' }}" class="el-hero-scroll-indicator" aria-label="Scroll to content">
        <svg viewBox="0 0 24 24" fill="none">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
    {%- endif -%}

    <div class="el-hero-content">
      <div class="el-hero-box">
        <h1 class="el-hero-title">{{ section.settings.heading }}</h1>
        <p class="el-hero-desc">
          {{ section.settings.subheading }}
        </p>
        <div class="el-hero-buttons">
          {%- if section.settings.btn1_label != blank -%}
            <a href="{{ section.settings.btn1_link | default: '/collections/all' }}" class="el-btn el-btn-primary">
              {{ section.settings.btn1_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a href="{{ section.settings.btn2_link | default: '#about' }}" class="el-btn el-btn-outline">
              {{ section.settings.btn2_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>



  {%- if section.settings.show_side_signup -%}
    <!-- Floating Side Sign Up Tab Button -->
    <button type="button" class="el-side-signup-tab" id="elSideSignupBtn-{{ section.id }}" aria-label="Sign Up for Updates">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      <span>{{ section.settings.side_signup_text | default: 'SIGN UP' }}</span>
    </button>

    <!-- Side Sign Up Pop Over Modal -->
    <div class="el-signup-modal-backdrop" id="elSignupBackdrop-{{ section.id }}"></div>
    <div class="el-signup-modal" id="elSignupModal-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="elSignupTitle-{{ section.id }}">
      <button type="button" class="el-signup-modal-close" id="elSignupClose-{{ section.id }}" aria-label="Close modal">&times;</button>
      <div class="el-signup-modal-kicker">STAY CONNECTED</div>
      <h3 class="el-signup-modal-title" id="elSignupTitle-{{ section.id }}">Join the Ellora Circle</h3>
      <p class="el-signup-modal-sub">Receive curated architectural stories, private collection previews, and material guidance.</p>
      
      {% form 'customer', class: 'el-signup-modal-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, side-signup">
        <div class="el-signup-form-row">
          <input 
            type="email" 
            name="contact[email]" 
            class="el-signup-input" 
            placeholder="Enter your email address" 
            required 
            aria-label="Email address">
          <button type="submit" class="el-signup-submit-btn">Subscribe</button>
        </div>
      {% endform %}
    </div>

    <script>
      (function() {
        var sid = "{{ section.id }}";
        var triggerBtn = document.getElementById('elSideSignupBtn-' + sid);
        var modal = document.getElementById('elSignupModal-' + sid);
        var backdrop = document.getElementById('elSignupBackdrop-' + sid);
        var closeBtn = document.getElementById('elSignupClose-' + sid);

        function openModal() {
          if (modal) modal.classList.add('is-open');
          if (backdrop) backdrop.classList.add('is-open');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          if (modal) modal.classList.remove('is-open');
          if (backdrop) backdrop.classList.remove('is-open');
          document.body.style.overflow = '';
        }

        if (triggerBtn) triggerBtn.addEventListener('click', openModal);
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (backdrop) backdrop.addEventListener('click', closeModal);
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
            closeModal();
          }
        });
      })();
    </script>
  {%- endif -%}

  {%- if section.settings.show_whatsapp and section.settings.whatsapp_number != blank -%}
    <!-- Floating WhatsApp -->
    <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener noreferrer" class="el-whatsapp-float" aria-label="Personal Help on WhatsApp">
      <svg viewBox="0 0 24 24">
        <path d="M20.52 3.48A11.9 11.9 0 0012.06 0C5.45 0 .09 5.36.09 11.97c0 2.11.55 4.17 1.6 6L0 24l6.23-1.63a11.9 11.9 0 005.83 1.51h.01c6.61 0 11.97-5.36 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.07 21.88a9.92 9.92 0 01-5.06-1.39l-.36-.21-3.76.99 1-3.66-.23-.38a9.91 9.91 0 01-1.52-5.26c0-5.48 4.46-9.94 9.95-9.94 2.66 0 5.15 1.04 7.03 2.92 1.88 1.88 2.92 4.38 2.92 7.03 0 5.49-4.47 9.94-9.95 9.94zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52-.18-.01-.38-.01-.58-.01s-.53.08-.81.38c-.28.3-1.07 1.05-1.07 2.56s1.1 2.97 1.25 3.17c.15.2 2.16 3.3 5.24 4.63.73.32 1.3.51 1.75.65.74.24 1.41.2 1.94.13.59-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.07-.12-.27-.2-.57-.35z"></path>
      </svg>
    </a>
  {%- endif -%}


</div>

{% schema %}
{
  "name": "Ellora Hero Banner",
  "tag": "section",
  "class": "section-ellora-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image Position",
      "options": [
        { "value": "center top", "label": "Top Center" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom Center" }
      ],
      "default": "center bottom"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Bottom Shadow Overlay Opacity",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Explore by Space"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description Paragraph",
      "default": "Stone, porcelain and ceramic surfaces designed for wellness-oriented interiors and contemporary living."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Utilities & Floats"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show Scroll Indicator Arrow",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_target",
      "label": "Scroll Target Anchor (e.g. #about)"
    },

    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show Floating WhatsApp Button",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Phone Number (with Country Code)",
      "default": "+441234567890"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp Pre-filled Message",
      "default": "Hello Ellora Spaces, I would like to inquire about your tiles."
    },
    {
      "type": "color",

{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 1: HERO & FLOATING UTILITIES
  File: sections/ellora-hero.liquid
  Fully customizable via Shopify Theme Customizer
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-hero-wrapper" id="ellora-hero-{{ section.id }}">
  {%- assign hero_accent = section.settings.accent_color -%}
  {%- if hero_accent == blank or hero_accent == '#8E6356' or hero_accent == '#8e6356' or hero_accent == '#754F43' or hero_accent == '#754f43' or hero_accent == '#BA9587' or hero_accent == '#ba9587' or hero_accent == '#734E43' or hero_accent == '#734e43' or hero_accent == '#A36854' or hero_accent == '#a36854' -%}
    {%- assign hero_accent = '#CC9E8F' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-hero-{{ section.id }} {
      --el-primary: {{ hero_accent }};
      --el-primary-hover: #BF8673;
      --el-dark: #1C1B19;
      --el-text: #2D2A28;
      --el-muted: #736E67;
      --el-border: #E8E3DC;
      --el-bg-main: #FAF9F6;
      --el-white: #FFFFFF;
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --el-radius-sm: 4px;
      --el-transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);

      width: 100%;
      position: relative;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-hero-{{ section.id }} *,
    #ellora-hero-{{ section.id }} *::before,
    #ellora-hero-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-hero-{{ section.id }} .el-hero {
      position: relative;
      width: 100%;
      height: {{ section.settings.desktop_height | default: '92vh' }};
      min-height: 640px;
      max-height: 980px;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: {% if section.settings.show_scroll_indicator %}84px{% else %}52px{% endif %};
    }

    #ellora-hero-{{ section.id }} .el-hero-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      overflow: hidden;
    }

    #ellora-hero-{{ section.id }} .el-hero-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.image_alignment | default: 'center bottom' }};
      transition: transform 10s cubic-bezier(0.1, 1, 0.1, 1);
      display: block;
    }

    #ellora-hero-{{ section.id }} .el-hero:hover .el-hero-img {
      transform: scale(1.03);
    }

    #ellora-hero-{{ section.id }} .el-hero-video {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      height: 100%;
      min-width: 100%;
      min-height: 100%;
      object-fit: cover;
      pointer-events: none;
      z-index: 1;
    }

    #ellora-hero-{{ section.id }} iframe.el-hero-video {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(1.1);
      width: 177.78vh;
      height: 100vh;
      min-width: 100%;
      min-height: 100%;
      border: 0;
      pointer-events: none;
      z-index: 1;
    }

    @media (min-aspect-ratio: 16/9) {
      #ellora-hero-{{ section.id }} iframe.el-hero-video {
        width: 100vw;
        height: 56.25vw;
        transform: translate(-50%, -50%) scale(1.1);
      }
    }

    #ellora-hero-{{ section.id }} video::-webkit-media-controls,
    #ellora-hero-{{ section.id }} video::-webkit-media-controls-enclosure,
    #ellora-hero-{{ section.id }} video::-webkit-media-controls-panel {
      display: none !important;
      -webkit-appearance: none;
    }

    #ellora-hero-{{ section.id }} .el-hero-shield {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 5;
      background: rgba(0, 0, 0, 0.0001);
      pointer-events: auto;
    }

    #ellora-hero-{{ section.id }} .el-hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.0) 40%, rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.15 }}) 100%);
      z-index: 3;
      pointer-events: none;
    }

    #ellora-hero-{{ section.id }} .el-hero-content {
      position: relative;
      z-index: 10;
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      pointer-events: auto;
    }

    #ellora-hero-{{ section.id }} .el-hero-buttons {
      display: inline-flex;
      gap: 18px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }

    #ellora-hero-{{ section.id }} .el-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 16px 36px;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.04em;
      border-radius: var(--el-radius-sm);
      transition: var(--el-transition);
      text-decoration: none;
      cursor: pointer;
    }

    #ellora-hero-{{ section.id }} .el-btn-primary {
      background-color: var(--el-primary, #CC9E8F) !important;
      color: #FFFFFF !important;
      border: 1px solid var(--el-primary, #CC9E8F) !important;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
    }
    #ellora-hero-{{ section.id }} .el-btn-primary:hover {
      background-color: var(--el-primary-hover, #BF8673) !important;
      border-color: var(--el-primary-hover, #BF8673) !important;
      box-shadow: 0 8px 24px rgba(204, 158, 143, 0.35) !important;
      transform: translateY(-1px);
    }

    #ellora-hero-{{ section.id }} .el-btn-outline {
      background-color: rgba(255, 255, 255, 0.95);
      color: var(--el-dark, #1C1B19);
      border: 1px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    #ellora-hero-{{ section.id }} .el-btn-outline:hover {
      background-color: var(--el-primary-hover, #BF8673) !important;
      border-color: var(--el-primary-hover, #BF8673) !important;
      color: #FFFFFF !important;
      box-shadow: 0 8px 24px rgba(191, 134, 115, 0.35) !important;
      transform: translateY(-1px);
    }

    /* Scroll Indicator */
    #ellora-hero-{{ section.id }} .el-hero-scroll-indicator {
      position: absolute;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 4px;
      color: var(--el-primary);
      border: 1px solid rgba(232, 227, 220, 0.6);
      text-decoration: none;
      transition: transform 0.25s ease, background 0.25s ease;
    }
    #ellora-hero-{{ section.id }} .el-hero-scroll-indicator:hover {
      background: #FFFFFF;
      transform: translateX(-50%) translateY(3px);
    }
    #ellora-hero-{{ section.id }} .el-hero-scroll-indicator svg {
      width: 18px;
      height: 18px;
      stroke: var(--el-primary);
      stroke-width: 2;
    }

    /* Global side sign up drawer managed by site header */

    /* WhatsApp Float */
    .el-whatsapp-float {
      position: fixed;
      bottom: 32px;
      right: 32px;
      width: 56px;
      height: 56px;
      background-color: #25D366;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 26px rgba(37, 211, 102, 0.38);
      z-index: 999;
      color: #FFF !important;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .el-whatsapp-float:hover {
      transform: scale(1.08);
      box-shadow: 0 14px 30px rgba(37, 211, 102, 0.48);
    }
    .el-whatsapp-float svg {
      width: 30px;
      height: 30px;
      fill: currentColor;
    }

    @media (max-width: 768px) {
      .el-whatsapp-float {
        bottom: 20px;
        right: 16px;
        width: 48px;
        height: 48px;
      }
      .el-whatsapp-float svg {
        width: 24px;
        height: 24px;
      }
    }

    @media (max-width: 900px) {
      #ellora-hero-{{ section.id }} .el-hero {
        min-height: 520px;
        padding-bottom: 48px;
      }
    }

    @media (max-width: 640px) {
      #ellora-hero-{{ section.id }} .el-hero {
        min-height: 480px;
        padding-bottom: 36px;
      }
      #ellora-hero-{{ section.id }} .el-hero-buttons {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
      }
      #ellora-hero-{{ section.id }} .el-btn {
        width: 100%;
        text-align: center;
        padding: 14px 24px;
      }
      #ellora-hero-{{ section.id }} .el-hero-scroll-indicator {
        display: none;
      }
    }
  </style>

  <section class="el-hero">
    <div class="el-hero-bg">
      {%- if section.settings.background_type == 'video' -%}
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'el-hero-video' }}
        {%- elsif section.settings.video_url != blank and section.settings.video_url.type == 'youtube' -%}
          <iframe
            id="el-hero-yt-{{ section.id }}"
            class="el-hero-video"
            src="https://www.youtube-nocookie.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&controls=0&playsinline=1&rel=0&showinfo=0&modestbranding=1&enablejsapi=1&disablekb=1&fs=0&iv_load_policy=3&origin=https://{{ request.host | default: shop.domain }}"
            frameborder="0"
            allow="autoplay; encrypted-media"
            tabindex="-1"
            aria-hidden="true"
            title="Hero Background Video"
          ></iframe>
        {%- elsif section.settings.video_url != blank and section.settings.video_url.type == 'vimeo' -%}
          <iframe
            class="el-hero-video"
            src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&autopause=0&background=1&responsive=1"
            frameborder="0"
            allow="autoplay; encrypted-media"
            tabindex="-1"
            aria-hidden="true"
            title="Hero Background Video"
          ></iframe>
        {%- elsif section.settings.video_external_url != blank -%}
          {%- assign ext_url = section.settings.video_external_url | strip -%}
          {%- if ext_url contains 'youtube.com' or ext_url contains 'youtu.be' -%}
            {%- assign raw_yt_id = '' -%}
            {%- if ext_url contains 'youtu.be/' -%}
              {%- assign raw_yt_id = ext_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first -%}
            {%- elsif ext_url contains 'watch?v=' -%}
              {%- assign raw_yt_id = ext_url | split: 'watch?v=' | last | split: '&' | first -%}
            {%- elsif ext_url contains 'embed/' -%}
              {%- assign raw_yt_id = ext_url | split: 'embed/' | last | split: '?' | first | split: '&' | first -%}
            {%- elsif ext_url contains 'shorts/' -%}
              {%- assign raw_yt_id = ext_url | split: 'shorts/' | last | split: '?' | first | split: '&' | first -%}
            {%- endif -%}
            {%- if raw_yt_id != blank -%}
              <iframe
                id="el-hero-yt-{{ section.id }}"
                class="el-hero-video"
                src="https://www.youtube-nocookie.com/embed/{{ raw_yt_id }}?autoplay=1&mute=1&controls=0&playsinline=1&rel=0&showinfo=0&modestbranding=1&enablejsapi=1&disablekb=1&fs=0&iv_load_policy=3&origin=https://{{ request.host | default: shop.domain }}"
                frameborder="0"
                allow="autoplay; encrypted-media"
                tabindex="-1"
                aria-hidden="true"
                title="Hero Background Video"
              ></iframe>
            {%- endif -%}
          {%- elsif ext_url contains 'vimeo.com' -%}
            {%- assign raw_vimeo_id = ext_url | split: 'vimeo.com/' | last | split: '?' | first -%}
            <iframe
              class="el-hero-video"
              src="https://player.vimeo.com/video/{{ raw_vimeo_id }}?autoplay=1&muted=1&loop=1&autopause=0&background=1&responsive=1"
              frameborder="0"
              allow="autoplay; encrypted-media"
              tabindex="-1"
              aria-hidden="true"
              title="Hero Background Video"
            ></iframe>
          {%- else -%}
            <video class="el-hero-video" autoplay muted loop playsinline preload="auto" disablePictureInPicture controlsList="nodownload nofullscreen noremoteplayback">
              <source src="{{ ext_url }}" type="video/mp4">
            </video>
          {%- endif -%}
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'el-hero-img', loading: 'eager', alt: shop.name }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec1_hero_bg.jpg?v=1789453290" alt="{{ shop.name }}" class="el-hero-img" loading="eager">
        {%- endif -%}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'el-hero-img', loading: 'eager', alt: shop.name }}
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/0990/3685/6647/files/sec1_hero_bg.jpg?v=1789453290" alt="{{ shop.name }}" class="el-hero-img" loading="eager">
      {%- endif -%}
      <div class="el-hero-shield" aria-hidden="true"></div>
    </div>
    <div class="el-hero-overlay"></div>

    {%- if section.settings.show_scroll_indicator -%}
      <a href="{{ section.settings.scroll_target | default: '#about' }}" class="el-hero-scroll-indicator" aria-label="Scroll to content">
        <svg viewBox="0 0 24 24" fill="none">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
    {%- endif -%}

    <div class="el-hero-content">
      <div class="el-hero-buttons">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link | default: '/collections/all' }}" class="el-btn el-btn-primary">
            {{ section.settings.btn1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link | default: '#about' }}" class="el-btn el-btn-outline">
            {{ section.settings.btn2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.background_type == 'video' -%}
    <script>
      (function() {
        var ytIframe = document.getElementById('el-hero-yt-{{ section.id }}');
        if (!ytIframe) return;

        // Loop via window message handler
        window.addEventListener('message', function(event) {
          try {
            var msg = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
            if (msg) {
              var isEnded = (msg.event === 'onStateChange' && msg.info === 0) || 
                            (msg.info && msg.info.playerState === 0) || 
                            (msg.info === 0);
              if (isEnded && ytIframe.contentWindow) {
                ytIframe.contentWindow.postMessage(JSON.stringify({
                  event: 'command',
                  func: 'seekTo',
                  args: [0, true]
                }), '*');
                ytIframe.contentWindow.postMessage(JSON.stringify({
                  event: 'command',
                  func: 'playVideo',
                  args: []
                }), '*');
              }
            }
          } catch(e) {}
        });

        // Loop via YouTube IFrame API fallback
        function initYTLoop() {
          if (window.YT && window.YT.Player) {
            new window.YT.Player('el-hero-yt-{{ section.id }}', {
              events: {
                'onStateChange': function(e) {
                  if (e.data === 0) { // ENDED
                    e.target.seekTo(0);
                    e.target.playVideo();
                  }
                }
              }
            });
          }
        }

        if (window.YT && window.YT.Player) {
          initYTLoop();
        } else {
          var prevReady = window.onYouTubeIframeAPIReady;
          window.onYouTubeIframeAPIReady = function() {
            if (typeof prevReady === 'function') prevReady();
            initYTLoop();
          };
          if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
            var tag = document.createElement('script');
            tag.src = "https://www.youtube.com/iframe_api";
            var first = document.getElementsByTagName('script')[0];
            first.parentNode.insertBefore(tag, first);
          }
        }
      })();
    </script>
  {%- endif -%}



  

  {%- if section.settings.show_whatsapp and section.settings.whatsapp_number != blank -%}
    <!-- Floating WhatsApp -->
    <a href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener noreferrer" class="el-whatsapp-float" aria-label="Personal Help on WhatsApp">
      <svg viewBox="0 0 24 24">
        <path d="M20.52 3.48A11.9 11.9 0 0012.06 0C5.45 0 .09 5.36.09 11.97c0 2.11.55 4.17 1.6 6L0 24l6.23-1.63a11.9 11.9 0 005.83 1.51h.01c6.61 0 11.97-5.36 11.97-11.97 0-3.2-1.25-6.21-3.52-8.43zM12.07 21.88a9.92 9.92 0 01-5.06-1.39l-.36-.21-3.76.99 1-3.66-.23-.38a9.91 9.91 0 01-1.52-5.26c0-5.48 4.46-9.94 9.95-9.94 2.66 0 5.15 1.04 7.03 2.92 1.88 1.88 2.92 4.38 2.92 7.03 0 5.49-4.47 9.94-9.95 9.94zm5.45-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.24-.59-.49-.51-.68-.52-.18-.01-.38-.01-.58-.01s-.53.08-.81.38c-.28.3-1.07 1.05-1.07 2.56s1.1 2.97 1.25 3.17c.15.2 2.16 3.3 5.24 4.63.73.32 1.3.51 1.75.65.74.24 1.41.2 1.94.13.59-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.07-.12-.27-.2-.57-.35z"></path>
      </svg>
    </a>
  {%- endif -%}


</div>

{% schema %}
{
  "name": "Ellora Hero Banner",
  "tag": "section",
  "class": "section-ellora-hero",
  "settings": [
    {
      "type": "header",
      "content": "Hero Background Media"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Media Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image",
      "info": "Choose whether to display background image or video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "YouTube or Vimeo Video Link",
      "info": "Paste a YouTube or Vimeo link for the background video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Hosted Video File",
      "info": "Upload or pick a video file from Shopify files"
    },
    {
      "type": "text",
      "id": "video_external_url",
      "label": "Direct MP4 Video Link (Optional)",
      "info": "Or paste a direct .mp4 video file URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Image",
      "info": "Used as background or poster fallback"
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Media Alignment Position",
      "options": [
        { "value": "center top", "label": "Top Center" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom Center" }
      ],
      "default": "center bottom"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Bottom Shadow Overlay Opacity",
      "default": 15
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Explore by Space"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description Paragraph",
      "default": "Stone, porcelain and ceramic surfaces designed for wellness-oriented interiors and contemporary living."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Scroll Indicator Arrow"
    },
    {

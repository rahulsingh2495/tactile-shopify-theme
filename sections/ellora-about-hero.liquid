{% comment %}
  ==========================================================================
  ELLORA SPACES — ABOUT PAGE SECTION 1: ABOUT HERO & FOUNDERS' STORY
  File: sections/ellora-about-hero.liquid
  Fully customizable via Shopify Theme Customizer
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-about-hero-wrapper" id="ellora-about-hero-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-about-hero-{{ section.id }} {
      --el-bg: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: {{ section.settings.title_color | default: '#805D52' }};
      --el-text: {{ section.settings.text_color | default: '#4A453F' }};
      --el-accent: {{ section.settings.accent_color | default: '#B86B53' }};
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      background-color: var(--el-bg);
      padding-top: {{ section.settings.padding_top_desktop | default: 60 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 40 }}px;
      width: 100%;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-about-hero-{{ section.id }} *,
    #ellora-about-hero-{{ section.id }} *::before,
    #ellora-about-hero-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1720 }}px;
      margin: 0 auto;
    }

    /* Top Split Header: Title Left, Narrative Paragraph Right */
    #ellora-about-hero-{{ section.id }} .el-about-hero-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 48px;
      margin-bottom: {{ section.settings.gap_below_header | default: 36 }}px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-title-col {
      flex: 1 1 50%;
      max-width: 680px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-eyebrow {
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #1C1B19;
      font-weight: 600;
      margin-bottom: 14px;
      display: block;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-title {
      font-family: var(--el-font-serif);
      font-size: {{ section.settings.title_font_size | default: 48 }}px;
      line-height: 1.12;
      font-weight: 400;
      color: #805D52 !important;
      letter-spacing: -0.015em;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-desc-col {
      flex: 1 1 45%;
      max-width: 560px;
      padding-top: 8px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-desc {
      font-family: var(--el-font-sans);
      font-size: clamp(14px, 1.15vw, {{ section.settings.desc_font_size | default: 15 }}px);
      line-height: 1.68;
      color: var(--el-text);
      font-weight: 400;
    }

    /* Main Hero Banner Image */
    #ellora-about-hero-{{ section.id }} .el-about-hero-image-wrap {
      width: 100%;
      position: relative;
      overflow: hidden;
      border-radius: {{ section.settings.image_radius | default: 2 }}px;
      background-color: #EBE6DF;
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-img {
      width: 100%;
      height: {{ section.settings.image_height_desktop | default: 580 }}px;
      object-fit: cover;
      object-position: {{ section.settings.image_position | default: 'center' }};
      display: block;
      transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    #ellora-about-hero-{{ section.id }} .el-about-hero-image-wrap:hover .el-about-hero-img {
      transform: scale(1.015);
    }

    /* Founder Story Editorial Block */
    #ellora-about-hero-{{ section.id }} .el-about-story-block {
      margin-top: {{ section.settings.story_margin_top | default: 64 }}px;
      padding-top: {{ section.settings.story_padding_top | default: 56 }}px;
      border-top: 1px solid #E6E1D9;
      width: 100%;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-kicker-row {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 36px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-eyebrow {
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #1C1B19;
      font-weight: 600;
      white-space: nowrap;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-line {
      flex: 1;
      height: 1px;
      background-color: #E6E1D9;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-grid {
      display: grid;
      grid-template-columns: 1fr 1.35fr;
      gap: 64px;
      align-items: flex-start;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-lead {
      font-family: var(--el-font-serif);
      font-size: clamp(26px, 2.6vw, 36px);
      font-weight: 400;
      line-height: 1.25;
      color: #805D52;
      letter-spacing: -0.01em;
      position: sticky;
      top: 100px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-text-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-p {
      font-family: var(--el-font-sans);
      font-size: clamp(14px, 1.05vw, 15px);
      line-height: 1.72;
      color: var(--el-text);
      font-weight: 400;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-signoff {
      margin-top: 16px;
      padding-top: 24px;
      border-top: 1px solid #ECE7DE;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-names {
      font-family: var(--el-font-serif);
      font-size: 26px;
      font-style: italic;
      color: var(--el-dark);
      letter-spacing: 0.02em;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-role {
      font-family: var(--el-font-sans);
      font-size: 11.5px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--el-accent);
      font-weight: 600;
    }

    /* Triplet / Closing Cadence Box */
    #ellora-about-hero-{{ section.id }} .el-about-story-closing {
      margin-top: 28px;
      padding: 24px 28px;
      background-color: rgba(184, 107, 83, 0.05);
      border-left: 2px solid var(--el-accent);
      border-radius: 0 4px 4px 0;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-closing-title {
      font-family: var(--el-font-serif);
      font-size: clamp(20px, 1.8vw, 24px);
      line-height: 1.35;
      color: #805D52;
      font-style: italic;
      margin-bottom: 14px;
    }

    #ellora-about-hero-{{ section.id }} .el-about-story-triplet {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      font-family: var(--el-font-sans);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--el-accent);
    }

    #ellora-about-hero-{{ section.id }} .el-about-triplet-dot {
      color: #DDD5C9;
    }

    /* Responsive Breakpoints */
    @media (max-width: 1024px) {
      #ellora-about-hero-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 28 }}px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-hero-header {
        flex-direction: column;
        gap: 20px;
        margin-bottom: 28px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-hero-title-col,
      #ellora-about-hero-{{ section.id }} .el-about-hero-desc-col {
        max-width: 100%;
        padding-top: 0;
      }

      #ellora-about-hero-{{ section.id }} .el-about-hero-img {
        height: {{ section.settings.image_height_mobile | default: 340 }}px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-story-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-story-lead {
        position: static;
        font-size: 24px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-story-block {
        margin-top: 44px;
        padding-top: 36px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-story-closing {
        padding: 20px 22px;
        margin-top: 22px;
      }
    }

    @media (max-width: 640px) {
      #ellora-about-hero-{{ section.id }} .el-about-hero-container {
        width: 92%;
      }

      #ellora-about-hero-{{ section.id }} .el-about-hero-title {
        font-size: 32px;
        line-height: 1.18;
      }

      #ellora-about-hero-{{ section.id }} .el-about-hero-desc {
        font-size: 14px;
        line-height: 1.6;
      }

      #ellora-about-hero-{{ section.id }} .el-about-hero-img {
        height: 260px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-story-closing {
        padding: 16px 18px;
        margin-top: 18px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-story-triplet {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }

      #ellora-about-hero-{{ section.id }} .el-about-triplet-dot {
        display: none;
      }
    }
  </style>

  <div class="el-about-hero-container">
    <div class="el-about-hero-header">
      <div class="el-about-hero-title-col">
        {%- if section.settings.eyebrow != blank -%}
          <span class="el-about-hero-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="el-about-hero-title">{{ section.settings.title | default: "There are places that invite us to slow down." }}</h1>
      </div>
      <div class="el-about-hero-desc-col">
        <div class="el-about-hero-desc">
          {{ section.settings.description | default: "Places that soften the noise around us, hold a little more light and create a sense of ease.<br><br>In a world that often feels fast and demanding, we have come to value these spaces more deeply — places where we can pause, reconnect and feel more at home within ourselves." }}
        </div>
      </div>
    </div>

    <div class="el-about-hero-image-wrap">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
          {%- endif -%}
          {{ section.settings.image | image_url: width: 2200 | image_tag: 
            class: 'el-about-hero-img',
            loading: 'eager',
            alt: section.settings.image.alt | default: section.settings.title | escape
          }}
        </picture>
      {%- else -%}
        <img 
          src="{{ 'sec1_hero_bg.jpg' | asset_url }}" 
          alt="{{ section.settings.title | default: 'There are places that invite us to slow down' | escape }}" 
          class="el-about-hero-img"
          loading="eager"
          onerror="this.src='https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80'"
        >
      {%- endif -%}
    </div>

    {%- if section.settings.show_story -%}
      <div class="el-about-story-block">
        <div class="el-about-story-kicker-row">
          <span class="el-about-story-eyebrow">{{ section.settings.story_eyebrow | default: "OUR PHILOSOPHY & CRAFT" }}</span>
          <div class="el-about-story-line"></div>
        </div>

        <div class="el-about-story-grid">
          <div class="el-about-story-lead-col">
            <h2 class="el-about-story-lead">
              {{ section.settings.story_lead | default: "At Ellora, this idea sits quietly at the heart of what we do: our surroundings influence how we feel, and the materials we choose are essential to creating spaces that support calm, balance and wellbeing." }}
            </h2>
          </div>

          <div class="el-about-story-text-col">
            {%- if section.settings.story_p1 != blank -%}
              <p class="el-about-story-p">{{ section.settings.story_p1 }}</p>
            {%- endif -%}
            {%- if section.settings.story_p2 != blank -%}
              <p class="el-about-story-p">{{ section.settings.story_p2 }}</p>
            {%- endif -%}
            {%- if section.settings.story_p3 != blank -%}
              <p class="el-about-story-p">{{ section.settings.story_p3 }}</p>
            {%- endif -%}
            {%- if section.settings.story_p4 != blank -%}
              <p class="el-about-story-p">{{ section.settings.story_p4 }}</p>
            {%- endif -%}

            {%- if section.settings.story_closing_title != blank or section.settings.triplet_1 != blank -%}
              <div class="el-about-story-closing">
                {%- if section.settings.story_closing_title != blank -%}
                  <p class="el-about-story-closing-title">{{ section.settings.story_closing_title }}</p>
                {%- endif -%}
                <div class="el-about-story-triplet">
                  {%- if section.settings.triplet_1 != blank -%}
                    <span class="el-about-triplet-item">{{ section.settings.triplet_1 }}</span>
                  {%- endif -%}
                  {%- if section.settings.triplet_2 != blank -%}
                    <span class="el-about-triplet-dot">•</span>
                    <span class="el-about-triplet-item">{{ section.settings.triplet_2 }}</span>
                  {%- endif -%}
                  {%- if section.settings.triplet_3 != blank -%}
                    <span class="el-about-triplet-dot">•</span>
                    <span class="el-about-triplet-item">{{ section.settings.triplet_3 }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.story_names != blank -%}
              <div class="el-about-story-signoff">
                <span class="el-about-story-names">{{ section.settings.story_names }}</span>
                {%- if section.settings.story_role != blank -%}
                  <span class="el-about-story-role">{{ section.settings.story_role }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About 01 - Hero & Intro",
  "tag": "section",
  "class": "section-ellora-about-hero",
  "settings": [
    {
      "type": "header",
      "content": "Header Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Subheading",
      "default": "ELLORA"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Headline",
      "default": "There are places that invite us to slow down."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Paragraph Description",
      "default": "Places that soften the noise around us, hold a little more light and create a sense of ease.<br><br>In a world that often feels fast and demanding, we have come to value these spaces more deeply — places where we can pause, reconnect and feel more at home within ourselves."
    },
    {
      "type": "header",
      "content": "Hero Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Hero Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Hero Image (Optional)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Focal Point",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "image_height_desktop",
      "label": "Desktop Image Height (px)",
      "min": 360,
      "max": 800,
      "step": 20,
      "default": 580
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Mobile Image Height (px)",
      "min": 200,
      "max": 500,
      "step": 20,
      "default": 340
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Corner Radius (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 2
    },
    {
      "type": "header",
      "content": "Philosophy & Craft Narrative"
    },
    {
      "type": "checkbox",
      "id": "show_story",
      "label": "Show Philosophy & Craft Block",
      "default": true
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Story Eyebrow",
      "default": "OUR PHILOSOPHY & CRAFT"
    },
    {
      "type": "textarea",
      "id": "story_lead",
      "label": "Story Highlight / Core Philosophy",
      "default": "At Ellora, this idea sits quietly at the heart of what we do: our surroundings influence how we feel, and the materials we choose are essential to creating spaces that support calm, balance and wellbeing."
    },
    {
      "type": "textarea",
      "id": "story_p1",
      "label": "Story Paragraph 1",
      "default": "The texture of stone and the softness of a wall covering shape the atmosphere of a room and our experience within it. Together with considered proportions, light and craftsmanship, they can bring a sense of comfort and grounding to the places we inhabit."
    },
    {
      "type": "textarea",
      "id": "story_p2",
      "label": "Story Paragraph 2",
      "default": "Our journey begins with sculptural stone panels and wall coverings, handcrafted in India for spaces around the world. Working with skilled craftspeople, quarries and ateliers, we bring traditional techniques into a contemporary design language, allowing age-old craft to find fresh expression."
    },
    {
      "type": "textarea",
      "id": "story_p3",
      "label": "Story Paragraph 3",
      "default": "We are drawn to materials with character and depth: tactile surfaces, subtle irregularities and details that reveal the hand of the maker. We value the marks and variations that make each piece individual, bringing a connection to its origins into the finished space."
    },
    {
      "type": "textarea",
      "id": "story_p4",
      "label": "Story Paragraph 4",
      "default": "For us, material is not simply something to look at. It is something to experience. Over time, the Ellora world will grow to include surfaces, objects and pieces for living that share this sense of warmth, craftsmanship and quiet refinement."
    },
    {
      "type": "textarea",
      "id": "story_closing_title",
      "label": "Closing Highlight Statement",
      "default": "Ultimately, Ellora is about creating spaces that feel good to live in."
    },
    {
      "type": "text",
      "id": "triplet_1",
      "label": "Triplet Point 1",
      "default": "A little calmer."
    },
    {
      "type": "text",
      "id": "triplet_2",
      "label": "Triplet Point 2",
      "default": "A little warmer."
    },
    {
      "type": "text",
      "id": "triplet_3",
      "label": "Triplet Point 3",
      "default": "A little more restorative."
    },
    {
      "type": "text",
      "id": "story_names",
      "label": "Sign-off Names (Optional)"
    },
    {
      "type": "text",
      "id": "story_role",
      "label": "Sign-off Title/Role (Optional)"
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (px)",
      "min": 32,
      "max": 72,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "desc_font_size",
      "label": "Description Font Size (px)",
      "min": 13,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1C1B19"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A453F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#B86B53"
    },
    {
      "type": "header",
      "content": "Section Layout & Padding"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width (px)",
      "min": 1100,
      "max": 1920,
      "step": 20,
      "default": 1720
    },
    {
      "type": "range",
      "id": "gap_below_header",
      "label": "Gap Below Header (px)",
      "min": 16,
      "max": 64,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "story_margin_top",
      "label": "Story Margin Top (px)",
      "min": 32,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "story_padding_top",
      "label": "Story Padding Top (px)",
      "min": 24,
      "max": 100,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Padding Top (px)",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Padding Top (px)",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Padding Bottom (px)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "About 01 - Hero & Intro"
    }
  ]
}
{% endschema %}

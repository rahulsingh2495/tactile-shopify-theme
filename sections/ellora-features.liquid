{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 2: VALUE PROPOSITIONS (TRUST BADGES)
  File: sections/ellora-features.liquid
  Fully customizable via Shopify Theme Customizer
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-features-wrapper" id="ellora-features-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-features-{{ section.id }} {
      --el-bg-main: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: #1C1B19;
      --el-text: #2D2A28;
      --el-primary-hover: #9E533D;
      --el-title-color: {{ section.settings.title_color | default: '#8E6356' }};
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      background-color: var(--el-bg-main);
      padding: {{ section.settings.padding_top | default: 58 }}px 0 {{ section.settings.padding_bottom | default: 52 }}px;
      width: 100%;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-features-{{ section.id }} *,
    #ellora-features-{{ section.id }} *::before,
    #ellora-features-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-features-{{ section.id }} .el-sec-features-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
    }

    #ellora-features-{{ section.id }} .el-features-grid {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr);
      gap: 0;
    }

    #ellora-features-{{ section.id }} .el-feature-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 0 32px 0 0;
      position: relative;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    #ellora-features-{{ section.id }} .el-feature-item:not(:first-child) {
      padding-left: 36px;
    }

    #ellora-features-{{ section.id }} .el-feature-item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 6px;
      height: calc(100% - 12px);
      width: 1px;
      background-color: #E6E1D9;
    }

    #ellora-features-{{ section.id }} .el-feature-icon {
      width: 32px;
      height: 32px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      color: var(--el-dark);
    }

    #ellora-features-{{ section.id }} .el-feature-icon svg,
    #ellora-features-{{ section.id }} .el-feature-icon img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    #ellora-features-{{ section.id }} .el-feature-title {
      font-family: var(--el-font-serif);
      font-size: 25px;
      font-weight: 400;
      color: var(--el-title-color);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
      line-height: 1.22;
      transition: color 0.25s ease;
    }

    #ellora-features-{{ section.id }} .el-feature-item:hover .el-feature-title {
      color: var(--el-primary-hover);
    }

    #ellora-features-{{ section.id }} .el-feature-desc {
      font-family: var(--el-font-sans);
      font-size: 14px;
      color: #4A453F;
      line-height: 1.55;
      font-weight: 400;
    }

    @media (max-width: 900px) {
      #ellora-features-{{ section.id }} .el-features-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 32px !important;
      }
      #ellora-features-{{ section.id }} .el-feature-item {
        padding: 0 !important;
      }
      #ellora-features-{{ section.id }} .el-feature-item::after {
        display: none !important;
      }
    }

    @media (max-width: 640px) {
      #ellora-features-{{ section.id }} .el-features-grid {
        grid-template-columns: 1fr !important;
        gap: 24px !important;
      }
    }
  </style>

  <div class="el-sec-features-container">
    <div class="el-features-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} 
            class="el-feature-item" 
            {{ block.shopify_attributes }}>
            <div class="el-feature-icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="4" y="4" width="24" height="24" rx="2" stroke-width="1.8"></rect>
                  <line x1="8" y1="4" x2="4" y2="8"></line>
                  <line x1="14" y1="4" x2="4" y2="14"></line>
                  <line x1="20" y1="4" x2="4" y2="20"></line>
                  <line x1="26" y1="4" x2="4" y2="26"></line>
                  <line x1="28" y1="8" x2="8" y2="28"></line>
                  <line x1="28" y1="14" x2="14" y2="28"></line>
                  <line x1="28" y1="20" x2="20" y2="28"></line>
                  <line x1="28" y1="26" x2="26" y2="28"></line>
                </svg>
              {%- endif -%}
            </div>
            <h4 class="el-feature-title">{{ block.settings.title }}</h4>
            <p class="el-feature-desc">{{ block.settings.description }}</p>
          </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
        {%- endfor -%}
      {%- else -%}
        <!-- Figma Trust Badges Fallback -->
        <div class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="4" width="24" height="24" rx="2" stroke-width="1.8"></rect>
              <line x1="8" y1="4" x2="4" y2="8"></line>
              <line x1="14" y1="4" x2="4" y2="14"></line>
              <line x1="20" y1="4" x2="4" y2="20"></line>
              <line x1="26" y1="4" x2="4" y2="26"></line>
              <line x1="28" y1="8" x2="8" y2="28"></line>
              <line x1="28" y1="14" x2="14" y2="28"></line>
              <line x1="28" y1="20" x2="20" y2="28"></line>
              <line x1="28" y1="26" x2="26" y2="28"></line>
            </svg>
          </div>
          <h4 class="el-feature-title">Thoughtfully Created Tiles</h4>
          <p class="el-feature-desc">Chat to our friendly team for all your design and technical needs</p>
        </div>

        <div class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="4" width="24" height="24" rx="2" stroke-width="1.8"></rect>
              <line x1="8" y1="4" x2="4" y2="8"></line>
              <line x1="14" y1="4" x2="4" y2="14"></line>
              <line x1="20" y1="4" x2="4" y2="20"></line>
              <line x1="26" y1="4" x2="4" y2="26"></line>
              <line x1="28" y1="8" x2="8" y2="28"></line>
              <line x1="28" y1="14" x2="14" y2="28"></line>
              <line x1="28" y1="20" x2="20" y2="28"></line>
              <line x1="28" y1="26" x2="26" y2="28"></line>
            </svg>
          </div>
          <h4 class="el-feature-title">Secure Online Ordering</h4>
          <p class="el-feature-desc">Chat to our friendly team for all your design and technical needs</p>
        </div>

        <div class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="4" width="24" height="24" rx="2" stroke-width="1.8"></rect>
              <line x1="8" y1="4" x2="4" y2="8"></line>
              <line x1="14" y1="4" x2="4" y2="14"></line>
              <line x1="20" y1="4" x2="4" y2="20"></line>
              <line x1="26" y1="4" x2="4" y2="26"></line>
              <line x1="28" y1="8" x2="8" y2="28"></line>
              <line x1="28" y1="14" x2="14" y2="28"></line>
              <line x1="28" y1="20" x2="20" y2="28"></line>
              <line x1="28" y1="26" x2="26" y2="28"></line>
            </svg>
          </div>
          <h4 class="el-feature-title">Clear Delivery information</h4>
          <p class="el-feature-desc">Chat to our friendly team for all your design and technical needs</p>
        </div>

        <a href="https://wa.me/" class="el-feature-item" target="_blank" rel="noopener noreferrer">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="4" y="4" width="24" height="24" rx="2" stroke-width="1.8"></rect>
              <line x1="8" y1="4" x2="4" y2="8"></line>
              <line x1="14" y1="4" x2="4" y2="14"></line>
              <line x1="20" y1="4" x2="4" y2="20"></line>
              <line x1="26" y1="4" x2="4" y2="26"></line>
              <line x1="28" y1="8" x2="8" y2="28"></line>
              <line x1="28" y1="14" x2="14" y2="28"></line>
              <line x1="28" y1="20" x2="20" y2="28"></line>
              <line x1="28" y1="26" x2="26" y2="28"></line>
            </svg>
          </div>
          <h4 class="el-feature-title">Personal Help on Whatsapp</h4>
          <p class="el-feature-desc">Chat to our friendly team for all your design and technical needs</p>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ellora Trust Badges",
  "tag": "section",
  "class": "section-ellora-features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Badge Heading Color",
      "default": "#8E6356"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Trust Badge Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon (Optional SVG / PNG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtfully Created Tiles"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Chat to our friendly team for all your design and technical needs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellora Trust Badges",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Thoughtfully Created Tiles",
            "description": "Chat to our friendly team for all your design and technical needs",
            "link": "/collections/all"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Secure Online Ordering",
            "description": "Chat to our friendly team for all your design and technical needs",
            "link": "/pages/contact"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Clear Delivery Information",
            "description": "Chat to our friendly team for all your design and technical needs",
            "link": "/pages/faq"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Personal Help on WhatsApp",
            "description": "Chat to our friendly team for all your design and technical needs"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 2: VALUE PROPOSITIONS (TRUST BADGES)
  File: sections/ellora-features.liquid
  Fully customizable via Shopify Theme Customizer
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-features-wrapper" id="ellora-features-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-features-{{ section.id }} {
      --el-bg-main: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: #1C1B19;
      --el-text: #2D2A28;
      --el-primary-hover: #BF8673;
      --el-title-color: {{ section.settings.title_color | default: '#805D52' }};
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      background-color: var(--el-bg-main);
      padding: {{ section.settings.padding_top | default: 58 }}px 0 {{ section.settings.padding_bottom | default: 52 }}px;
      width: 100%;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }

    #ellora-features-{{ section.id }} *,
    #ellora-features-{{ section.id }} *::before,
    #ellora-features-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-features-{{ section.id }} .el-sec-features-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
    }

    #ellora-features-{{ section.id }} .el-features-grid {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 0;
      align-items: flex-start;
    }

    #ellora-features-{{ section.id }} .el-feature-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 0 32px 0 0;
      position: relative;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    #ellora-features-{{ section.id }} .el-feature-item:not(:first-child) {
      padding-left: 36px;
    }

    #ellora-features-{{ section.id }} .el-feature-item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 6px;
      height: calc(100% - 12px);
      width: 1px;
      background-color: #E6E1D9;
    }

    #ellora-features-{{ section.id }} .el-feature-icon {
      width: 32px;
      height: 32px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      color: var(--el-dark);
    }

    #ellora-features-{{ section.id }} .el-feature-icon svg,
    #ellora-features-{{ section.id }} .el-feature-icon img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    #ellora-features-{{ section.id }} .el-feature-title {
      font-family: var(--el-font-serif);
      font-size: 25px;
      font-weight: 400;
      color: var(--el-title-color);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
      line-height: 1.22;
      transition: color 0.25s ease;
    }

    #ellora-features-{{ section.id }} .el-feature-item:hover .el-feature-title {
      color: #805D52;
    }

    #ellora-features-{{ section.id }} .el-feature-desc {
      font-family: var(--el-font-sans);
      font-size: 14px;
      color: #4A453F;
      line-height: 1.55;
      font-weight: 400;
    }

    @media (max-width: 900px) {
      #ellora-features-{{ section.id }} .el-features-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 32px !important;
      }
      #ellora-features-{{ section.id }} .el-feature-item {
        padding: 0 !important;
      }
      #ellora-features-{{ section.id }} .el-feature-item::after {
        display: none !important;
      }
    }

    @media (max-width: 640px) {
      #ellora-features-{{ section.id }} .el-features-grid {
        grid-template-columns: 1fr !important;
        gap: 24px !important;
      }
    }
  </style>

  <div class="el-sec-features-container">
    <div class="el-features-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} 
            class="el-feature-item" 
            {{ block.shopify_attributes }}>
            <div class="el-feature-icon" aria-hidden="true">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 60 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                {%- assign title_low = block.settings.title | downcase -%}
                {%- assign icon_choice = block.settings.icon | default: 'auto' -%}

                {%- if icon_choice == 'layers_stone' or icon_choice == 'auto' and title_low contains 'stone' or title_low contains 'gwalior' or title_low contains 'layer' -%}
                  <!-- 1. Natural Gwalior Stone: Layers of Stone -->
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="6" width="24" height="5" rx="1.5"></rect>
                    <line x1="15" y1="6" x2="15" y2="11"></line>
                    <line x1="7" y1="8.5" x2="11" y2="8.5" stroke-opacity="0.6"></line>
                    <rect x="4" y="13.5" width="24" height="5" rx="1.5"></rect>
                    <line x1="10" y1="13.5" x2="10" y2="18.5"></line>
                    <line x1="21" y1="13.5" x2="21" y2="18.5"></line>
                    <line x1="13" y1="16" x2="18" y2="16" stroke-opacity="0.6"></line>
                    <rect x="4" y="21" width="24" height="5" rx="1.5"></rect>
                    <line x1="14" y1="21" x2="14" y2="26"></line>
                    <line x1="23" y1="21" x2="23" y2="26"></line>
                    <line x1="7" y1="23.5" x2="11" y2="23.5" stroke-opacity="0.6"></line>
                  </svg>
                {%- elsif icon_choice == 'chisel' or icon_choice == 'auto' and title_low contains 'handcrafted' or title_low contains 'india' or title_low contains 'chisel' -%}
                  <!-- 2. Handcrafted in India: Chisel -->
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 4l7 7-3.5 3.5-7-7L21 4z"></path>
                    <line x1="23" y1="6" x2="26" y2="9"></line>
                    <line x1="18.5" y1="9.5" x2="21.5" y2="12.5"></line>
                    <path d="M17.5 10.5L10 18l4 4 7.5-7.5"></path>
                    <path d="M10 18L5 23l-1 4.5 4.5-1 5-5"></path>
                    <line x1="4" y1="27.5" x2="8.5" y2="23"></line>
                    <line x1="3" y1="21" x2="5" y2="19"></line>
                    <line x1="12" y1="29" x2="10" y2="27"></line>
                  </svg>
                {%- elsif icon_choice == 'carved_motif' or icon_choice == 'auto' and title_low contains 'heritage' or title_low contains 'craft' or title_low contains 'motif' or title_low contains 'relief' or title_low contains 'pattern' -%}
                  <!-- 3. Inspired by Heritage Craft: Carved Motif -->
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="24" height="24" rx="3"></rect>
                    <circle cx="16" cy="16" r="2.8"></circle>
                    <path d="M16 8.5c-2 2-2 4.5 0 7.5 2-3 2-5.5 0-7.5z"></path>
                    <path d="M16 23.5c-2-2-2-4.5 0-7.5 2 3 2 5.5 0 7.5z"></path>
                    <path d="M8.5 16c2-2 4.5-2 7.5 0-3 2-5.5 2-7.5 0z"></path>
                    <path d="M23.5 16c-2-2-4.5-2-7.5 0 3 2 5.5 2 7.5 0z"></path>
                    <circle cx="9" cy="9" r="0.75" fill="currentColor"></circle>
                    <circle cx="23" cy="9" r="0.75" fill="currentColor"></circle>
                    <circle cx="9" cy="23" r="0.75" fill="currentColor"></circle>
                    <circle cx="23" cy="23" r="0.75" fill="currentColor"></circle>
                  </svg>
                {%- elsif icon_choice == 'sunlight_arch' or icon_choice == 'auto' and title_low contains 'quiet' or title_low contains 'space' or title_low contains 'sunlight' or title_low contains 'arch' -%}
                  <!-- 4. Made for Quiet Spaces: Sunlight through an Arch -->
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="27" x2="29" y2="27"></line>
                    <path d="M6 27V14a10 10 0 0 1 20 0v13"></path>
                    <path d="M9.5 27V15a6.5 6.5 0 0 1 13 0v12"></path>
                    <circle cx="16" cy="13.5" r="3"></circle>
                    <line x1="16" y1="6" x2="16" y2="3.5"></line>
                    <line x1="11" y1="7.5" x2="9" y2="5.5"></line>
                    <line x1="21" y1="7.5" x2="23" y2="5.5"></line>
                    <line x1="16" y1="18.5" x2="16" y2="24.5"></line>
                    <line x1="13.5" y1="19" x2="11.5" y2="24.5"></line>
                    <line x1="18.5" y1="19" x2="20.5" y2="24.5"></line>
                  </svg>
                {%- else -%}
                  <!-- Default: Layers of Stone -->
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="6" width="24" height="5" rx="1.5"></rect>
                    <line x1="15" y1="6" x2="15" y2="11"></line>
                    <rect x="4" y="13.5" width="24" height="5" rx="1.5"></rect>
                    <line x1="10" y1="13.5" x2="10" y2="18.5"></line>
                    <line x1="21" y1="13.5" x2="21" y2="18.5"></line>
                    <rect x="4" y="21" width="24" height="5" rx="1.5"></rect>
                    <line x1="14" y1="21" x2="14" y2="26"></line>
                  </svg>
                {%- endif -%}
              {%- endif -%}
            </div>
            <h4 class="el-feature-title">{{ block.settings.title }}</h4>
            <p class="el-feature-desc">{{ block.settings.description }}</p>
          </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback to About Features (Matching Exactly) -->
        <div class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 26V16a10 10 0 0 1 20 0v10"></path>
              <path d="M4 26h24"></path>
              <circle cx="16" cy="15" r="3.5"></circle>
              <path d="M16 6V3.5M10.5 7.5L8.5 5.5M21.5 7.5L23.5 5.5"></path>
            </svg>
          </div>
          <h4 class="el-feature-title">Calm atmosphere</h4>
          <p class="el-feature-desc">Surfaces crafted to instill tranquility, emotional resonance, and architectural balance in contemporary living spaces.</p>
        </div>

        <div class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="5" width="22" height="22" rx="2"></rect>
              <path d="M5 11h4M5 16h6M5 21h4M11 27v-4M16 27v-6M21 27v-4"></path>
              <path d="M13 13l7 7M20 13v7h-7"></path>
            </svg>
          </div>
          <h4 class="el-feature-title">Clear sizing</h4>
          <p class="el-feature-desc">Precise dimensional specifications and calculated layout increments to support seamless contractor execution.</p>
        </div>

        <div class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="24" height="24" rx="2.5"></rect>
              <path d="M4 16h24M16 4v24"></path>
              <circle cx="16" cy="16" r="2.5" fill="currentColor"></circle>
              <path d="M9 10h2M9 22h2M21 10h2M21 22h2"></path>
            </svg>
          </div>
          <h4 class="el-feature-title">Honest selling unit</h4>
          <p class="el-feature-desc">Transparent square-meter and crate pricing with no hidden wastage markups or ambiguous selling minimums.</p>
        </div>

        <a href="/pages/contact" class="el-feature-item">
          <div class="el-feature-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="16" r="11.5"></circle>
              <polygon points="16 7.5 18.5 13.5 24.5 16 18.5 18.5 16 24.5 13.5 18.5 7.5 16 13.5 13.5" fill="currentColor" fill-opacity="0.15"></polygon>
            </svg>
          </div>
          <h4 class="el-feature-title">Guided selection</h4>
          <p class="el-feature-desc">Dedicated stone consultants and architectural specialists ready to support your layout drawings and technical needs.</p>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ellora Trust Badges",
  "tag": "section",
  "class": "section-ellora-features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Badge Heading Color",
      "default": "#CC9E8F"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Trust Badge Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "auto",
              "label": "Auto (Matches Heading Automatically)"
            },
            {
              "value": "layers_stone",
              "label": "Layers of Stone (Natural Gwalior Stone)"
            },
            {
              "value": "chisel",
              "label": "Chisel (Handcrafted in India)"
            },
            {
              "value": "carved_motif",
              "label": "Carved Motif (Inspired by Heritage Craft)"
            },
            {
              "value": "sunlight_arch",
              "label": "Sunlight through Arch (Made for Quiet Spaces)"
            }
          ],
          "default": "auto"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon (Optional SVG / PNG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtfully Created Tiles"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Chat to our friendly team for all your design and technical needs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellora Trust Badges",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Thoughtfully Created Tiles",
            "description": "Chat to our friendly team for all your design and technical needs",
            "link": "/collections/all"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Secure Online Ordering",
            "description": "Chat to our friendly team for all your design and technical needs",
            "link": "/pages/contact"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Clear Delivery Information",
            "description": "Chat to our friendly team for all your design and technical needs",
            "link": "/pages/advice-hub"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Personal Help on WhatsApp",
            "description": "Chat to our friendly team for all your design and technical needs"
          }
        }
      ]
    }
  ]
}
{% endschema %}

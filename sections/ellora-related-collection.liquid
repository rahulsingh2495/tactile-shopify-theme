  <script>
    (function() {
      var root = document.getElementById('ellora-related-{{ section.id }}');
      if (!root) return;

      // Slider scroll buttons
      var prevBtn = root.querySelector('.el-slider-prev');
      var nextBtn = root.querySelector('.el-slider-next');
      var gridTrack = root.querySelector('.el-rc-grid.is-slider');

      if (gridTrack && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', function() {
          var scrollAmount = gridTrack.clientWidth * 0.75;
          gridTrack.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', function() {
          var scrollAmount = gridTrack.clientWidth * 0.75;
          gridTrack.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }

      // Mobile / Touch interaction:
      // First tap expands the bottom drawer to reveal description & CTA without redirecting.
      // Second tap on the arrow/toggle, title, or drawer body collapses it back down.
      // Tapping "Explore →" or the image navigates directly to the collection URL.
      var cards = root.querySelectorAll('.el-rc-card');
      cards.forEach(function(card) {
        var link = card.querySelector('.el-rc-card-link');
        if (!link) return;

        link.addEventListener('click', function(e) {
          var isTouchOrSmall = window.matchMedia('(max-width: 991px)').matches || ('ontouchstart' in window);
          if (!isTouchOrSmall) return; // Desktop mouse hover handles expansion, clicks navigate directly

          if (!card.classList.contains('is-expanded')) {
            // First tap: Prevent instant redirect and expand drawer to show details
            e.preventDefault();
            cards.forEach(function(c) {
              if (c !== card) c.classList.remove('is-expanded');
            });
            card.classList.add('is-expanded');
          } else {
            // Card is already expanded:
            var isCta = e.target.closest('.el-rc-explore-cta') || e.target.closest('.el-rc-cta-wrap');
            var isMedia = e.target.closest('.el-rc-media');

            if (isCta || isMedia) {
              // User tapped Explore CTA or the image above drawer: navigate to collection URL
              return;
            } else {
              // User tapped the arrow toggle, title, or drawer body: collapse drawer back down!
              e.preventDefault();
              e.stopPropagation();
              card.classList.remove('is-expanded');
            }
          }
        });
      });

      // Tap outside collapses any expanded card
      document.addEventListener('click', function(e) {
        if (!root.contains(e.target)) {
          cards.forEach(function(c) {
            c.classList.remove('is-expanded');
          });
        }
      });
    })();
  </script>

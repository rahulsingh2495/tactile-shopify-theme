{% comment %}
  ==========================================================================
  ELLORA SPACES — FOOTER SECTION
  File: sections/ellora-footer.liquid
  Pixel-perfect implementation matching Ellora luxury editorial design
  Features:
  - Brand Logo + Flexible Repeatable Social Icon Blocks with 12+ icon choices
    (Instagram, Pinterest, Houzz, Facebook, X, YouTube, LinkedIn, TikTok, WhatsApp, Threads, Custom SVG/Image)
  - 3 Editorial Serif Navigation Columns (Shop, Help, Ellora) with menu pickers
  - Luxury Newsletter Card with Shopify Customer form
  - Bottom Legal Bar with Copyright, Terms of Service, and Privacy Policy
  - Full Theme Customizer controls for all texts, colors, links, and padding
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-footer-section-wrapper" id="ellora-footer-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-footer-{{ section.id }} {
      --el-ft-bg: {{ section.settings.bg_color | default: '#FAF8F5' }};
      --el-ft-card-bg: {{ section.settings.card_bg | default: '#FFF8F5' }};
      --el-ft-primary: {{ section.settings.accent_color | default: '#C59B8B' }};
      --el-ft-primary-hover: #B48776;
      --el-ft-dark: #2D2A28;
      --el-ft-heading: #2D2A28;
      --el-ft-text: #4A4641;
      --el-ft-muted: #7E7973;
      --el-ft-border: #E8E2D9;
      --el-ft-input-bg: #FFFFFF;
      --el-ft-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-ft-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      background-color: var(--el-ft-bg);
      font-family: var(--el-ft-font-sans);
      color: var(--el-ft-text);
      padding-top: {{ section.settings.padding_top | default: 72 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 28 }}px;
      width: 100%;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      border-top: 1px solid var(--el-ft-border);
    }

    #ellora-footer-{{ section.id }} *,
    #ellora-footer-{{ section.id }} *::before,
    #ellora-footer-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* Container matching the 90% fluid width of the main layout */
    #ellora-footer-{{ section.id }} .el-footer-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
    }

    /* Main Grid: Brand Column + 3 Navigation Columns + Newsletter Card */
    #ellora-footer-{{ section.id }} .el-footer-grid {
      display: grid !important;
      grid-template-columns: 240px 1fr 1fr 1fr 340px !important;
      gap: 36px !important;
      align-items: stretch !important;
    }

    /* Column 1: Brand Logo at top, Socials at bottom */
    #ellora-footer-{{ section.id }} .el-footer-brand-col {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 6px;
    }

    #ellora-footer-{{ section.id }} .el-footer-logo-link {
      display: inline-block;
      text-decoration: none;
      transition: opacity 0.25s ease;
    }

    #ellora-footer-{{ section.id }} .el-footer-logo-link:hover {
      opacity: 0.85;
    }

    #ellora-footer-{{ section.id }} .el-footer-logo-img {
      width: {{ section.settings.logo_width | default: 130 }}px;
      height: auto;
      display: block;
    }

    /* Editorial Text Logo Fallback */
    #ellora-footer-{{ section.id }} .el-footer-text-logo {
      display: flex;
      flex-direction: column;
      text-decoration: none;
    }

    #ellora-footer-{{ section.id }} .el-footer-text-brand {
      font-family: var(--el-ft-font-serif);
      font-size: 32px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: -0.01em;
      color: var(--el-ft-primary);
    }

    #ellora-footer-{{ section.id }} .el-footer-text-sub {
      font-family: var(--el-ft-font-sans);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--el-ft-primary);
      margin-top: 4px;
    }

    /* Social Icons Container (supports wrap for multiple icons) */
    #ellora-footer-{{ section.id }} .el-footer-socials {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 36px;
      max-width: 240px;
    }

    #ellora-footer-{{ section.id }} .el-footer-social-btn {
      width: 34px;
      height: 34px;
      border-radius: 6px;
      background-color: var(--el-ft-primary);
      color: #FFFFFF !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      transition: background-color 0.25s ease, transform 0.2s ease;
      overflow: hidden;
      flex-shrink: 0;
    }

    #ellora-footer-{{ section.id }} .el-footer-social-btn:hover {
      background-color: var(--el-ft-primary-hover);
      transform: translateY(-2px);
    }

    #ellora-footer-{{ section.id }} .el-footer-social-btn svg {
      width: 17px;
      height: 17px;
      fill: currentColor;
      display: block;
    }

    #ellora-footer-{{ section.id }} .el-footer-social-btn img {
      width: 18px;
      height: 18px;
      object-fit: contain;
      display: block;
    }

    /* Navigation Columns */
    #ellora-footer-{{ section.id }} .el-footer-nav-col {
      display: flex;
      flex-direction: column;
    }

    #ellora-footer-{{ section.id }} .el-footer-nav-title {
      font-family: var(--el-ft-font-serif);
      font-size: 21px;
      font-weight: 400;
      color: var(--el-ft-heading);
      margin: 0 0 22px 0;
      letter-spacing: 0.01em;
      line-height: 1.2;
    }

    #ellora-footer-{{ section.id }} .el-footer-nav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    #ellora-footer-{{ section.id }} .el-footer-nav-item a {
      font-family: var(--el-ft-font-sans);
      font-size: 13.5px;
      font-weight: 400;
      color: var(--el-ft-text);
      text-decoration: none;
      transition: color 0.2s ease, transform 0.2s ease;
      display: inline-block;
    }

    #ellora-footer-{{ section.id }} .el-footer-nav-item a:hover {
      color: var(--el-ft-primary);
      transform: translateX(2px);
    }

    /* Column 5: Newsletter Card */
    #ellora-footer-{{ section.id }} .el-footer-newsletter-card {
      background-color: var(--el-ft-card-bg);
      border: 1px solid rgba(197, 155, 139, 0.15);
      border-radius: 8px;
      padding: 28px 24px 26px 24px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.02);
    }

    #ellora-footer-{{ section.id }} .el-footer-newsletter-title {
      font-family: var(--el-ft-font-serif);
      font-size: 20px;
      line-height: 1.3;
      font-weight: 400;
      color: var(--el-ft-heading);
      margin: 0 0 10px 0;
    }

    #ellora-footer-{{ section.id }} .el-footer-newsletter-desc {
      font-family: var(--el-ft-font-sans);
      font-size: 13px;
      line-height: 1.5;
      color: var(--el-ft-muted);
      margin: 0 0 20px 0;
    }

    #ellora-footer-{{ section.id }} .el-footer-newsletter-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
    }

    #ellora-footer-{{ section.id }} .el-footer-input {
      width: 100%;
      height: 42px;
      background: var(--el-ft-input-bg);
      border: 1px solid var(--el-ft-border);
      border-radius: 4px;
      padding: 0 14px;
      font-family: var(--el-ft-font-sans);
      font-size: 13.5px;
      color: var(--el-ft-dark);
      outline: none;
      transition: border-color 0.2s ease;
    }

    #ellora-footer-{{ section.id }} .el-footer-input::placeholder {
      color: #9C968F;
    }

    #ellora-footer-{{ section.id }} .el-footer-input:focus {
      border-color: var(--el-ft-primary);
    }

    #ellora-footer-{{ section.id }} .el-footer-submit-btn {
      width: 100%;
      height: 44px;
      background-color: var(--el-ft-primary);
      color: #FFFFFF !important;
      border: none;
      border-radius: 4px;
      font-family: var(--el-ft-font-sans);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.25s ease, transform 0.2s ease;
    }

    #ellora-footer-{{ section.id }} .el-footer-submit-btn:hover {
      background-color: var(--el-ft-primary-hover);
      transform: translateY(-1px);
    }

    #ellora-footer-{{ section.id }} .el-footer-form-success {
      font-size: 13px;
      color: #3B7A57;
      margin-top: 8px;
    }

    /* Bottom Sub-footer / Legal Copyright Bar */
    #ellora-footer-{{ section.id }} .el-footer-bottom {
      margin-top: 56px;
      padding-top: 22px;
      border-top: 1px solid var(--el-ft-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 18px;
    }

    #ellora-footer-{{ section.id }} .el-footer-copyright {
      font-family: var(--el-ft-font-sans);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--el-ft-muted);
      margin: 0;
    }

    #ellora-footer-{{ section.id }} .el-footer-legal-links {
      display: flex;
      align-items: center;
      gap: 36px;
    }

    #ellora-footer-{{ section.id }} .el-footer-legal-links a {
      font-family: var(--el-ft-font-sans);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--el-ft-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    #ellora-footer-{{ section.id }} .el-footer-legal-links a:hover {
      color: var(--el-ft-primary);
    }

    /* -----------------------------------------------------------------------
       RESPONSIVE BREAKPOINTS
       ----------------------------------------------------------------------- */
    @media (max-width: 1100px) {
      #ellora-footer-{{ section.id }} .el-footer-grid {
        grid-template-columns: 200px 1fr 1fr 1fr 300px !important;
        gap: 24px !important;
      }
    }

    @media (max-width: 960px) {
      #ellora-footer-{{ section.id }} .el-footer-grid {
        grid-template-columns: 1fr 1fr 1fr !important;
        gap: 36px 24px !important;
      }
      #ellora-footer-{{ section.id }} .el-footer-brand-col {
        grid-column: 1 / -1;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
      #ellora-footer-{{ section.id }} .el-footer-socials {
        margin-top: 0;
      }
      #ellora-footer-{{ section.id }} .el-footer-newsletter-card {
        grid-column: 1 / -1;
        max-width: 500px;
      }
      #ellora-footer-{{ section.id }} .el-footer-bottom {
        margin-top: 44px;
      }
    }

    @media (max-width: 640px) {
      #ellora-footer-{{ section.id }} .el-footer-grid {
        grid-template-columns: 1fr 1fr !important;
        gap: 32px 20px !important;
      }
      #ellora-footer-{{ section.id }} .el-footer-brand-col {
        grid-column: 1 / -1;
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
      }
      #ellora-footer-{{ section.id }} .el-footer-socials {
        margin-top: 0;
      }
      #ellora-footer-{{ section.id }} .el-footer-nav-col:nth-child(4) {
        grid-column: 1 / -1;
      }
      #ellora-footer-{{ section.id }} .el-footer-newsletter-card {
        grid-column: 1 / -1;
        padding: 24px 18px;
      }
      #ellora-footer-{{ section.id }} .el-footer-bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        margin-top: 36px;
      }
      #ellora-footer-{{ section.id }} .el-footer-legal-links {
        gap: 24px;
      }
    }
  </style>

  <footer class="el-footer-container">
    <!-- Top Main Grid -->
    <div class="el-footer-grid">
      <!-- Col 1: Brand Logo + Social Buttons -->
      <div class="el-footer-brand-col">
        <a href="/" class="el-footer-logo-link" aria-label="Ellora Spaces Home">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'el-footer-logo-img', alt: 'Ellora Spaces' }}
          {%- elsif section.settings.fallback_logo != blank -%}
            <img src="{{ section.settings.fallback_logo }}" alt="Ellora Spaces" class="el-footer-logo-img">
          {%- else -%}
            <div class="el-footer-text-logo">
              <span class="el-footer-text-brand">ellora</span>
              <span class="el-footer-text-sub">SPACES</span>
            </div>
          {%- endif -%}
        </a>

        <!-- Social Icons: Block-based with customizable platform selection -->
        <div class="el-footer-socials">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_icon' -%}
                {%- assign social_url = block.settings.link | default: '#' -%}
                {%- assign aria = block.settings.aria_label | default: block.settings.platform | capitalize -%}
                <a href="{{ social_url }}" {% if block.settings.link != blank %}target="_blank" rel="noopener noreferrer"{% endif %} class="el-footer-social-btn" aria-label="{{ aria }}" {{ block.shopify_attributes }}>
                  {%- case block.settings.platform -%}
                    {%- when 'instagram' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    {%- when 'pinterest' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.357-.053.211-.174.256-.402.155-1.499-.696-2.435-2.883-2.435-4.643 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
                    {%- when 'houzz' -%}
                      <svg viewBox="0 0 24 24"><path d="M12.5 12.5H19V24H12.5V12.5zm-7.5-6H11.5V18H5V6.5zm7.5-6.5H19V11H12.5V0z"/></svg>
                    {%- when 'facebook' -%}
                      <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    {%- when 'twitter' -%}
                      <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    {%- when 'youtube' -%}
                      <svg viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    {%- when 'linkedin' -%}
                      <svg viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    {%- when 'tiktok' -%}
                      <svg viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                    {%- when 'whatsapp' -%}
                      <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    {%- when 'threads' -%}
                      <svg viewBox="0 0 24 24"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.25 18.297 1.5 15.394 1.5 11.859 1.5 8.358 2.274 5.485 3.997 3.39 5.86 1.127 8.618 0 12.193 0c3.543 0 6.273 1.109 8.114 3.296 1.83 2.174 2.593 5.143 2.193 8.825l-.01.077h-3.467c.306-2.822-.192-4.945-1.442-6.313-1.21-1.324-3.08-1.996-5.388-1.996-2.483 0-4.385.76-5.653 2.258-1.282 1.516-1.932 3.791-1.932 6.762 0 3.003.633 5.301 1.882 6.832 1.258 1.543 3.125 2.327 5.55 2.327 2.455 0 4.29-.714 5.454-2.124.97-1.176 1.436-2.735 1.436-4.764 0-.174-.004-.351-.011-.531h-6.877v-3.32h10.45c.068.513.104 1.042.104 1.583 0 2.871-.723 5.253-2.15 7.08C19.043 22.42 16.031 23.974 12.186 24z"/></svg>
                    {%- when 'custom_svg' -%}
                      {%- if block.settings.custom_svg != blank -%}
                        {{ block.settings.custom_svg }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                      {%- endif -%}
                    {%- when 'custom_image' -%}
                      {%- if block.settings.custom_image != blank -%}
                        {{ block.settings.custom_image | image_url: width: 60 | image_tag: alt: aria }}
                      {%- else -%}
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                      {%- endif -%}
                  {%- endcase -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Default 3 Icons if no blocks added yet -->
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="el-footer-social-btn" aria-label="Follow Ellora on Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://pinterest.com" target="_blank" rel="noopener noreferrer" class="el-footer-social-btn" aria-label="Follow Ellora on Pinterest">
              <svg viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.332 1.357-.053.211-.174.256-.402.155-1.499-.696-2.435-2.883-2.435-4.643 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
            </a>
            <a href="https://houzz.com" target="_blank" rel="noopener noreferrer" class="el-footer-social-btn" aria-label="Explore Ellora on Houzz">
              <svg viewBox="0 0 24 24"><path d="M12.5 12.5H19V24H12.5V12.5zm-7.5-6H11.5V18H5V6.5zm7.5-6.5H19V11H12.5V0z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Col 2: Shop -->
      <div class="el-footer-nav-col">
        <h4 class="el-footer-nav-title">{{ section.settings.col2_title | default: 'Shop' }}</h4>
        <ul class="el-footer-nav-list">
          {%- if section.settings.col2_menu != blank -%}
            {%- for link in linklists[section.settings.col2_menu].links -%}
              <li class="el-footer-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="el-footer-nav-item"><a href="/collections/all?sort_by=created-descending">New Arrivals</a></li>
            <li class="el-footer-nav-item"><a href="/collections/all?sort_by=best-selling">Best Sellers</a></li>
            <li class="el-footer-nav-item"><a href="/collections/all">Shop All Tiles</a></li>
            <li class="el-footer-nav-item"><a href="/collections">Collections</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 3: Help -->
      <div class="el-footer-nav-col">
        <h4 class="el-footer-nav-title">{{ section.settings.col3_title | default: 'Help' }}</h4>
        <ul class="el-footer-nav-list">
          {%- if section.settings.col3_menu != blank -%}
            {%- for link in linklists[section.settings.col3_menu].links -%}
              <li class="el-footer-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="el-footer-nav-item"><a href="/pages/advice-hub">Advice Hub</a></li>
            <li class="el-footer-nav-item"><a href="/pages/delivery">Delivery</a></li>
            <li class="el-footer-nav-item"><a href="/pages/contact">Contact</a></li>
            <li class="el-footer-nav-item"><a href="https://wa.me/" target="_blank" rel="noopener noreferrer">Whatsapp</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 4: Ellora -->
      <div class="el-footer-nav-col">
        <h4 class="el-footer-nav-title">{{ section.settings.col4_title | default: 'Ellora' }}</h4>
        <ul class="el-footer-nav-list">
          {%- if section.settings.col4_menu != blank -%}
            {%- for link in linklists[section.settings.col4_menu].links -%}
              <li class="el-footer-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="el-footer-nav-item"><a href="/pages/about">About Us</a></li>
            <li class="el-footer-nav-item"><a href="/pages/inspiration">Inspiration</a></li>
            <li class="el-footer-nav-item"><a href="/pages/community">#ElloraLiving</a></li>
            <li class="el-footer-nav-item"><a href="/pages/trade">Trade</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 5: Newsletter Card -->
      <div class="el-footer-newsletter-card">
        <h3 class="el-footer-newsletter-title">{{ section.settings.newsletter_title | default: 'Notes on Materials, Interiors & Atmosphere.' }}</h3>
        <p class="el-footer-newsletter-desc">{{ section.settings.newsletter_desc | default: 'Occasional essays, collection releases & design guidance from Ellora Living.' }}</p>

        {%- form 'customer', class: 'el-footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="el-footer-form-success">Thank you for subscribing to Ellora Living notes.</p>
          {%- else -%}
            <input 
              type="email" 
              name="contact[email]" 
              class="el-footer-input" 
              placeholder="{{ section.settings.input_placeholder | default: 'Enter your email' }}" 
              required 
              aria-label="Enter your email"
              autocorrect="off"
              autocapitalize="off">
            <button type="submit" class="el-footer-submit-btn">
              {{ section.settings.btn_label | default: 'Shop the Collection' }}
            </button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <!-- Bottom Sub-footer / Legal Copyright Bar -->
    <div class="el-footer-bottom">
      <p class="el-footer-copyright">
        {{ section.settings.copyright_text | default: 'COPYRIGHT © 2026 ELLORA. ALL RIGHTS RESERVED' }}
      </p>
      <div class="el-footer-legal-links">
        <a href="{{ section.settings.terms_link | default: '/pages/terms-of-service' }}">
          {{ section.settings.terms_label | default: 'TERMS OF SERVICE' }}
        </a>
        <a href="{{ section.settings.privacy_link | default: '/pages/privacy-policy' }}">
          {{ section.settings.privacy_label | default: 'PRIVACY POLICY' }}
        </a>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "Ellora Footer",
  "tag": "section",
  "class": "section-ellora-footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "fallback_logo",
      "label": "Fallback Logo CDN URL",
      "default": "https://cdn.shopify.com/s/files/1/0990/3685/6647/files/ellora_logo_8780b82b-6b50-4332-a50a-c36cb355d900.png?v=1791338229"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 130
    },
    {
      "type": "header",
      "content": "Navigation Column 1 (Shop)"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Shop Menu (Optional)"
    },
    {
      "type": "header",
      "content": "Navigation Column 2 (Help)"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 2 Title",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "Help Menu (Optional)"
    },
    {
      "type": "header",
      "content": "Navigation Column 3 (Ellora)"
    },
    {
      "type": "text",
      "id": "col4_title",
      "label": "Column 3 Title",
      "default": "Ellora"
    },
    {
      "type": "link_list",
      "id": "col4_menu",
      "label": "Ellora Menu (Optional)"
    },
    {
      "type": "header",
      "content": "Newsletter Card"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Card Title",
      "default": "Notes on Materials, Interiors & Atmosphere."
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Newsletter Description",
      "default": "Occasional essays, collection releases & design guidance from Ellora Living."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "header",
      "content": "Bottom Legal Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "COPYRIGHT © 2026 ELLORA. ALL RIGHTS RESERVED"
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms of Service Label",
      "default": "TERMS OF SERVICE"
    },
    {
      "type": "url",
      "id": "terms_link",
      "label": "Terms of Service URL"
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy Policy Label",
      "default": "PRIVACY POLICY"
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy Policy URL"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Newsletter Card Background",
      "default": "#FFF8F5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Terracotta Accent Color",
      "default": "#C59B8B"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "social_icon",
      "name": "Social Icon",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform / Icon",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "pinterest", "label": "Pinterest" },
            { "value": "houzz", "label": "Houzz" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "twitter", "label": "X (Twitter)" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "linkedin", "label": "LinkedIn" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "threads", "label": "Threads" },
            { "value": "custom_svg", "label": "Custom SVG Code" },
            { "value": "custom_image", "label": "Custom Icon Image" }
          ],
          "default": "instagram"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Profile Link URL"
        },
        {
          "type": "text",
          "id": "aria_label",
          "label": "Accessibility Label",
          "default": "Follow us"
        },
        {
          "type": "textarea",
          "id": "custom_svg",
          "label": "Custom SVG Code (if Custom SVG chosen)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image (if Custom Image chosen)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellora Footer",
      "blocks": [
        {
          "type": "social_icon",
          "settings": {
            "platform": "instagram",
            "aria_label": "Follow Ellora on Instagram"
          }
        },
        {
          "type": "social_icon",
          "settings": {
            "platform": "pinterest",
            "aria_label": "Follow Ellora on Pinterest"
          }
        },
        {
          "type": "social_icon",
          "settings": {
            "platform": "houzz",
            "aria_label": "Explore Ellora on Houzz"
          }
        }
      ]
    }
  ]
}
{% endschema %}

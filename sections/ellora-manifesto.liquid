{% comment %}
  ==========================================================================
  ELLORA SPACES — SECTION 3: EDITORIAL MANIFESTO (STICKY SCROLL TEXT FILL)
  File: sections/ellora-manifesto.liquid
  Fully customizable via Shopify Theme Customizer
  Includes Top & Bottom Padding Controls + Compact Height Options
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-manifesto-wrapper" id="ellora-manifesto-{{ section.id }}">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-manifesto-{{ section.id }} {
      --el-bg-main: {{ section.settings.bg_color | default: '#FAF9F6' }};
      --el-dark: #1C1B19;
      --el-highlight: {{ section.settings.highlight_color | default: '#805D52' }};
      --el-dim: #DDD7CE;
      --el-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      width: 100%;
      position: relative;
      font-family: var(--el-font-sans);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      background-color: var(--el-bg-main);
    }

    #ellora-manifesto-{{ section.id }} *,
    #ellora-manifesto-{{ section.id }} *::before,
    #ellora-manifesto-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    {%- if section.settings.enable_sticky_scroll -%}
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-wrapper {
        position: relative;
        height: {{ section.settings.scroll_depth | default: '115vh' }};
        background-color: var(--el-bg-main);
      }

      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-container {
        position: -webkit-sticky;
        position: sticky;
        top: 14vh;
        height: auto;
        min-height: auto;
        display: block;
        background-color: var(--el-bg-main);
        z-index: 5;
        box-sizing: border-box;
        padding-top: {{ section.settings.padding_top | default: 40 }}px;
        padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
      }
    {%- else -%}
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-wrapper {
        position: relative;
        height: auto;
        background-color: var(--el-bg-main);
      }

      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-container {
        position: relative;
        height: auto;
        min-height: auto;
        display: block;
        background-color: var(--el-bg-main);
        padding-top: {{ section.settings.padding_top | default: 45 }}px;
        padding-bottom: {{ section.settings.padding_bottom | default: 45 }}px;
      }
    {%- endif -%}

    #ellora-manifesto-{{ section.id }} .el-manifesto-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
      padding: 0;
    }

    #ellora-manifesto-{{ section.id }} .el-manifesto-kicker {
      font-family: var(--el-font-sans);
      font-size: 13.5px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #1C1B19;
      margin-bottom: {{ section.settings.kicker_margin | default: 28 }}px;
      display: block;
    }

    #ellora-manifesto-{{ section.id }} .el-manifesto-heading {
      color: #805D52;
      font-family: var(--el-font-serif);
      font-size: 48px;
      line-height: 1.34;
      letter-spacing: -0.01em;
      font-weight: 400;
      margin: 0;
      text-indent: 42%;
    }

    #ellora-manifesto-{{ section.id }} .el-manifesto-lead {
      color: var(--el-highlight);
      display: inline;
    }

    #ellora-manifesto-{{ section.id }} .el-manifesto-body {
      display: inline;
    }

    #ellora-manifesto-{{ section.id }} .el-scroll-word {
      {%- if section.settings.enable_scroll_reveal != false -%}
        color: var(--el-dim);
        transition: color 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      {%- else -%}
        color: var(--el-highlight);
      {%- endif -%}
      display: inline;
    }

    #ellora-manifesto-{{ section.id }} .el-scroll-word.is-active {
      color: var(--el-highlight);
    }

    @media (max-width: 900px) {
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-wrapper {
        height: auto !important;
      }
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-container {
        position: static !important;
        height: auto !important;
        min-height: 0 !important;
        padding-top: 36px;
        padding-bottom: 28px;
      }
      #ellora-manifesto-{{ section.id }} .el-scroll-word {
        color: var(--el-highlight) !important;
      }
      #ellora-manifesto-{{ section.id }} .el-manifesto-heading {
        font-size: 32px !important;
        line-height: 1.35;
        text-indent: 0;
      }
      #ellora-manifesto-{{ section.id }} .el-manifesto-kicker {
        margin-bottom: 20px;
      }
    }

    @media (max-width: 640px) {
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-wrapper {
        height: auto !important;
      }
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-container {
        position: static !important;
        height: auto !important;
        min-height: 0 !important;
        padding-top: 28px;
        padding-bottom: 24px;
      }
      #ellora-manifesto-{{ section.id }} .el-manifesto-heading {
        font-size: 32px !important;
        line-height: 1.35;
        text-indent: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-wrapper {
        height: auto !important;
      }
      #ellora-manifesto-{{ section.id }} .el-manifesto-sticky-container {
        position: static !important;
        height: auto !important;
        min-height: 0 !important;
      }
      #ellora-manifesto-{{ section.id }} .el-scroll-word {
        color: var(--el-highlight) !important;
      }
    }
  </style>

  <div class="el-manifesto-sticky-wrapper" id="elStickyWrapper-{{ section.id }}">
    <div class="el-manifesto-sticky-container">
      <div class="el-manifesto-container" id="about">
        {%- if section.settings.kicker != blank -%}
          <span class="el-manifesto-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h1 class="el-manifesto-heading">
          <span class="el-manifesto-lead">{{ section.settings.lead_text }} </span>
          <span class="el-manifesto-body" id="elManifestoBody-{{ section.id }}">
            {%- assign words = section.settings.scroll_body | split: ' ' -%}
            {%- for word in words -%}
              <span class="el-scroll-word">{{ word }} </span>
            {%- endfor -%}
          </span>
        </h1>
      </div>
    </div>
  </div>

  {%- if section.settings.enable_scroll_reveal != false -%}
    <script>
      (function() {
        const section = document.getElementById('ellora-manifesto-{{ section.id }}');
        const wrapper = document.getElementById('elStickyWrapper-{{ section.id }}');
        const body = document.getElementById('elManifestoBody-{{ section.id }}');
        if (!section || !wrapper || !body) return;

        const words = body.querySelectorAll('.el-scroll-word');
        const totalWords = words.length;
        if (totalWords === 0) return;

        // Mobile or prefers-reduced-motion: reveal all words immediately
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth <= 900) {
          words.forEach(function(w) { w.classList.add('is-active'); });
          return;
        }

        const isSticky = {{ section.settings.enable_sticky_scroll | default: false | json }};
        let ticking = false;

        function updateFill() {
          const windowH = window.innerHeight;
          let progress = 0;

          if (isSticky) {
            const rect = wrapper.getBoundingClientRect();
            const totalDistance = rect.height - windowH;

            if (totalDistance <= 0) {
              progress = rect.top <= windowH * 0.4 ? 1 : 0;
            } else {
              const scrolled = -rect.top;
              progress = Math.min(Math.max(scrolled / totalDistance, 0), 1);
            }
          } else {
            const rect = body.getBoundingClientRect();
            // Natural scroll scrub: begins as text enters 82% of viewport, completes by 32%
            const start = windowH * 0.82;
            const end = windowH * 0.32;
            const current = rect.top;
            if (current >= start) {
              progress = 0;
            } else if (current <= end) {
              progress = 1;
            } else {
              progress = (start - current) / (start - end);
            }
          }

          const activeCount = Math.floor(progress * (totalWords + 1));

          for (let i = 0; i < totalWords; i++) {
            if (i < activeCount) {
              words[i].classList.add('is-active');
            } else {
              words[i].classList.remove('is-active');
            }
          }

          ticking = false;
        }

        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(updateFill);
            ticking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', function() {
          if (!ticking) {
            window.requestAnimationFrame(updateFill);
            ticking = true;
          }
        }, { passive: true });

        updateFill();
      })();
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Ellora Brand Manifesto",
  "tag": "section",
  "class": "section-ellora-manifesto",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 35
    },
    {
      "type": "range",
      "id": "kicker_margin",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Kicker Bottom Spacing",
      "default": 26
    },
    {
      "type": "header",
      "content": "Scroll Animation & Reveal"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll_reveal",
      "label": "Enable Word-by-Word Scroll Reveal",
      "default": true,
      "info": "Words illuminate progressively as you scroll past the text block."
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_scroll",
      "label": "Pin Section While Scrolling (Sticky Mode)",
      "default": false,
      "info": "When disabled (recommended), text reveals smoothly in natural document flow with zero blank space below. When enabled, text is held in place during scroll."
    },
    {
      "type": "select",
      "id": "scroll_depth",
      "label": "Sticky Scroll Distance",
      "options": [
        { "value": "115vh", "label": "Compact & Seamless (115vh)" },
        { "value": "130vh", "label": "Balanced (130vh)" },
        { "value": "160vh", "label": "Extended (160vh)" }
      ],
      "default": "115vh"
    },
    {
      "type": "header",
      "content": "Typography & Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "ABOUT ELLORA"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 28,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size (Desktop)",
      "default": 48
    },
    {
      "type": "textarea",
      "id": "lead_text",
      "label": "Lead-in Highlighted Text",
      "default": "Ellora was created to bring warmth, texture, and lasting beauty into everyday spaces."
    },
    {
      "type": "textarea",
      "id": "scroll_body",
      "label": "Body Text (Fills in on Scroll)",
      "default": "From understated neutrals to rich, expressive surfaces, our collection is thoughtfully curated to help you create environments that feel grounded, refined, and enduring."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Canvas Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Text Color",
      "default": "#805D52"
    }
  ],
  "presets": [
    {
      "name": "Ellora Brand Manifesto"
    }
  ]
}
{% endschema %}

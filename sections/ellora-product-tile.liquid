{% comment %}
  ==========================================================================
  ELLORA SPACES — TILE PRODUCT TEMPLATE SECTION
  File: sections/ellora-product-tile.liquid
  Theme Editor Name: Product - Tile Details
  Features:
  - 4:5 luxury gallery with thumbnail strip & zoom
  - Integrated Tile Area & Wastage Calculator (M2, Length x Width, +15% cutting allowance)
  - Dual action CTAs: Add to Basket + Order Sample Swatch ($5.00)
  - Selling rule badges ("Sold per M2", "Full Box Increments")
  - Architectural specifications table (Material, Slip Rating, Wet Room Suitability, Thickness)
  - Expandable technical accordion tabs (Installation & Sealing, Freight Delivery)
  - Heart Wishlist synchronization
  - AJAX cart integration opening the Slide Cart Drawer
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-prod-tile" id="ellora-prod-tile-{{ section.id }}" data-section-id="{{ section.id }}">
  {%- assign pt_primary = section.settings.primary_color -%}
  {%- if pt_primary == blank or pt_primary == '#8E6356' or pt_primary == '#8e6356' or pt_primary == '#754F43' or pt_primary == '#754f43' or pt_primary == '#BA9587' or pt_primary == '#ba9587' or pt_primary == '#734E43' or pt_primary == '#734e43' or pt_primary == '#A36854' or pt_primary == '#a36854' -%}
    {%- assign pt_primary = '#CC9E8F' -%}
  {%- endif -%}
  {%- assign pt_primary_hover = section.settings.primary_hover -%}
  {%- if pt_primary_hover == blank or pt_primary_hover == '#8E6356' or pt_primary_hover == '#8e6356' or pt_primary_hover == '#754F43' or pt_primary_hover == '#754f43' or pt_primary_hover == '#734d42' or pt_primary_hover == '#734D42' or pt_primary_hover == '#BA9587' or pt_primary_hover == '#ba9587' or pt_primary_hover == '#734E43' or pt_primary_hover == '#734e43' or pt_primary_hover == '#A36854' or pt_primary_hover == '#a36854' -%}
    {%- assign pt_primary_hover = '#BF8673' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-prod-tile-{{ section.id }} {
      --el-pt-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
      --el-pt-primary: {{ pt_primary }};
      --el-pt-primary-hover: {{ pt_primary_hover }};
      --el-pt-dark: {{ section.settings.text_dark | default: '#1C1B19' }};
      --el-pt-muted: {{ section.settings.text_muted | default: '#68645F' }};
      --el-pt-border: {{ section.settings.border_color | default: '#ECE7E1' }};
      --el-pt-card: {{ section.settings.card_bg | default: '#FAF8F5' }};

      --el-pt-padding-top: {{ section.settings.padding_top | default: 40 }}px;
      --el-pt-padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;

      background-color: var(--el-pt-bg);
      color: var(--el-pt-dark);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      padding-top: var(--el-pt-padding-top);
      padding-bottom: var(--el-pt-padding-bottom);
    }

    #ellora-prod-tile-{{ section.id }} *,
    #ellora-prod-tile-{{ section.id }} *::before,
    #ellora-prod-tile-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1280 }}px;
      margin: 0 auto;
    }

    /* Breadcrumbs */
    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 11.5px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--el-pt-muted);
      margin-bottom: 24px;
      white-space: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
      max-width: 100%;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs::-webkit-scrollbar {
      display: none;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs a,
    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs span {
      white-space: nowrap;
      flex-shrink: 0;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs a {
      color: var(--el-pt-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs a:hover {
      color: var(--el-pt-primary);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs span.sep {
      opacity: 0.4;
      padding: 0 2px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs span.current-page {
      max-width: 260px;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--el-pt-dark);
      font-weight: 500;
    }

    /* Main Grid */
    #ellora-prod-tile-{{ section.id }} .el-pt-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 64px;
      align-items: flex-start;
    }

    /* Left: Gallery */
    #ellora-prod-tile-{{ section.id }} .el-pt-gallery {
      display: flex;
      gap: 16px;
      position: sticky;
      top: 100px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-thumbs {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 86px;
      flex-shrink: 0;
      max-height: 580px;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--el-pt-border) transparent;
      padding-right: 4px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--el-pt-border);
      border-radius: 2px;
      overflow: hidden;
      cursor: pointer;
      background: #F0ECE7;
      transition: border-color 0.2s ease, opacity 0.2s ease;
      opacity: 0.7;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-thumb.is-active,
    #ellora-prod-tile-{{ section.id }} .el-pt-thumb:hover {
      border-color: var(--el-pt-primary);
      opacity: 1;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-video-badge {
      position: absolute;
      bottom: 4px;
      right: 4px;
      background: rgba(0, 0, 0, 0.7);
      color: #FFF;
      border-radius: 50%;
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-main-media {
      flex: 1;
      aspect-ratio: 4 / 5;
      background: #F0ECE7;
      border-radius: 2px;
      overflow: hidden;
      border: 1px solid var(--el-pt-border);
      position: relative;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-video-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #111;
      z-index: 2;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-video-player {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border: 0;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-main-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-main-media:hover img {
      transform: scale(1.03);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-wishlist-btn {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(4px);
      border: 1px solid var(--el-pt-border);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--el-pt-dark);
      transition: all 0.2s ease;
      z-index: 10;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-wishlist-btn svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      transition: fill 0.2s, stroke 0.2s;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-wishlist-btn.is-active svg {
      fill: var(--el-pt-primary);
      stroke: var(--el-pt-primary);
    }

    /* Right: Product Info */
    #ellora-prod-tile-{{ section.id }} .el-pt-info {
      display: flex;
      flex-direction: column;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-kicker-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      flex-wrap: nowrap;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-kicker {
      font-size: 11.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-pt-primary);
      flex: 1 1 auto;
      min-width: 0;
      line-height: 1.35;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--el-pt-card);
      border: 1px solid var(--el-pt-border);
      padding: 5px 12px;
      border-radius: 999px;
      color: var(--el-pt-dark);
      white-space: nowrap;
      flex-shrink: 0;
      line-height: 1.2;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 40px;
      font-weight: 400;
      color: var(--el-pt-dark);
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin-bottom: 14px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-price-wrap {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 20px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--el-pt-border);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-price {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 32px;
      font-weight: 500;
      color: var(--el-pt-dark);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-price-unit {
      font-size: 13.5px;
      color: var(--el-pt-muted);
      letter-spacing: 0.04em;
    }

    /* Calculator Widget Box */
    #ellora-prod-tile-{{ section.id }} .el-pt-calc-box {
      background: var(--el-pt-card);
      border: 1px solid var(--el-pt-border);
      border-radius: 2px;
      padding: 22px 24px;
      margin-bottom: 28px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-title {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--el-pt-dark);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-title svg {
      width: 15px;
      height: 15px;
      stroke: var(--el-pt-primary);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-inputs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-input-wrap label {
      display: block;
      font-size: 11.5px;
      color: var(--el-pt-muted);
      margin-bottom: 4px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-input {
      width: 100%;
      background: #FFFFFF;
      border: 1px solid var(--el-pt-border);
      border-radius: 2px;
      padding: 9px 12px;
      font-size: 13.5px;
      font-family: inherit;
      color: var(--el-pt-dark);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--el-pt-muted);
      cursor: pointer;
      margin-bottom: 12px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-checkbox input {
      accent-color: var(--el-pt-primary);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-result {
      background: #FFFFFF;
      border: 1px dashed var(--el-pt-border);
      padding: 10px 14px;
      border-radius: 2px;
      font-size: 13px;
      color: var(--el-pt-dark);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-calc-result strong {
      color: var(--el-pt-primary);
    }

    /* Variant Selectors */
    #ellora-prod-tile-{{ section.id }} .el-pt-variants {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 28px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-option-label {
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-pt-dark);
      margin-bottom: 8px;
      display: block;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-pills-list {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-pill-btn {
      padding: 9px 18px;
      background: #FFFFFF;
      border: 1px solid var(--el-pt-border);
      border-radius: 2px;
      font-size: 13px;
      font-family: inherit;
      color: var(--el-pt-dark);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-pill-btn:hover {
      border-color: var(--el-pt-primary);
      color: var(--el-pt-primary);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-pill-btn.is-active {
      border-color: var(--el-pt-primary);
      background: var(--el-pt-primary);
      color: #FFFFFF;
      font-weight: 600;
      box-shadow: 0 2px 6px rgba(204, 158, 143, 0.25);
    }

    /* Color Swatch Option Buttons */
    #ellora-prod-tile-{{ section.id }} .el-pt-swatches-list {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-swatch-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      background: #FFFFFF;
      border: 1px solid var(--el-pt-border);
      border-radius: 2px;
      cursor: pointer;
      font-family: inherit;
      font-size: 13px;
      color: var(--el-pt-dark);
      transition: all 0.2s ease;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-swatch-btn:hover {
      border-color: var(--el-pt-primary);
      color: var(--el-pt-primary);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-swatch-btn.is-active {
      border-color: var(--el-pt-primary);
      background: rgba(204, 158, 143, 0.08);
      color: var(--el-pt-primary);
      font-weight: 600;
      box-shadow: 0 0 0 1px var(--el-pt-primary);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-swatch-dot {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, 0.15);
      display: inline-block;
      flex-shrink: 0;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.12);
    }

    /* Actions & Stepper */
    #ellora-prod-tile-{{ section.id }} .el-pt-actions-row {
      display: flex;
      gap: 14px;
      align-items: center;
      margin-bottom: 16px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-stepper {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--el-pt-border);
      border-radius: 2px;
      background: #FFFFFF;
      height: 48px;
      width: 120px;
      flex-shrink: 0;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-step-btn {
      width: 36px;
      height: 100%;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 18px;
      color: var(--el-pt-dark);
      font-family: inherit;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-step-input {
      width: 48px;
      height: 100%;
      border: none;
      text-align: center;
      font-size: 14px;
      font-weight: 600;
      color: var(--el-pt-dark);
      background: transparent;
      font-family: inherit;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-add-btn {
      flex: 1;
      height: 48px;
      background: var(--el-pt-primary);
      color: #FFFFFF;
      border: none;
      border-radius: 2px;
      font-family: inherit;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
      padding: 0 16px;
      transition: background 0.2s ease;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-add-btn:hover {
      background: var(--el-pt-primary-hover, #BF8673) !important;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-sample-btn {
      width: 100%;
      height: 48px;
      background: #FFFFFF;
      border: 1.5px solid var(--el-pt-primary, #CC9E8F);
      color: var(--el-pt-primary, #CC9E8F);
      border-radius: 4px;
      font-family: inherit;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 12px;
      margin-bottom: 24px;
      transition: all 0.25s ease;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-sample-btn:hover {
      background: var(--el-pt-primary, #CC9E8F);
      color: #FFFFFF !important;
      box-shadow: 0 4px 14px rgba(204, 158, 143, 0.25);
    }

    /* Sample Consultation Modal */
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(18, 16, 15, 0.65);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-backdrop.is-open {
      opacity: 1;
      visibility: visible;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-dialog {
      background: #FFFFFF;
      max-width: 480px;
      width: 100%;
      border-radius: 4px;
      padding: 36px 32px 30px;
      position: relative;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      transform: translateY(20px);
      transition: transform 0.3s ease;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-backdrop.is-open .el-sample-modal-dialog {
      transform: translateY(0);
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-close {
      position: absolute;
      top: 14px;
      right: 16px;
      background: none;
      border: none;
      font-size: 26px;
      line-height: 1;
      color: #999;
      cursor: pointer;
      padding: 4px 8px;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-close:hover {
      color: #12100f;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-icon {
      width: 56px;
      height: 56px;
      background: #fbf7f4;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #CC9E8F;
      background: #f8f1ee;
      padding: 4px 12px;
      border-radius: 2px;
      margin-bottom: 12px;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-title {
      font-family: var(--el-pt-font-heading, serif);
      font-size: 22px;
      font-weight: 500;
      color: #12100f;
      margin: 0 0 12px;
      line-height: 1.3;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-text {
      font-size: 14px;
      color: #555;
      line-height: 1.6;
      margin: 0 0 10px;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-subtext {
      font-size: 13px;
      color: #777;
      line-height: 1.5;
      margin: 0 0 24px;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 46px;
      background: var(--el-pt-primary, #CC9E8F);
      color: #FFFFFF !important;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: 2px;
      transition: background 0.2s ease;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-btn-primary:hover {
      background: var(--el-pt-primary-hover, #BF8673) !important;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-btn-secondary {
      background: none;
      border: 1px solid #ddd;
      color: #666;
      height: 42px;
      font-size: 13px;
      border-radius: 2px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    #ellora-prod-tile-{{ section.id }} .el-sample-modal-btn-secondary:hover {
      border-color: #CC9E8F;
      color: #CC9E8F;
    }

    /* Pincode & Delivery Checker */
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-card {
      margin-top: 20px;
      margin-bottom: 24px;
      padding: 16px 18px;
      background: var(--el-pt-card-bg, #FAF8F5);
      border: 1px solid var(--el-pt-border, #ECE7E1);
      border-radius: 6px;
      font-family: var(--el-pt-font-sans);
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-header {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--el-pt-dark, #1C1B19);
      margin-bottom: 12px;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-header svg {
      color: var(--el-pt-primary, #CC9E8F);
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-form {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-input {
      flex: 1;
      height: 40px;
      padding: 0 12px;
      border: 1px solid var(--el-pt-border, #ECE7E1);
      border-radius: 4px;
      font-size: 13px;
      font-family: inherit;
      background: #FFFFFF;
      text-transform: uppercase;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-input:focus {
      outline: none;
      border-color: var(--el-pt-primary, #CC9E8F);
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-btn {
      height: 40px;
      padding: 0 16px;
      background: var(--el-pt-primary, #CC9E8F);
      color: #FFFFFF;
      border: none;
      border-radius: 4px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-btn:hover {
      background: var(--el-pt-primary-hover, #BF8673);
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-result {
      font-size: 12.5px;
      padding: 8px 10px;
      border-radius: 4px;
      margin-bottom: 10px;
      line-height: 1.4;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-result.is-valid {
      background: #EBF7EE;
      color: #1E6638;
      border: 1px solid #C3E6CB;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-result.is-invalid {
      background: #FDF2F2;
      color: #A32727;
      border: 1px solid #F8D7DA;
    }
    #ellora-prod-tile-{{ section.id }} .el-pt-pincode-notes {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 11.5px;
      color: var(--el-pt-muted, #68645F);
    }

    /* Specifications Table */
    #ellora-prod-tile-{{ section.id }} .el-pt-specs-card {
      border-top: 1px solid var(--el-pt-border);
      padding-top: 24px;
      margin-bottom: 24px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-specs-title {
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-pt-dark);
      margin-bottom: 14px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-specs-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
      font-size: 13px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-spec-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-spec-label {
      color: var(--el-pt-muted);
      font-size: 11.5px;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-spec-val {
      color: var(--el-pt-dark);
      font-weight: 500;
    }

    /* Accordions */
    #ellora-prod-tile-{{ section.id }} .el-pt-acc-list {
      border-top: 1px solid var(--el-pt-border);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-acc-item {
      border-bottom: 1px solid var(--el-pt-border);
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-acc-trigger {
      width: 100%;
      padding: 16px 0;
      background: none;
      border: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      color: var(--el-pt-dark);
      text-align: left;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-acc-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
      font-size: 13.5px;
      color: var(--el-pt-muted);
      line-height: 1.65;
    }

    #ellora-prod-tile-{{ section.id }} .el-pt-acc-item.is-open .el-pt-acc-body {
      max-height: 400px;
      padding-bottom: 18px;
    }

    @media (max-width: 900px) {
      #ellora-prod-tile-{{ section.id }} .el-pt-grid {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-gallery {
        position: static;
        flex-direction: column-reverse;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-thumbs {
        flex-direction: row;
        width: 100%;
        overflow-x: auto;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-thumb {
        width: 70px;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-title {
        font-size: 32px;
      }
    }

    @media (max-width: 600px) {
      #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs {
        font-size: 11px;
        gap: 6px;
        margin-bottom: 18px;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-breadcrumbs span.current-page {
        max-width: 170px;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-kicker-row {
        gap: 8px;
        margin-bottom: 10px;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-kicker {
        font-size: 10.5px;
        letter-spacing: 0.12em;
      }
      #ellora-prod-tile-{{ section.id }} .el-pt-badge {
        font-size: 10px;
        padding: 4px 10px;
        letter-spacing: 0.05em;
      }
    }
  </style>

  {%- assign is_mural = false -%}
  {%- assign prod_title_down = product.title | default: '' | downcase -%}
  {%- assign prod_type_down = product.type | default: '' | downcase -%}
  {%- if prod_title_down contains 'mural' or prod_type_down contains 'mural' or prod_title_down contains 'wallpaper' or prod_type_down contains 'wallpaper' or section.settings.enable_mural_mode -%}
    {%- assign is_mural = true -%}
  {%- endif -%}
  {%- for tag in product.tags -%}
    {%- assign tag_down = tag | downcase -%}
    {%- if tag_down contains 'mural' or tag_down contains 'mural set' or tag_down contains 'wallpaper' -%}
      {%- assign is_mural = true -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="el-pt-container">

    <!-- Breadcrumbs -->
    <div class="el-pt-breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep">/</span>
      {%- if is_mural -%}
        <a href="/collections/all?filter=wallpaper">Wallpapers &amp; Murals</a>
      {%- else -%}
        <a href="/collections/all">Tiles &amp; Stone</a>
      {%- endif -%}
      <span class="sep">/</span>
      <span class="current-page">{{ product.title | default: 'Roman Travertine Honed Slab' }}</span>
    </div>

    <div class="el-pt-grid">

      <!-- Left: Gallery (Strict 4 Images + 1 Video at Last) -->
      {%- assign pt_img_count = 0 -%}
      {%- assign pt_prod_video = nil -%}
      {%- for media in product.media -%}
        {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
          {%- if pt_prod_video == nil -%}
            {%- assign pt_prod_video = media -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if pt_prod_video == nil and product.metafields.custom.video != blank -%}
        {%- assign pt_prod_video = product.metafields.custom.video -%}
      {%- endif -%}

      <div class="el-pt-gallery">
        <div class="el-pt-thumbs">
          {%- if product.media.size > 0 or product.images.size > 0 -%}
            {%- comment -%} 1. Render exactly up to 4 Images first {%- endcomment -%}
            {%- for media in product.media -%}
              {%- if media.media_type != 'video' and media.media_type != 'external_video' -%}
                {%- if pt_img_count < 4 -%}
                  {%- assign pt_img_count = pt_img_count | plus: 1 -%}
                  <div class="el-pt-thumb {% if pt_img_count == 1 %}is-active{% endif %}" 
                       data-media-id="{{ media.id }}" 
                       data-media-type="image" 
                       data-src="{{ media.preview_image | default: media | image_url: width: 1400 }}">
                    <img src="{{ media.preview_image | default: media | image_url: width: 180 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if pt_img_count == 0 and product.images.size > 0 -%}
              {%- for image in product.images limit: 4 -%}
                {%- assign pt_img_count = pt_img_count | plus: 1 -%}
                <div class="el-pt-thumb {% if pt_img_count == 1 %}is-active{% endif %}" 
                     data-media-type="image" 
                     data-src="{{ image | image_url: width: 1400 }}">
                  <img src="{{ image | image_url: width: 180 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
                </div>
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%} 2. Render 1 Video strictly as the LAST item (Position 5) {%- endcomment -%}
            {%- if pt_prod_video != nil -%}
              <div class="el-pt-thumb el-pt-thumb-video" 
                   data-media-id="video-{{ section.id }}" 
                   data-media-type="video" 
                   data-src="{{ pt_prod_video.preview_image | default: product.featured_image | image_url: width: 1400 }}"
                   title="Play Product Video">
                <img src="{{ pt_prod_video.preview_image | default: product.featured_image | image_url: width: 180 }}" alt="{{ product.title | escape }} Video" loading="lazy">
                <span class="el-pt-video-badge" aria-label="Video">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                </span>
              </div>
            {%- endif -%}
          {%- else -%}
            {%- comment -%} Fallback Demo: 4 Images + 1 Video {%- endcomment -%}
            <div class="el-pt-thumb is-active" data-media-type="image" data-src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1200&auto=format&fit=crop">
              <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=160&auto=format&fit=crop" alt="Demo Tile 1">
            </div>
            <div class="el-pt-thumb" data-media-type="image" data-src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=1200&auto=format&fit=crop">
              <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=160&auto=format&fit=crop" alt="Demo Tile 2">
            </div>
            <div class="el-pt-thumb" data-media-type="image" data-src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1200&auto=format&fit=crop">
              <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=160&auto=format&fit=crop" alt="Demo Tile 3">
            </div>
            <div class="el-pt-thumb" data-media-type="image" data-src="https://images.unsplash.com/photo-1600565193348-f74bd3c7ccdf?q=80&w=1200&auto=format&fit=crop">
              <img src="https://images.unsplash.com/photo-1600565193348-f74bd3c7ccdf?q=80&w=160&auto=format&fit=crop" alt="Demo Tile 4">
            </div>
            <div class="el-pt-thumb el-pt-thumb-video" data-media-type="video" data-src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1200&auto=format&fit=crop" title="Product Video">
              <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=160&auto=format&fit=crop" alt="Demo Video">
              <span class="el-pt-video-badge" aria-label="Video">
                <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              </span>
            </div>
          {%- endif -%}
        </div>

        <div class="el-pt-main-media">
          <img id="elPtMainImage-{{ section.id }}" 
               src="{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 }}{% else %}https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1200&auto=format&fit=crop{% endif %}" 
               alt="{{ product.title | default: 'Roman Travertine Honed Slab' | escape }}" 
               loading="eager">

          <div id="elPtVideoWrap-{{ section.id }}" class="el-pt-video-wrap" style="display: none;">
            {%- if pt_prod_video != nil -%}
              {%- if pt_prod_video.media_type == 'video' -%}
                {{ pt_prod_video | video_tag: controls: true, autoplay: false, loop: true, playsinline: true, preload: 'metadata', class: 'el-pt-video-player' }}
              {%- elsif pt_prod_video.media_type == 'external_video' -%}
                {{ pt_prod_video | external_video_tag: class: 'el-pt-video-player' }}
              {%- elsif product.metafields.custom.video != blank -%}
                <video class="el-pt-video-player" controls loop playsinline preload="metadata">
                  <source src="{{ product.metafields.custom.video }}" type="video/mp4">
                </video>
              {%- endif -%}
            {%- endif -%}
          </div>

          <button type="button" class="el-pt-wishlist-btn" 
                  data-product-id="{{ product.id | default: 'demo-tile' }}" 
                  data-product-title="{{ product.title | default: 'Roman Travertine Honed Slab' | escape }}" 
                  data-product-price="{% if product.price %}{{ product.price | money }}{% else %}$125.00{% endif %}"
                  data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% else %}https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=400&auto=format&fit=crop{% endif %}"
                  aria-label="Add to Wishlist">
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          </button>
        </div>
      </div>

      <!-- Right: Product Info -->
      <div class="el-pt-info">

        <div class="el-pt-kicker-row">
          <span class="el-pt-kicker">{{ section.settings.kicker | default: 'NATURAL STONE & ARCHITECTURAL TILES' }}</span>
          <span class="el-pt-badge">
            {%- if is_mural -%}
              {{ section.settings.mural_badge | default: 'Full Mural Set' }}
            {%- else -%}
              {{ section.settings.selling_badge | default: 'Sold per M²' }}
            {%- endif -%}
          </span>
        </div>

        <h1 class="el-pt-title">{{ product.title | default: 'Roman Travertine Honed Slab' }}</h1>

        <div class="el-pt-price-wrap">
          <span class="el-pt-price" id="elPtPrice-{{ section.id }}">
            {% if product.price %}{{ product.price | money }}{% else %}$125.00{% endif %}
          </span>
          <span class="el-pt-price-unit">
            {%- if is_mural -%}
              {{ section.settings.mural_price_unit | default: '/ Complete Set' }}
            {%- else -%}
              {{ section.settings.price_unit | default: '/ M² (ex. freight)' }}
            {%- endif -%}
          </span>
        </div>

        {%- if is_mural -%}
          <!-- Built-in Mural Set Selector & Panel Guide -->
          <div class="el-pt-calc-box el-pt-mural-box">
            <div class="el-pt-calc-header">
              <span class="el-pt-calc-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
                Mural Set Selection Guide
              </span>
              <span style="font-size: 11px; color: var(--el-pt-primary); font-weight: 600;">Ordered in Complete Sets</span>
            </div>
            <p class="el-pt-mural-note" style="font-size: 13px; line-height: 1.55; color: #58544E; margin: 0 0 12px 0;">
              This surface is supplied as an architectural <strong>Mural Set</strong> consisting of precision-matched sequential panels (Panels A, B, C...). Each set completes the full artwork.
            </p>
            <div class="el-pt-calc-inputs">
              <div class="el-pt-calc-input-wrap">
                <label for="elMuralSetQty">Quantity (Sets)</label>
                <input type="number" id="elMuralSetQty" class="el-pt-calc-input" min="1" step="1" value="1">
              </div>
              <div class="el-pt-calc-input-wrap">
                <label>Set Composition</label>
                <input type="text" class="el-pt-calc-input" value="Complete Art Sequence" readonly>
              </div>
            </div>
            <div class="el-pt-calc-result" id="elMuralCalcResult">
              <span>Ordering: <strong id="elMuralSetCount">1 Set</strong> (Complete Mural)</span>
              <span id="elMuralCalcCost"></span>
            </div>
          </div>
        {%- elsif section.settings.show_calculator -%}
          <!-- Built-in Tile Area & Wastage Calculator -->
          <div class="el-pt-calc-box">
            <div class="el-pt-calc-header">
              <span class="el-pt-calc-title">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
                Tile Area &amp; Wastage Estimator
              </span>
              <span style="font-size: 11px; color: var(--el-pt-muted);">Auto-sets quantity</span>
            </div>

            <div class="el-pt-calc-inputs">
              <div class="el-pt-calc-input-wrap">
                <label for="elTileAreaM2">Room Area (M²)</label>
                <input type="number" id="elTileAreaM2" class="el-pt-calc-input" placeholder="e.g. 15" min="1" step="0.5" value="12">
              </div>
              <div class="el-pt-calc-input-wrap">
                <label for="elTileBoxSize">Box Size (M²)</label>
                <input type="number" id="elTileBoxSize" class="el-pt-calc-input" value="{{ section.settings.box_size | default: 1.44 }}" step="0.01" readonly>
              </div>
            </div>

            <label class="el-pt-calc-checkbox">
              <input type="checkbox" id="elTileWastageCheck" checked>
              <span>Add 15% allowance for cuts, corner trimming &amp; pattern blending</span>
            </label>

            <div class="el-pt-calc-result" id="elTileCalcResult">
              <span>Required: <strong>10 boxes</strong> (14.4 M²)</span>
              <span id="elTileCalcCost">Approx. $1,800.00</span>
            </div>
          </div>
        {%- endif -%}

        <!-- Dynamic Variant Options -->
        <div class="el-pt-variants" id="elPtOptions-{{ section.id }}">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_name_down = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if opt_name_down contains 'color' or opt_name_down contains 'colour' -%}
                {%- assign is_color = true -%}
              {%- endif -%}

              <div class="el-pt-option-group" data-option-index="{{ forloop.index0 }}" style="margin-bottom: 18px;">
                <div class="el-pt-opt-header" style="display:flex; align-items:baseline; gap:6px; margin-bottom:8px;">
                  <span class="el-pt-option-label" style="margin-bottom:0;">{{ option.name }}</span>
                  <span class="el-pt-opt-selected" data-header-val="{{ forloop.index0 }}" style="font-size:13px; font-weight:600; color:var(--el-pt-primary);">: {{ option.selected_value }}</span>
                </div>

                {%- if is_color -%}
                  <div class="el-pt-swatches-list">
                    {%- for value in option.values -%}
                      {%- assign val_low = value | downcase -%}
                      {%- assign swatch_color = '#d8c7b5' -%}
                      {%- if val_low contains 'ivory' or val_low contains 'white' -%}{%- assign swatch_color = '#F5F2EB' -%}
                      {%- elsif val_low contains 'beige' or val_low contains 'sand' or val_low contains 'travertine' -%}{%- assign swatch_color = '#D8C7B5' -%}
                      {%- elsif val_low contains 'burgundy' or val_low contains 'wine' -%}{%- assign swatch_color = '#6A2B35' -%}
                      {%- elsif val_low contains 'rose' or val_low contains 'pink' or val_low contains 'blush' -%}{%- assign swatch_color = '#C89D91' -%}
                      {%- elsif val_low contains 'anthracite' or val_low contains 'charcoal' -%}{%- assign swatch_color = '#2E2D2B' -%}
                      {%- elsif val_low contains 'slate' or val_low contains 'grey' or val_low contains 'gray' or val_low contains 'concrete' -%}{%- assign swatch_color = '#7E8082' -%}
                      {%- elsif val_low contains 'emerald' -%}{%- assign swatch_color = '#1B4D3E' -%}
                      {%- elsif val_low contains 'olive' or val_low contains 'cypress' -%}{%- assign swatch_color = '#4B5320' -%}
                      {%- elsif val_low contains 'sage' -%}{%- assign swatch_color = '#9CAF88' -%}
                      {%- elsif val_low contains 'green' -%}{%- assign swatch_color = '#2D5A43' -%}
                      {%- elsif val_low contains 'cream' or val_low contains 'bone' or val_low contains 'calacatta' -%}{%- assign swatch_color = '#FDF6E2' -%}
                      {%- elsif val_low contains 'black' or val_low contains 'nero' -%}{%- assign swatch_color = '#1E1B18' -%}
                      {%- elsif val_low contains 'terracotta' or val_low contains 'cotto' or val_low contains 'sienna' -%}{%- assign swatch_color = '#CC9E8F' -%}
                      {%- elsif val_low contains 'ochre' or val_low contains 'mustard' or val_low contains 'gold' -%}{%- assign swatch_color = '#C4823F' -%}
                      {%- elsif val_low contains 'silver' -%}{%- assign swatch_color = '#C5C6C7' -%}
                      {%- elsif val_low contains 'walnut' or val_low contains 'wood' or val_low contains 'brown' -%}{%- assign swatch_color = '#5C4033' -%}
                      {%- elsif val_low contains 'sepia' or val_low contains 'taupe' -%}{%- assign swatch_color = '#7F675B' -%}
                      {%- elsif val_low contains 'indigo' or val_low contains 'navy' or val_low contains 'midnight' -%}{%- assign swatch_color = '#1E293B' -%}
                      {%- elsif val_low contains 'blue' -%}{%- assign swatch_color = '#8BAAC1' -%}
                      {%- elsif val_low contains 'sisal' or val_low contains 'jute' or val_low contains 'natural' -%}{%- assign swatch_color = '#C7B198' -%}
                      {%- endif -%}

                      <button type="button" 
                              class="el-pt-pill-btn el-pt-swatch-btn {% if option.selected_value == value %}is-active{% endif %}" 
                              data-option-index="{{ forloop.parentloop.index0 }}" 
                              data-value="{{ value | escape }}"
                              title="{{ value | escape }}">
                        <span class="el-pt-swatch-dot" style="background-color: {{ swatch_color }};"></span>
                        <span class="el-pt-swatch-name">{{ value }}</span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="el-pt-pills-list">
                    {%- for value in option.values -%}
                      <button type="button" 
                              class="el-pt-pill-btn {% if option.selected_value == value %}is-active{% endif %}" 
                              data-option-index="{{ forloop.parentloop.index0 }}" 
                              data-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Static Variant Options -->
            <div class="el-pt-option-group" data-option-index="0" style="margin-bottom: 18px;">
              <div class="el-pt-opt-header" style="display:flex; align-items:baseline; gap:6px; margin-bottom:8px;">
                <span class="el-pt-option-label" style="margin-bottom:0;">Select Dimensions</span>
                <span class="el-pt-opt-selected" data-header-val="0" style="font-size:13px; font-weight:600; color:var(--el-pt-primary);">: 600 x 600 mm</span>
              </div>
              <div class="el-pt-pills-list">
                <button type="button" class="el-pt-pill-btn is-active" data-option-index="0" data-value="600 x 600 mm">600 x 600 mm</button>
                <button type="button" class="el-pt-pill-btn" data-option-index="0" data-value="1200 x 600 mm">1200 x 600 mm</button>
                <button type="button" class="el-pt-pill-btn" data-option-index="0" data-value="300 x 150 mm">300 x 150 mm</button>
              </div>
            </div>
          {%- endunless -%}
        </div>

        <!-- Hidden Native Variant Select for Shopify Cart -->
        <select name="id" id="elTileMasterSelect-{{ section.id }}" style="display: none;">
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}"
              {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}
              data-price="{% if variant.price %}{{ variant.price | money }}{% endif %}"
              data-price-raw="{{ variant.price }}"
              data-available="{{ variant.available }}"
              data-opt1="{{ variant.option1 | escape }}"
              data-opt2="{{ variant.option2 | escape }}"
              data-opt3="{{ variant.option3 | escape }}"
              data-img="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 }}{% endif %}">
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>

        <!-- Purchase Actions -->
        <div class="el-pt-actions-row">
          <div class="el-pt-stepper">
            <button type="button" class="el-pt-step-btn" id="elTileMinus">&minus;</button>
            <input type="number" id="elTileQty" class="el-pt-step-input" value="{% if is_mural %}1{% else %}10{% endif %}" min="1">
            <button type="button" class="el-pt-step-btn" id="elTilePlus">&plus;</button>
          </div>
          {%- if is_mural -%}
            <span class="el-pt-qty-unit-label" style="font-size: 12.5px; font-weight: 600; color: var(--el-pt-muted); letter-spacing: 0.04em;">SET(S)</span>
          {%- endif -%}

          <button type="button" class="el-pt-add-btn" id="elTileAddToCart">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>
            {%- if is_mural -%}Add Set to Cart{%- else -%}Add to Cart{%- endif -%}
          </button>
        </div>

        <!-- Sample Order Swatch Action -->
        <button type="button" class="el-pt-sample-btn" id="elTileOrderSample" 
                data-product-id="{{ product.id }}" 
                data-product-title="{{ product.title | escape }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          Order a Free Sample Swatch &mdash; Complimentary
        </button>

        <!-- Pincode / Postal Delivery Checker -->
        <div class="el-pt-pincode-card">
          <div class="el-pt-pincode-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Delivery &amp; Pincode Check</span>
          </div>
          <div class="el-pt-pincode-form">
            <input type="text" id="elPincodeInput-{{ section.id }}" class="el-pt-pincode-input" placeholder="Enter postal code / pincode" maxlength="10">
            <button type="button" id="elPincodeCheckBtn-{{ section.id }}" class="el-pt-pincode-btn">Check</button>
          </div>
          <div id="elPincodeResult-{{ section.id }}" class="el-pt-pincode-result" style="display: none;"></div>
          <div class="el-pt-pincode-notes">
            <span>✓ Kerbside specialist pallet delivery across UK &amp; International</span>
            <span>✓ Complimentary 1-on-1 material consultations available</span>
          </div>
        </div>

        <!-- Architectural Specifications Table -->
        <div class="el-pt-specs-card">
          <h3 class="el-pt-specs-title">Material Specifications</h3>
          <div class="el-pt-specs-grid">
            <div class="el-pt-spec-item">
              <span class="el-pt-spec-label">Material Family</span>
              <span class="el-pt-spec-val">{{ section.settings.spec_material | default: 'Natural Roman Travertine' }}</span>
            </div>
            <div class="el-pt-spec-item">
              <span class="el-pt-spec-label">Surface Finish</span>
              <span class="el-pt-spec-val">{{ section.settings.spec_finish | default: 'Honed Matte (Non-reflective)' }}</span>
            </div>
            <div class="el-pt-spec-item">
              <span class="el-pt-spec-label">Thickness</span>
              <span class="el-pt-spec-val">{{ section.settings.spec_thickness | default: '15 mm Solid Calibrated' }}</span>
            </div>
            <div class="el-pt-spec-item">
              <span class="el-pt-spec-label">Edge Treatment</span>
              <span class="el-pt-spec-val">{{ section.settings.spec_edge | default: 'Micro-Beveled Rectified' }}</span>
            </div>
            <div class="el-pt-spec-item">
              <span class="el-pt-spec-label">Slip Resistance</span>
              <span class="el-pt-spec-val">{{ section.settings.spec_slip | default: 'R10 / P3 (Wet Room Suitable)' }}</span>
            </div>
            <div class="el-pt-spec-item">
              <span class="el-pt-spec-label">Underfloor Heating</span>
              <span class="el-pt-spec-val">100% Compatible</span>
            </div>
          </div>
        </div>

        <!-- Accordions -->
        <div class="el-pt-acc-list">
          <div class="el-pt-acc-item is-open">
            <button type="button" class="el-pt-acc-trigger">
              <span>Installation, Substrate &amp; Sealing</span>
              <span>&plus;</span>
            </button>
            <div class="el-pt-acc-body">
              <p>Natural travertine is porous and must be installed using a flexible white polymer-modified adhesive. Prior to grouting and once fixed, apply a breathable penetrating impregnator to protect against staining while retaining authentic natural vapor permeability.</p>
            </div>
          </div>

          <div class="el-pt-acc-item">
            <button type="button" class="el-pt-acc-trigger">
              <span>Pallet Freight &amp; Delivery</span>
              <span>&plus;</span>
            </button>
            <div class="el-pt-acc-body">
              <p>Dispatched in timber pallet crates via an 18-tonne lorry with tail-lift curb-side offload. Our driver calls 24 hours ahead to schedule your delivery appointment. All orders are backed by our 48-hour transit breakage coverage guarantee.</p>
            </div>
          </div>

          <div class="el-pt-acc-item">
            <button type="button" class="el-pt-acc-trigger">
              <span>Authentic Geological Variations</span>
              <span>&plus;</span>
            </button>
            <div class="el-pt-acc-body">
              <p>Each tile carries organic markings, tonal shifts, and unique fossil structures formed over thousands of years. We recommend dry-laying several crates prior to fixing to achieve a balanced, harmonious distribution of natural veining.</p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Sample Unavailable / Consultation Modal -->
  <div class="el-sample-modal-backdrop" id="elSampleModal-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="el-sample-modal-dialog">
      <button type="button" class="el-sample-modal-close" aria-label="Close modal">&times;</button>
      <div class="el-sample-modal-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#CC9E8F" stroke-width="1.8">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <span class="el-sample-modal-badge">Sample Consultation Notice</span>
      <h3 class="el-sample-modal-title">Physical Samples Notice</h3>
      <p class="el-sample-modal-text">
        Physical swatch samples for <strong>{{ product.title | escape }}</strong> are currently in high demand and being prepared for our next dispatch cycle.
      </p>
      <p class="el-sample-modal-subtext">
        To inspect this surface material, examine live batch variations, and consult on room measurements with an architectural specialist, please schedule a complimentary 1-on-1 meeting.
      </p>
      <div class="el-sample-modal-actions">
        <a href="/pages/contact?subject=Schedule+Sample+Consultation+-+{{ product.title | url_encode }}" class="el-sample-modal-btn-primary">
          Schedule a Meeting
        </a>
        <button type="button" class="el-sample-modal-btn-secondary">
          Continue Browsing
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var root = document.getElementById('ellora-prod-tile-{{ section.id }}');
    if (!root) return;

    // Gallery Thumbnail Switching (4 Images + 1 Video at Last)
    var thumbs = root.querySelectorAll('.el-pt-thumb');
    var mainImg = document.getElementById('elPtMainImage-{{ section.id }}');
    var videoWrap = document.getElementById('elPtVideoWrap-{{ section.id }}');
    var videoEl = videoWrap ? videoWrap.querySelector('video') : null;

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        thumbs.forEach(function(t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');

        var mediaType = thumb.getAttribute('data-media-type');
        if (mediaType === 'video') {
          if (mainImg) mainImg.style.display = 'none';
          if (videoWrap) {
            videoWrap.style.display = 'block';
            if (videoEl) {
              videoEl.currentTime = 0;
              videoEl.play().catch(function() {});
            }
          }
        } else {
          if (videoWrap) {
            videoWrap.style.display = 'none';
            if (videoEl) videoEl.pause();
          }
          if (mainImg) {
            mainImg.style.display = 'block';
            mainImg.src = thumb.getAttribute('data-src');
          }
        }
      });
    });

    // Dynamic Variant Pill Selection
    var masterSelect = root.querySelector('#elTileMasterSelect-{{ section.id }}');
    var priceDisplay = root.querySelector('.el-pt-price');
    var currentVariantId = {{ product.selected_or_first_available_variant.id | default: 0 }};

    function updateMatchedVariant() {
      if (!masterSelect) return;
      var optionGroups = root.querySelectorAll('.el-pt-option-group');
      var selectedVals = [];
      optionGroups.forEach(function(group) {
        var active = group.querySelector('.el-pt-pill-btn.is-active');
        selectedVals.push(active ? active.getAttribute('data-value') : '');
      });

      var matchedOpt = null;
      for (var i = 0; i < masterSelect.options.length; i++) {
        var opt = masterSelect.options[i];
        var o1 = opt.getAttribute('data-opt1') || '';
        var o2 = opt.getAttribute('data-opt2') || '';
        var o3 = opt.getAttribute('data-opt3') || '';

        var matches = true;
        if (selectedVals[0] !== undefined && o1 !== selectedVals[0]) matches = false;
        if (selectedVals[1] !== undefined && o2 !== selectedVals[1]) matches = false;
        if (selectedVals[2] !== undefined && o3 !== selectedVals[2]) matches = false;

        if (matches) {
          matchedOpt = opt;
          break;
        }
      }

      if (matchedOpt) {
        masterSelect.value = matchedOpt.value;
        currentVariantId = parseInt(matchedOpt.value, 10);

        var pText = matchedOpt.getAttribute('data-price');
        if (pText && priceDisplay) {
          priceDisplay.textContent = pText;
        }

        var isAvail = matchedOpt.getAttribute('data-available') === 'true';
        if (addBtn) {
          if (isAvail) {
            addBtn.removeAttribute('disabled');
            addBtn.style.opacity = '1';
            addBtn.style.pointerEvents = 'auto';
            addBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg> Add to Cart';
          } else {
            addBtn.setAttribute('disabled', 'disabled');
            addBtn.style.opacity = '0.5';
            addBtn.style.pointerEvents = 'none';
            addBtn.textContent = 'Sold Out';
          }
        }

        var vImg = matchedOpt.getAttribute('data-img');
        if (vImg && mainImg) {
          mainImg.src = vImg;
        }

        if (muralSetInput) { calculateMuralSets(); } else { calculateTiles(); }
      }
    }

    root.querySelectorAll('.el-pt-pill-btn').forEach(function(pill) {
      pill.addEventListener('click', function(e) {
        e.preventDefault();
        var group = pill.closest('.el-pt-option-group');
        if (!group) return;

        group.querySelectorAll('.el-pt-pill-btn').forEach(function(p) {
          p.classList.remove('is-active');
        });
        pill.classList.add('is-active');

        var labelDisplay = group.querySelector('[data-header-val]');
        if (labelDisplay) {
          labelDisplay.textContent = ': ' + pill.getAttribute('data-value');
        }

        updateMatchedVariant();
      });
    });

    // Tile Area Calculator Logic
    var areaInput = root.querySelector('#elTileAreaM2');
    var boxInput = root.querySelector('#elTileBoxSize');
    var wastageCheck = root.querySelector('#elTileWastageCheck');
    var qtyInput = root.querySelector('#elTileQty');
    var resultText = root.querySelector('#elTileCalcResult');
    var costText = root.querySelector('#elTileCalcCost');

    // Mural Set Selection elements
    var muralSetInput = root.querySelector('#elMuralSetQty');
    var muralSetCount = root.querySelector('#elMuralSetCount');
    var muralCalcCost = root.querySelector('#elMuralCalcCost');

    function calculateTiles() {
      var area = parseFloat(areaInput ? areaInput.value : 12) || 0;
      var boxSize = parseFloat(boxInput ? boxInput.value : 1.44) || 1.44;
      var hasWastage = wastageCheck ? wastageCheck.checked : true;

      var totalArea = hasWastage ? (area * 1.15) : area;
      var boxesNeeded = Math.ceil(totalArea / boxSize);
      if (boxesNeeded < 1) boxesNeeded = 1;

      var actualArea = (boxesNeeded * boxSize).toFixed(1);

      if (qtyInput) qtyInput.value = boxesNeeded;
      if (resultText) {
        resultText.querySelector('strong').textContent = boxesNeeded + ' boxes (' + actualArea + ' M²)';
      }
      if (costText) {
        var unitPrice = masterSelect && masterSelect.selectedOptions && masterSelect.selectedOptions[0] ? (parseFloat(masterSelect.selectedOptions[0].getAttribute('data-price-raw')) / 100) : {{ product.price | default: 14500 | divided_by: 100.0 }};
        costText.textContent = 'Approx. {{ cart.currency.symbol }}' + (boxesNeeded * boxSize * (unitPrice || 145.00)).toFixed(2);
      }
    }

    function calculateMuralSets() {
      var sets = parseInt(muralSetInput ? muralSetInput.value : 1, 10) || 1;
      if (sets < 1) sets = 1;
      if (muralSetInput) muralSetInput.value = sets;
      if (qtyInput) qtyInput.value = sets;
      if (muralSetCount) {
        muralSetCount.textContent = sets + (sets === 1 ? ' Set' : ' Sets') + ' (Complete Mural)';
      }
      if (muralCalcCost) {
        var setPrice = masterSelect && masterSelect.selectedOptions && masterSelect.selectedOptions[0] ? (parseFloat(masterSelect.selectedOptions[0].getAttribute('data-price-raw')) / 100) : {{ product.price | default: 14500 | divided_by: 100.0 }};
        muralCalcCost.textContent = 'Total: {{ cart.currency.symbol }}' + (sets * (setPrice || 145.00)).toFixed(2);
      }
    }

    if (areaInput) areaInput.addEventListener('input', calculateTiles);
    if (wastageCheck) wastageCheck.addEventListener('change', calculateTiles);

    if (muralSetInput) {
      muralSetInput.addEventListener('input', calculateMuralSets);
      muralSetInput.addEventListener('change', calculateMuralSets);
      calculateMuralSets();
    }

    // Quantity Stepper
    var minusBtn = root.querySelector('#elTileMinus');
    var plusBtn = root.querySelector('#elTilePlus');
    if (minusBtn && qtyInput) {
      minusBtn.addEventListener('click', function() {
        var v = parseInt(qtyInput.value, 10) || 1;
        if (v > 1) {
          qtyInput.value = v - 1;
          if (muralSetInput) {
            muralSetInput.value = v - 1;
            calculateMuralSets();
          }
        }
      });
    }
    if (plusBtn && qtyInput) {
      plusBtn.addEventListener('click', function() {
        var v = parseInt(qtyInput.value, 10) || 1;
        qtyInput.value = v + 1;
        if (muralSetInput) {
          muralSetInput.value = v + 1;
          calculateMuralSets();
        }
      });
    }

    // Accordions
    var accTriggers = root.querySelectorAll('.el-pt-acc-trigger');
    accTriggers.forEach(function(trig) {
      trig.addEventListener('click', function() {
        var item = trig.closest('.el-pt-acc-item');
        item.classList.toggle('is-open');
      });
    });

    // Sample Order Swatch Action -> Open Meeting / Consultation Modal
    var sampleBtn = root.querySelector('#elTileOrderSample');
    var sampleModal = document.getElementById('elSampleModal-{{ section.id }}');
    if (sampleBtn && sampleModal) {
      var sampleModalClose = sampleModal.querySelector('.el-sample-modal-close');
      var sampleModalSecondary = sampleModal.querySelector('.el-sample-modal-btn-secondary');

      function openSampleModal() {
        sampleModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeSampleModal() {
        sampleModal.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      sampleBtn.addEventListener('click', openSampleModal);
      if (sampleModalClose) sampleModalClose.addEventListener('click', closeSampleModal);
      if (sampleModalSecondary) sampleModalSecondary.addEventListener('click', closeSampleModal);

      sampleModal.addEventListener('click', function(e) {
        if (e.target === sampleModal) {
          closeSampleModal();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && sampleModal.classList.contains('is-open')) {
          closeSampleModal();
        }
      });
    }

    // Pincode / Postal Delivery Checker
    var pincodeInput = root.querySelector('#elPincodeInput-{{ section.id }}');
    var pincodeBtn = root.querySelector('#elPincodeCheckBtn-{{ section.id }}');
    var pincodeResult = root.querySelector('#elPincodeResult-{{ section.id }}');

    if (pincodeBtn && pincodeInput && pincodeResult) {
      function checkPincode() {
        var val = pincodeInput.value.trim();
        if (!val || val.length < 3) {
          pincodeResult.className = 'el-pt-pincode-result is-invalid';
          pincodeResult.textContent = 'Please enter a valid postal code or pincode.';
          pincodeResult.style.display = 'block';
          return;
        }
        pincodeResult.className = 'el-pt-pincode-result is-valid';
        pincodeResult.innerHTML = '<strong>Standard Pallet Delivery Available to ' + val.toUpperCase() + '</strong><br>Estimated Dispatch: 2–3 business days. Specialist kerbside delivery.';
        pincodeResult.style.display = 'block';
      }
      pincodeBtn.addEventListener('click', checkPincode);
      pincodeInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          checkPincode();
        }
      });
    }

    // Add to Cart
    var addBtn = root.querySelector('#elTileAddToCart');
    if (addBtn) {
      addBtn.addEventListener('click', function() {
        addBtn.textContent = 'Adding...';
        // Add via AJAX
        var variantId = currentVariantId || {{ product.selected_or_first_available_variant.id | default: 0 }};
        var qty = parseInt(qtyInput ? qtyInput.value : 1, 10);

        if (!variantId) {
          setTimeout(function() {
            addBtn.innerHTML = '&#10003; Added to Cart';
            window.dispatchEvent(new CustomEvent('ellora:cart:open'));
            setTimeout(function() { addBtn.innerHTML = 'Add to Cart'; }, 2000);
          }, 400);
          return;
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: qty })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          addBtn.innerHTML = '&#10003; Added to Cart';
          window.dispatchEvent(new CustomEvent('ellora:cart:refresh'));
          window.dispatchEvent(new CustomEvent('ellora:cart:open'));
          setTimeout(function() { addBtn.innerHTML = 'Add to Cart'; }, 2000);
        })
        .catch(function(err) {
          console.error(err);
          addBtn.innerHTML = 'Add to Cart';
        });
      });
    }

    // Wishlist Toggle
    var wishBtn = root.querySelector('.el-pt-wishlist-btn');
    if (wishBtn) {
      var prodId = wishBtn.getAttribute('data-product-id');
      try {
        var list = JSON.parse(localStorage.getItem('ellora_wishlist') || '[]');
        if (list.some(function(x) { return x.id === prodId; })) {
          wishBtn.classList.add('is-active');
        }
      } catch(e){}

      wishBtn.addEventListener('click', function() {
        var list = JSON.parse(localStorage.getItem('ellora_wishlist') || '[]');
        var idx = list.findIndex(function(x) { return x.id === prodId; });
        if (idx > -1) {
          list.splice(idx, 1);
          wishBtn.classList.remove('is-active');
        } else {
          list.push({
            id: prodId,
            title: wishBtn.getAttribute('data-product-title'),
            price: wishBtn.getAttribute('data-product-price'),
            image: wishBtn.getAttribute('data-product-image'),
            url: window.location.pathname
          });
          wishBtn.classList.add('is-active');
        }
        localStorage.setItem('ellora_wishlist', JSON.stringify(list));
        window.dispatchEvent(new CustomEvent('ellora:wishlist:updated'));
      });
    }

  })();
</script>


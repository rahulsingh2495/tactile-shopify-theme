{% comment %}
  ==========================================================================
  ELLORA SPACES — TRADE APPLICATION FORM SECTION
  File: sections/ellora-trade-form.liquid
  Theme Editor Name: Trade Application Form
  Features:
  - Split 2-column layout: left narrative & trade concierge details, right application form
  - Native Shopify {% form 'contact' %} integration with custom trade fields
  - Professional role selector (Architect, Interior Designer, Builder, etc.)
  - Immediate confirmation banner upon successful submission
  - Direct WhatsApp and trade support links
  ==========================================================================
{% endcomment %}

<div class="el-section-wrapper el-sec-trade-form" id="trade-form">
  {%- assign tf_primary = section.settings.primary_color -%}
  {%- if tf_primary == blank or tf_primary == '#8E6356' or tf_primary == '#8e6356' or tf_primary == '#754F43' or tf_primary == '#754f43' or tf_primary == '#BA9587' or tf_primary == '#ba9587' or tf_primary == '#734E43' or tf_primary == '#734e43' or tf_primary == '#A36854' or tf_primary == '#a36854' -%}
    {%- assign tf_primary = '#CC9E8F' -%}
  {%- endif -%}
  {%- assign tf_primary_hover = section.settings.primary_hover -%}
  {%- if tf_primary_hover == blank or tf_primary_hover == '#8E6356' or tf_primary_hover == '#8e6356' or tf_primary_hover == '#754F43' or tf_primary_hover == '#754f43' or tf_primary_hover == '#BA9587' or tf_primary_hover == '#ba9587' or tf_primary_hover == '#734E43' or tf_primary_hover == '#734e43' or tf_primary_hover == '#A36854' or tf_primary_hover == '#a36854' -%}
    {%- assign tf_primary_hover = '#BF8673' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #trade-form {
      --el-tf-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
      --el-tf-primary: {{ tf_primary }};
      --el-tf-primary-hover: {{ tf_primary_hover }};
      --el-tf-dark: {{ section.settings.text_dark | default: '#1C1B19' }};
      --el-tf-muted: {{ section.settings.text_muted | default: '#68645F' }};
      --el-tf-border: {{ section.settings.border_color | default: '#ECE7E1' }};
      --el-tf-input-bg: {{ section.settings.input_bg | default: '#FAF8F5' }};
      --el-tf-card-bg: {{ section.settings.card_bg | default: '#FAF8F5' }};

      --el-tf-pt: {{ section.settings.padding_top | default: 90 }}px;
      --el-tf-pb: {{ section.settings.padding_bottom | default: 100 }}px;

      background-color: var(--el-tf-bg);
      color: var(--el-tf-dark);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      padding-top: var(--el-tf-pt);
      padding-bottom: var(--el-tf-pb);
      position: relative;
    }

    #trade-form *,
    #trade-form *::before,
    #trade-form *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #trade-form .el-tf-container {
      width: 90%;
      max-width: {{ section.settings.container_max_width | default: 1720 }}px;
      margin: 0 auto;
    }

    #trade-form .el-tf-layout {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      gap: 64px;
      align-items: flex-start;
    }

    /* Left Narrative Column */
    #trade-form .el-tf-kicker {
      font-size: 11.5px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 600;
      color: var(--el-tf-primary);
      margin-bottom: 12px;
      display: block;
    }

    #trade-form .el-tf-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 42px;
      font-weight: 400;
      color: var(--el-tf-dark);
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin-bottom: 20px;
    }

    #trade-form .el-tf-desc {
      font-size: 15px;
      color: var(--el-tf-muted);
      line-height: 1.7;
      margin-bottom: 32px;
    }

    #trade-form .el-tf-contact-card {
      background: var(--el-tf-card-bg);
      border: 1px solid var(--el-tf-border);
      border-radius: 2px;
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    #trade-form .el-tf-contact-item {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 13.5px;
      color: var(--el-tf-dark);
    }

    #trade-form .el-tf-contact-item svg {
      width: 18px;
      height: 18px;
      stroke: var(--el-tf-primary);
      flex-shrink: 0;
    }

    #trade-form .el-tf-contact-item a {
      color: var(--el-tf-dark);
      text-decoration: none;
      transition: color 0.2s;
    }

    #trade-form .el-tf-contact-item a:hover {
      color: var(--el-tf-primary);
    }

    /* Right Form Column */
    #trade-form .el-tf-form-box {
      background: #FFFFFF;
      border: 1px solid var(--el-tf-border);
      border-radius: 2px;
      padding: 40px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    #trade-form .el-tf-form-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 26px;
      font-weight: 500;
      color: var(--el-tf-dark);
      margin-bottom: 8px;
    }

    #trade-form .el-tf-form-subtitle {
      font-size: 13px;
      color: var(--el-tf-muted);
      margin-bottom: 28px;
    }

    #trade-form .el-tf-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    #trade-form .el-tf-field {
      margin-bottom: 20px;
    }

    #trade-form .el-tf-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--el-tf-dark);
      margin-bottom: 8px;
    }

    #trade-form .el-tf-input,
    #trade-form .el-tf-select,
    #trade-form .el-tf-textarea {
      width: 100%;
      background: var(--el-tf-input-bg);
      border: 1px solid var(--el-tf-border);
      border-radius: 2px;
      padding: 12px 14px;
      font-family: inherit;
      font-size: 14px;
      color: var(--el-tf-dark);
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    #trade-form .el-tf-input:focus,
    #trade-form .el-tf-select:focus,
    #trade-form .el-tf-textarea:focus {
      outline: none;
      border-color: var(--el-tf-primary);
      background: #FFFFFF;
    }

    #trade-form .el-tf-textarea {
      min-height: 110px;
      resize: vertical;
    }

    #trade-form .el-tf-submit-btn {
      width: 100%;
      padding: 16px 28px;
      background: var(--el-tf-primary, #CC9E8F) !important;
      color: #FFFFFF !important;
      border: 1px solid var(--el-tf-primary, #CC9E8F) !important;
      border-radius: 2px;
      font-family: inherit;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
      margin-top: 10px;
    }

    #trade-form .el-tf-submit-btn:hover {
      background: var(--el-tf-primary-hover, #BF8673) !important;
      border-color: var(--el-tf-primary-hover, #BF8673) !important;
    }

    /* Feedback Alerts */
    #trade-form .el-tf-success-alert {
      background: #F4F8F3;
      border: 1px solid #C4DFC1;
      color: #2F6F27;
      padding: 16px 20px;
      border-radius: 2px;
      margin-bottom: 24px;
      font-size: 14px;
    }

    #trade-form .el-tf-error-alert {
      background: #FDF3F2;
      border: 1px solid #EBC6C4;
      color: #A32A29;
      padding: 16px 20px;
      border-radius: 2px;
      margin-bottom: 24px;
      font-size: 14px;
    }

    @media (max-width: 900px) {
      #trade-form .el-tf-layout {
        grid-template-columns: 1fr;
        gap: 40px;
      }
      #trade-form .el-tf-form-box {
        padding: 24px;
      }
      #trade-form .el-tf-grid-2 {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }
  </style>

  <div class="el-tf-container">
    <div class="el-tf-layout">

      <!-- Left Column -->
      <div>
        {%- if section.settings.kicker != blank -%}
          <span class="el-tf-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="el-tf-title">{{ section.settings.title | default: 'Open a Trade Account' }}</h2>
        <p class="el-tf-desc">
          {{ section.settings.desc | default: 'Join our vetted network of architectural professionals. Trade accounts receive tiered discounts, bespoke cutting services, and direct access to our stone procurement team.' }}
        </p>

        <div class="el-tf-contact-card">
          <div class="el-tf-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--el-tf-muted); letter-spacing: 0.05em;">Direct Trade Desk</div>
              <a href="mailto:{{ section.settings.trade_email | default: 'trade@elloraspaces.com' }}">{{ section.settings.trade_email | default: 'trade@elloraspaces.com' }}</a>
            </div>
          </div>

          <div class="el-tf-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--el-tf-muted); letter-spacing: 0.05em;">Trade Phone / WhatsApp</div>
              <a href="tel:{{ section.settings.trade_phone | default: '+1 (555) 019-2834' }}">{{ section.settings.trade_phone | default: '+1 (555) 019-2834' }}</a>
            </div>
          </div>

          <div class="el-tf-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <div>
              <div style="font-size: 11px; text-transform: uppercase; color: var(--el-tf-muted); letter-spacing: 0.05em;">Turnaround Timing</div>
              <span>{{ section.settings.turnaround_text | default: 'Applications reviewed within 24 business hours' }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Form Column -->
      <div class="el-tf-form-box">
        <h3 class="el-tf-form-title">Trade Application</h3>
        <p class="el-tf-form-subtitle">Please provide your studio information to activate your trade pricing tier.</p>

        {%- form 'contact', id: 'tradeContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="el-tf-success-alert">
              Thank you for applying for an Ellora Trade Account. Our partnership team will review your credentials and reach out within 24 hours with your tier activation details.
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="el-tf-error-alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <input type="hidden" name="contact[tags]" value="trade_application, professional_account">

          <div class="el-tf-grid-2">
            <div>
              <label class="el-tf-label" for="TradeName">Your Name *</label>
              <input type="text" name="contact[name]" id="TradeName" class="el-tf-input" required placeholder="Jane Doe">
            </div>
            <div>
              <label class="el-tf-label" for="TradeCompany">Company / Studio *</label>
              <input type="text" name="contact[company]" id="TradeCompany" class="el-tf-input" required placeholder="Studio Studio Architects">
            </div>
          </div>

          <div class="el-tf-grid-2">
            <div>
              <label class="el-tf-label" for="TradeEmail">Business Email *</label>
              <input type="email" name="contact[email]" id="TradeEmail" class="el-tf-input" required placeholder="jane@studio.com">
            </div>
            <div>
              <label class="el-tf-label" for="TradePhone">Phone / WhatsApp *</label>
              <input type="tel" name="contact[phone]" id="TradePhone" class="el-tf-input" required placeholder="+1 555 019 2834">
            </div>
          </div>

          <div class="el-tf-grid-2">
            <div>
              <label class="el-tf-label" for="TradeRole">Professional Role *</label>
              <select name="contact[professional_role]" id="TradeRole" class="el-tf-select" required>
                <option value="Interior Designer">Interior Designer / Stylist</option>
                <option value="Architect">Architect / Architectural Studio</option>
                <option value="General Contractor">General Contractor / Builder</option>
                <option value="Property Developer">Property Developer</option>
                <option value="Landscape Architect">Landscape Architect</option>
                <option value="Other Trade">Other Industry Professional</option>
              </select>
            </div>
            <div>
              <label class="el-tf-label" for="TradeWebsite">Website or Instagram</label>
              <input type="text" name="contact[portfolio]" id="TradeWebsite" class="el-tf-input" placeholder="www.yourstudio.com">
            </div>
          </div>

          <div class="el-tf-field">
            <label class="el-tf-label" for="TradeMessage">Current Project Details or Material Requirements</label>
            <textarea name="contact[body]" id="TradeMessage" class="el-tf-textarea" placeholder="Tell us about any upcoming residential or commercial projects, square meterage, or stone specifications you are currently sourcing..."></textarea>
          </div>

          <button type="submit" class="el-tf-submit-btn">
            Submit Trade Application &rarr;
          </button>
        {%- endform -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trade Application Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Subtitle",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Open a Trade Account"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Narrative Copy",
      "default": "Join our vetted network of architectural professionals. Trade accounts receive tiered discounts, bespoke cutting services, and direct access to our stone procurement team."
    },
    {
      "type": "text",
      "id": "trade_email",
      "label": "Trade Email Address",
      "default": "trade@elloraspaces.com"
    },
    {
      "type": "text",
      "id": "trade_phone",
      "label": "Trade Phone / WhatsApp",
      "default": "+1 (555) 019-2834"
    },
    {
      "type": "text",
      "id": "turnaround_text",
      "label": "Turnaround Note",
      "default": "Applications reviewed within 24 business hours"
    },
    {
      "type": "header",
      "content": "Colors & Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1720
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Contact Card Background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input Fields Background",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#CC9E8F"
    },
    {
      "type": "color",
      "id": "primary_hover",
      "label": "Primary Accent Hover",
      "default": "#BF8673"
    },
    {
      "type": "color",
      "id": "text_dark",
      "label": "Dark Text Color",
      "default": "#1C1B19"
    },
    {
      "type": "color",
      "id": "text_muted",
      "label": "Muted Text Color",
      "default": "#68645F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ECE7E1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Trade Application Form"
    }
  ]
}
{% endschema %}

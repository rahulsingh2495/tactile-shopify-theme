                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                          </svg>
                          <span>{{ tab3_btn_text }}</span>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        {%- endcapture -%}

        <!-- Left Desktop Navigation (Supports Backend Menu Picker) -->
        <nav class="el-header-left" aria-label="Main Navigation">
          {%- assign current_menu = section.settings.menu -%}
          {%- if current_menu != blank and linklists[current_menu].links.size > 0 -%}
            
            {%- for link in linklists[current_menu].links -%}
              {%- assign title_clean = link.title | strip | downcase -%}
              {%- assign is_link_active = false -%}
              {%- if link.active or link.current -%}
                {%- assign is_link_active = true -%}
              {%- elsif request.path == link.url -%}
                {%- assign is_link_active = true -%}
              {%- elsif link.url != '/' and link.url != blank and request.path contains link.url -%}
                {%- assign is_link_active = true -%}
              {%- elsif template.name == 'index' and link.url == '/' or link.url == routes.root_url -%}
                {%- assign is_link_active = true -%}
              {%- endif -%}

              {%- if title_clean == 'shop' and section.settings.enable_mega_menu -%}
                <!-- Shop Link with Interactive Mega Menu -->
                <div class="el-nav-item el-has-megamenu{% if is_link_active %} is-active{% endif %}" id="elShopMegaMenuParent-{{ section.id }}">
                  <a href="{{ link.url }}" class="el-nav-link{% if is_link_active %} is-active{% endif %}" id="elShopBtn-{{ section.id }}" aria-haspopup="true" aria-expanded="false"{% if is_link_active %} aria-current="page"{% endif %}>
                    <span>{{ link.title }}</span>
                    <svg class="el-chevron-icon" viewBox="0 0 10 6">
                      <polyline points="1 1 5 5 9 1"></polyline>
                    </svg>
                  </a>
                  {{ megamenu_panel_html }}
                </div>

              {%- elsif link.links != blank -%}
                {%- if link.links.first.links != blank -%}
                  <!-- Multi-column Mega Dropdown for Nested Menu -->
                  <div class="el-nav-item el-has-megamenu{% if is_link_active %} is-active{% endif %}">
                    <a href="{{ link.url }}" class="el-nav-link{% if is_link_active %} is-active{% endif %}"{% if is_link_active %} aria-current="page"{% endif %}>
                      <span>{{ link.title }}</span>
                      <svg class="el-chevron-icon" viewBox="0 0 10 6">
                        <polyline points="1 1 5 5 9 1"></polyline>
                      </svg>
                    </a>
                    <div class="el-mega-dropdown">
                      {%- for child in link.links -%}
                        <div class="el-mega-col">
                          <a href="{{ child.url }}" class="el-mega-col-heading">{{ child.title }}</a>
                          {%- if child.links != blank -%}
                            <ul class="el-mega-col-list">
                              {%- for grand in child.links -%}
                                {%- assign is_grand_active = false -%}
                                {%- if grand.active or grand.current or request.path == grand.url -%}
                                  {%- assign is_grand_active = true -%}
                                {%- endif -%}
                                <li><a href="{{ grand.url }}"{% if is_grand_active %} class="is-active" aria-current="page"{% endif %}>{{ grand.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <!-- Single Dropdown Menu -->
                  <div class="el-nav-item el-has-dropdown{% if is_link_active %} is-active{% endif %}">
                    <a href="{{ link.url }}" class="el-nav-link{% if is_link_active %} is-active{% endif %}"{% if is_link_active %} aria-current="page"{% endif %}>
                      <span>{{ link.title }}</span>
                      <svg class="el-chevron-icon" viewBox="0 0 10 6">
                        <polyline points="1 1 5 5 9 1"></polyline>
                      </svg>
                    </a>
                    <ul class="el-dropdown-menu">
                      {%- for child in link.links -%}
                        {%- assign is_child_active = false -%}
                        {%- if child.active or child.current or request.path == child.url -%}
                          {%- assign is_child_active = true -%}
                        {%- endif -%}
                        <li><a href="{{ child.url }}"{% if is_child_active %} class="is-active" aria-current="page"{% endif %}>{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}

              {%- else -%}
                <!-- Direct Link -->
                <a href="{{ link.url }}" class="el-nav-link{% if is_link_active %} is-active{% endif %}"{% if is_link_active %} aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- endif -%}

            {%- endfor -%}

          {%- else -%}
            
            <!-- Default Fallback Navigation if No Menu Chosen Yet -->
            <div class="el-nav-item el-has-megamenu" id="elShopMegaMenuParent-{{ section.id }}">
              <button type="button" class="el-nav-link" id="elShopBtn-{{ section.id }}" aria-haspopup="true" aria-expanded="false">
                <span>Shop</span>
                <svg class="el-chevron-icon" viewBox="0 0 10 6">
                  <polyline points="1 1 5 5 9 1"></polyline>
                </svg>
              </button>
              {{ megamenu_panel_html }}
            </div>

            <a href="/pages/inspiration" class="el-nav-link{% if request.path == '/pages/inspiration' %} is-active{% endif %}"{% if request.path == '/pages/inspiration' %} aria-current="page"{% endif %}>Inspiration</a>
            <a href="/pages/about" class="el-nav-link{% if request.path == '/pages/about' %} is-active{% endif %}"{% if request.path == '/pages/about' %} aria-current="page"{% endif %}>About</a>

          {%- endif -%}
        </nav>

        <!-- Center Brand Logo -->
        <div class="el-header-center">
          <a href="/" class="el-header-logo-link" aria-label="Ellora Spaces Home">
            {%- if section.settings.logo != blank -%}
              {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'el-header-logo-img', alt: 'Ellora Spaces' }}
            {%- else -%}
              <img 
                src="{{ section.settings.fallback_logo | default: 'https://cdn.shopify.com/s/files/1/0990/3685/6647/files/ellora_logo_final.png?v=1793618092' }}" 
                alt="Ellora Spaces" 
                class="el-header-logo-img">
            {%- endif -%}
          </a>
        </div>

        <!-- Right Utility Icons -->
        <div class="el-header-right">
          <!-- 1. Search Icon -->
          {%- if section.settings.show_search -%}
            <a href="{{ routes.search_url }}" class="el-header-icon-btn" aria-label="Search Collection">
              <svg viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </a>
          {%- endif -%}

          <!-- 2. Wishlist Icon -->
          {%- if section.settings.show_wishlist -%}
            <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="el-header-icon-btn el-header-wishlist-btn" aria-label="View Wishlist">
              <svg viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
              <span class="el-header-wishlist-badge" id="elWishlistBadge-{{ section.id }}" style="display:none;">0</span>
            </a>
          {%- endif -%}

          <!-- 3. Shopping Basket Icon with Count -->
          {%- if section.settings.show_cart -%}
            <a href="{{ routes.cart_url }}" 
               class="el-header-icon-btn el-header-cart-btn" 
               {% if section.settings.enable_slide_cart %}id="cart-icon-bubble" data-cart-drawer-trigger="true"{% endif %} 
               aria-label="Shopping Basket">
              <svg viewBox="0 0 24 24">
                <path d="M2 9h20l-2 11H4L2 9z"></path>
                <path d="M7 9l4.5-6"></path>
                <path d="M17 9l-4.5-6"></path>
                <line x1="4.5" y1="14" x2="19.5" y2="14"></line>
              </svg>
              <span class="el-header-cart-badge" id="elCartBadge-{{ section.id }}" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>{{ cart.item_count }}</span>
            </a>
          {%- endif -%}

          <!-- 4. User Account Icon -->
          {%- if section.settings.show_account -%}
            <a href="{{ routes.account_url }}" class="el-header-icon-btn el-header-icon-account" aria-label="Customer Account">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="10" r="3"></circle>
                <path d="M6.168 18.849a6 6 0 0 1 11.664 0"></path>
              </svg>
            </a>
          {%- endif -%}
        </div>

      </div>
    </div>
  </header>

  <!-- ========================================================================
       SLIDE-OUT LEFT MOBILE DRAWER (RESPONSIVE BACKEND MENU)
       ======================================================================== -->
  <div class="el-drawer-overlay" id="elDrawerOverlay-{{ section.id }}" aria-hidden="true"></div>
  <aside class="el-mobile-drawer" id="elMobileDrawer-{{ section.id }}" aria-label="Mobile Navigation" role="dialog" aria-modal="true" aria-hidden="true" inert>
    <div class="el-drawer-header">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'el-drawer-logo-img', alt: 'Ellora Spaces' }}
      {%- else -%}
        <img src="{{ section.settings.fallback_logo | default: 'https://cdn.shopify.com/s/files/1/0990/3685/6647/files/ellora_logo_final.png?v=1793618092' }}" alt="Ellora Spaces" class="el-drawer-logo-img">
      {%- endif -%}
      <button type="button" class="el-drawer-close-btn" id="elDrawerClose-{{ section.id }}" aria-label="Close navigation menu">✕</button>
    </div>

    <!-- Dynamic Mobile Drawer Shop Accordion Capture -->
    {%- capture mobile_drawer_shop_accordion_html -%}
      <div class="el-drawer-accordion-group">
        <button type="button" class="el-drawer-accordion-btn is-active">
          <span>Shop Products</span>
          <svg viewBox="0 0 10 6"><polyline points="1 1 5 5 9 1"></polyline></svg>
        </button>
        <div class="el-drawer-accordion-content is-open">
          <div class="el-drawer-subheading">{{ section.settings.megamenu_sidebar_heading | default: 'Shop By Collection' }}</div>
          <a href="{{ routes.all_products_collection_url }}">All Products</a>
          {%- for col in collections -%}
            {%- unless col.handle == 'frontpage' or col.handle == 'all' or col.all_products_count == 0 -%}
              <a href="{{ col.url }}">
                {{ col.title }}
                {%- if col.all_products_count > 0 -%} ({{ col.all_products_count }}){%- endif -%}
              </a>
            {%- endunless -%}
          {%- endfor -%}

          <div class="el-drawer-subheading" style="margin-top: 14px;">{{ tab1_heading }}</div>
          <a href="{{ tab1_btn_url }}" style="color: {{ tab1_btn_bg }}; font-weight: 500;">{{ tab1_btn_text }}</a>
          {%- if section.settings.mm_tab1_col2_menu != blank and linklists[section.settings.mm_tab1_col2_menu].links.size > 0 -%}
            {%- for lk in linklists[section.settings.mm_tab1_col2_menu].links -%}
              <a href="{{ lk.url }}">{{ lk.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}?type=honed-wall-panels">Honed Wall Panels</a>
            <a href="{{ routes.all_products_collection_url }}?type=fluted-linear-panels">Fluted Linear Panels</a>
            <a href="{{ routes.all_products_collection_url }}?type=textured-relief-panels">Textured Relief Panels</a>
            <a href="{{ routes.all_products_collection_url }}?type=large-format-slabs">Large Format Slabs</a>
          {%- endif -%}
          <a href="{{ routes.all_products_collection_url }}?size=full-wall-panels">Full Wall Panels</a>
          <a href="{{ routes.all_products_collection_url }}?size=modular-tiles">Modular Tiles</a>
          <a href="{{ routes.all_products_collection_url }}?color=gold"><span class="el-color-dot" style="background:#D4AF37;"></span>Gold Tone Panels</a>
          <a href="{{ routes.all_products_collection_url }}?color=silver"><span class="el-color-dot" style="background:#C5C6C7;"></span>Silver Tone Panels</a>
          <a href="{{ routes.all_products_collection_url }}?color=blue"><span class="el-color-dot" style="background:#8BAAC1;"></span>Blue</a>
          <a href="{{ routes.all_products_collection_url }}?color=multicoloured"><span class="el-color-dot" style="background: conic-gradient(from 180deg at 50% 50%, #C89D91 0deg, #D4AF37 90deg, #8BAAC1 180deg, #2D5A43 270deg, #C89D91 360deg);"></span>Multicoloured</a>

          <div class="el-drawer-subheading" style="margin-top: 14px;">{{ tab2_heading }}</div>
          <a href="{{ tab2_btn_url }}" style="color: {{ tab2_btn_bg }}; font-weight: 500;">{{ tab2_btn_text }}</a>
          {%- if section.settings.mm_tab2_col2_menu != blank and linklists[section.settings.mm_tab2_col2_menu].links.size > 0 -%}
            {%- for lk in linklists[section.settings.mm_tab2_col2_menu].links -%}
              <a href="{{ lk.url }}">{{ lk.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="{{ tiles_base_url }}?type=porcelain">Porcelain</a>
            <a href="{{ tiles_base_url }}?type=handmade-ceramic">Handmade Ceramic</a>
            <a href="{{ tiles_base_url }}?type=mirror-work">Mirror Work</a>
          {%- endif -%}
          <a href="{{ tiles_base_url }}?size=full-tile-panels">Full Tile Panels</a>
          <a href="{{ tiles_base_url }}?size=cluster-panel-tiles">Cluster Panel Tiles</a>
          <a href="{{ tiles_base_url }}?color=gold"><span class="el-color-dot" style="background:#D4AF37;"></span>Gold</a>
          <a href="{{ tiles_base_url }}?color=silver"><span class="el-color-dot" style="background:#C5C6C7;"></span>Silver</a>
          <a href="{{ tiles_base_url }}?color=blue"><span class="el-color-dot" style="background:#8BAAC1;"></span>Blue</a>
          <a href="{{ tiles_base_url }}?color=multicoloured"><span class="el-color-dot" style="background: conic-gradient(from 180deg at 50% 50%, #C89D91 0deg, #D4AF37 90deg, #8BAAC1 180deg, #2D5A43 270deg, #C89D91 360deg);"></span>Multicoloured</a>

          <div class="el-drawer-subheading" style="margin-top: 14px;">{{ tab3_label }}{% if tab3_badge != blank %} ({{ tab3_badge }}){% endif %}</div>
          <span style="font-size: 13px; color: var(--el-hd-gray); padding: 4px 0 10px 0; display: block;">{{ tab3_desc }}</span>
        </div>
      </div>
    {%- endcapture -%}

    <nav class="el-drawer-nav">
      {%- if current_menu != blank and linklists[current_menu].links.size > 0 -%}
        {%- for link in linklists[current_menu].links -%}
          {%- assign title_clean = link.title | strip | downcase -%}
          {%- assign is_drawer_active = false -%}
          {%- if link.active or link.current -%}
            {%- assign is_drawer_active = true -%}
          {%- elsif request.path == link.url -%}
            {%- assign is_drawer_active = true -%}
          {%- elsif link.url != '/' and link.url != blank and request.path contains link.url -%}
            {%- assign is_drawer_active = true -%}
          {%- elsif template.name == 'index' and link.url == '/' or link.url == routes.root_url -%}
            {%- assign is_drawer_active = true -%}
          {%- endif -%}

          {%- if title_clean == 'shop' and section.settings.enable_mega_menu -%}
            <!-- Mobile Shop Accordion with Full Collections & Tiles -->
            {{ mobile_drawer_shop_accordion_html }}

          {%- elsif link.links != blank -%}
            <!-- Dynamic Mobile Accordion for any backend link with children -->
            <div class="el-drawer-accordion-group">
              <button type="button" class="el-drawer-accordion-btn{% if is_drawer_active %} is-active{% endif %}">
                <span>{{ link.title }}</span>
                <svg viewBox="0 0 10 6"><polyline points="1 1 5 5 9 1"></polyline></svg>
              </button>
              <div class="el-drawer-accordion-content">
                {%- for child in link.links -%}
                  {%- assign is_drawer_child_active = false -%}
                  {%- if child.active or child.current or request.path == child.url -%}
                    {%- assign is_drawer_child_active = true -%}
                  {%- endif -%}
                  {%- if child.links != blank -%}
                    <div class="el-drawer-subheading">{{ child.title }}</div>
                    {%- for grand in child.links -%}
                      {%- assign is_drawer_grand_active = false -%}
                      {%- if grand.active or grand.current or request.path == grand.url -%}
                        {%- assign is_drawer_grand_active = true -%}
                      {%- endif -%}
                      <a href="{{ grand.url }}"{% if is_drawer_grand_active %} class="is-active" aria-current="page"{% endif %}>{{ grand.title }}</a>
                    {%- endfor -%}
                  {%- else -%}
                    <a href="{{ child.url }}"{% if is_drawer_child_active %} class="is-active" aria-current="page"{% endif %}>{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- else -%}
            <a href="{{ link.url }}" class="el-drawer-link{% if is_drawer_active %} is-active{% endif %}"{% if is_drawer_active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}

        {%- endfor -%}

      {%- else -%}
        
        <!-- Default Fallback Drawer Navigation -->
        {{ mobile_drawer_shop_accordion_html }}

        <a href="/pages/inspiration" class="el-drawer-link{% if request.path == '/pages/inspiration' %} is-active{% endif %}"{% if request.path == '/pages/inspiration' %} aria-current="page"{% endif %}>Inspiration</a>
        <a href="/pages/about" class="el-drawer-link{% if request.path == '/pages/about' %} is-active{% endif %}"{% if request.path == '/pages/about' %} aria-current="page"{% endif %}>About</a>

      {%- endif -%}

      {%- if section.settings.show_wishlist -%}
        <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="el-drawer-link">Wishlist</a>
      {%- endif -%}

      {%- if section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="el-drawer-link">My Account</a>
      {%- endif -%}
    </nav>

    <div class="el-drawer-footer">
      <div><strong>{{ section.settings.drawer_footer_title | default: 'Ellora Spaces Studio' }}</strong></div>
      <div>{{ section.settings.drawer_footer_sub | default: 'Crafting enduring, organic living spaces.' }}</div>
      <div style="margin-top: 4px; display: flex; gap: 16px;">
        {%- if section.settings.top_menu != blank and linklists[section.settings.top_menu].links.size > 0 -%}
          {%- for top_link in linklists[section.settings.top_menu].links -%}
            <a href="{{ top_link.url }}">{{ top_link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- assign drawer_advice_url = section.settings.faq_url | default: '/pages/advice-hub' -%}
          {%- if drawer_advice_url contains '/pages/faq' or drawer_advice_url contains '/pages/faqs' -%}
            {%- assign drawer_advice_url = '/pages/advice-hub' -%}
          {%- endif -%}
          {%- assign drawer_advice_label = section.settings.faq_label | default: 'Advice Hub' -%}
          {%- if drawer_advice_label == 'FAQ' or drawer_advice_label == 'FAQs' or drawer_advice_label == 'Faq' or drawer_advice_label == blank -%}
            {%- assign drawer_advice_label = 'Advice Hub' -%}
          {%- endif -%}
          {%- if drawer_advice_label != blank -%}
            <a href="{{ drawer_advice_url }}">{{ drawer_advice_label }}</a>
          {%- endif -%}
          <a href="{{ section.settings.trade_url | default: '/pages/trade' }}">{{ section.settings.trade_label | default: 'Trade' }}</a>
          {%- assign drawer_contact_label = section.settings.contact_label | default: 'Contact' -%}
          {%- if drawer_contact_label == blank -%}
            {%- assign drawer_contact_label = 'Contact' -%}
          {%- endif -%}
          {%- if section.settings.show_top_contact != false -%}
            <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">{{ drawer_contact_label }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </aside>

  <!-- Floating Side Sign-Up Tab & Slide-Out Drawer (Mandarin Stone inspired) -->
  <button type="button" class="el-side-signup-tab" id="elSideSignupTab-{{ section.id }}" aria-label="Sign up for exclusive inspiration &amp; offers">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
    <span>Sign up &amp; Offers</span>
  </button>

  <!-- Floating Side Sign-Up Drawer Wrapper -->
  <div class="el-side-signup-wrapper" id="elSideSignupWrapper-{{ section.id }}" aria-hidden="true">
    <div class="el-side-signup-overlay" id="elSideSignupOverlay-{{ section.id }}"></div>
    <aside class="el-side-signup-drawer" id="elSideSignupDrawer-{{ section.id }}" aria-label="Newsletter Signup" role="dialog" aria-modal="true">
      <!-- Drawer Header Bar -->
      <header class="el-ss-header">
        <span class="el-ss-kicker">Ellora Living &bull; Circle</span>
        <button type="button" class="el-ss-close-btn" id="elSideSignupClose-{{ section.id }}" aria-label="Close signup drawer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px; display: block;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </header>

      <!-- Drawer Content Body -->
      <div class="el-ss-body">
        <!-- Visual Architectural Hero Card -->
        <div class="el-ss-hero-card">
          <span class="el-ss-tag">Curated Privileges</span>
          <h3 class="el-ss-title">Sign up for exclusive inspiration &amp; offers</h3>
          <p class="el-ss-desc">Join our design circle for curated surface edits, material previews, and architectural guidance delivered directly to your inbox.</p>
        </div>

        <!-- Signup Form -->
        {% form 'customer', id: 'SideSignupForm', class: 'el-ss-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter, side-signup">
          <div class="el-ss-input-wrap">
            <svg class="el-ss-mail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <input 
              type="email" 
              name="contact[email]" 
              class="el-ss-input" 
              placeholder="Enter your email address" 
              required 
              autocomplete="email"
              aria-label="Email address">
          </div>
          <button type="submit" class="el-ss-submit-btn">
            <span>Sign Up for Inspiration</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          {% if form.posted_successfully? %}
            <div class="el-ss-success">
              <svg viewBox="0 0 24 24" fill="none" stroke="#2d6a4f" stroke-width="2" style="width: 16px; height: 16px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              <span>Thank you for subscribing to Ellora Living notes!</span>
            </div>
          {% endif %}
        {% endform %}

        <!-- Perks / Benefits List -->
        <div class="el-ss-perks">
          <div class="el-ss-perk-item">
            <span class="el-ss-perk-bullet">&bull;</span>
            <div class="el-ss-perk-text">
              <strong>Seasonal Curations:</strong> First look at new limestone, travertine &amp; patterned surfaces.
            </div>
          </div>
          <div class="el-ss-perk-item">
            <span class="el-ss-perk-bullet">&bull;</span>
            <div class="el-ss-perk-text">
              <strong>Sample Swatch Priority:</strong> Access to material consultations and complimentary swatches.
            </div>
          </div>
          <div class="el-ss-perk-item">
            <span class="el-ss-perk-bullet">&bull;</span>
            <div class="el-ss-perk-text">
              <strong>Architectural Edits:</strong> Technical insights on stone care, sealing, and laying guides.
            </div>
          </div>
        </div>

        <p class="el-ss-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width: 12px; height: 12px; display: inline-block; vertical-align: middle; margin-right: 4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          We respect your inbox. Unsubscribe at any time with one click.
        </p>
      </div>
    </aside>
  </div>

  {%- if section.settings.enable_slide_cart -%}
    <!-- ========================================================================
         ELLORA SLIDE CART DRAWER
         ======================================================================== -->
    <div class="el-cart-drawer-wrapper" id="elCartDrawer-{{ section.id }}" aria-hidden="true">
      <div class="el-cd-overlay" id="elCartDrawerOverlay-{{ section.id }}"></div>
      <aside class="el-cd-panel" aria-label="Shopping Cart Drawer" role="dialog" aria-modal="true">
        <!-- Header -->
        <header class="el-cd-header">
          <h2 class="el-cd-header-title">
            Your Basket
            <span class="el-cd-header-count" id="elDrawerCount-{{ section.id }}">({{ cart.item_count }})</span>
          </h2>
          <button type="button" class="el-cd-close-btn" id="elCartDrawerClose-{{ section.id }}" aria-label="Close cart">&times;</button>
        </header>

        <!-- Scrollable Items Body -->
        <div class="el-cd-items-body" id="elDrawerItems-{{ section.id }}">
          {%- if cart.item_count > 0 -%}
            {%- for item in cart.items -%}
              <div class="el-cd-item" data-key="{{ item.key }}">
                <a href="{{ item.url }}" class="el-cd-item-media">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" loading="lazy">
                  {%- else -%}
                    <div style="width:100%; height:100%; background:#ECE7E1;"></div>
                  {%- endif -%}
                </a>
                <div class="el-cd-item-info">
                  <div>
                    <a href="{{ item.url }}" class="el-cd-item-title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <div class="el-cd-item-variant">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    <div class="el-cd-item-price">{{ item.final_line_price | money }}</div>
                  </div>
                  <div class="el-cd-item-actions">
                    <div class="el-cd-stepper">
                      <button type="button" class="el-cd-stepper-btn el-cd-minus" data-key="{{ item.key }}" aria-label="Decrease">&minus;</button>
                      <input type="number" class="el-cd-stepper-input" value="{{ item.quantity }}" min="0" data-key="{{ item.key }}" aria-label="Quantity">
                      <button type="button" class="el-cd-stepper-btn el-cd-plus" data-key="{{ item.key }}" aria-label="Increase">&plus;</button>
                    </div>
                    <button type="button" class="el-cd-item-remove-btn" data-key="{{ item.key }}">Remove</button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="el-cd-empty">
              <div class="el-cd-empty-icon">
                <svg viewBox="0 0 24 24"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>
              </div>
              <h3 class="el-cd-empty-title">Your basket is empty</h3>
              <p class="el-cd-empty-desc">Explore our curated architectural tiles and natural surfaces to begin.</p>
              <a href="/collections/all" class="el-cd-empty-btn">Explore Collections &rarr;</a>
            </div>
          {%- endif -%}
        </div>

        <!-- Drawer Footer -->
        <footer class="el-cd-footer" id="elDrawerFooter-{{ section.id }}" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
          <div class="el-cd-subtotal-row">
            <span>Subtotal</span>
            <span id="elDrawerSubtotal-{{ section.id }}">{{ cart.total_price | money }}</span>
          </div>
          <p class="el-cd-tax-note">Taxes, freight delivery and discounts are calculated at checkout.</p>
          <a href="/checkout" class="el-cd-checkout-btn">Proceed to Checkout &rarr;</a>
          <a href="{{ routes.cart_url }}" class="el-cd-view-cart-btn">View Full Shopping Basket</a>
        </footer>
      </aside>
    </div>
  {%- endif -%}
</div>

<!-- ========================================================================
     JAVASCRIPT: MEGA MENU TABS, MOBILE SLIDE DRAWER & ACCORDIONS
     ======================================================================== -->
<script>
  (function() {
    var sectionId = "{{ section.id }}";
    var shopParent = document.getElementById('elShopMegaMenuParent-' + sectionId);
    var shopBtn = document.getElementById('elShopBtn-' + sectionId);
    var megaClose = document.getElementById('elMegaMenuClose-' + sectionId);

    // Highlight Active Navigation Link based on current page URL
    function highlightActiveLinks() {
      var currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      var headerRoot = document.getElementById('ellora-header-' + sectionId);
      if (!headerRoot) return;

      var navLinks = headerRoot.querySelectorAll('.el-nav-link, .el-drawer-link, .el-dropdown-menu li a, .el-mega-col-list li a');
      navLinks.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href || href === '#' || href.startsWith('javascript:')) return;
        try {
          var url = new URL(href, window.location.origin);
          var linkPath = url.pathname.replace(/\/$/, '') || '/';

          var isMatch = false;
          if (linkPath === '/' && currentPath === '/') {
            isMatch = true;
          } else if (linkPath !== '/' && (currentPath === linkPath || (linkPath.length > 1 && currentPath.indexOf(linkPath) === 0))) {
            isMatch = true;
          }

          if (isMatch) {
            link.classList.add('is-active');
            link.setAttribute('aria-current', 'page');
            var parentDropdown = link.closest('.el-has-dropdown, .el-has-megamenu');
            if (parentDropdown) {
              var parentBtn = parentDropdown.querySelector(':scope > .el-nav-link');
              if (parentBtn) {
                parentBtn.classList.add('is-active');
                parentBtn.setAttribute('aria-current', 'page');
              }
            }
          }
        } catch(err) {}
      });
    }
    highlightActiveLinks();

    // Desktop Mega Menu Tabs
    // Notify Me button: immediately close mega menu and scroll smoothly to newsletter
    var notifyBtns = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-wp-banner-btn, #elWallpaperNotifyBtn-' + sectionId);
    notifyBtns.forEach(function(notifyBtn) {
      notifyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        // 1. Immediately close the mega menu
        shopParents.forEach(function(p) {
          p.classList.remove('is-open');
          p.classList.add('is-closed');
        });
        shopNavBtns.forEach(function(btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.blur();
        });

        // 2. Locate the newsletter section & input
        var targetSection = document.getElementById('newsletter') || 
                            document.querySelector('.el-footer-newsletter-card') || 
                            document.querySelector('.footer__newsletter') ||
                            document.querySelector('form.el-footer-newsletter-form');
        var emailInput = document.querySelector('#NewsletterInput, .el-footer-input, input[type="email"][name="contact[email]"], input[name="email"]');

        if (targetSection) {
          targetSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else if (emailInput) {
          emailInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          window.location.hash = 'newsletter';
        }

        // 3. Highlight and focus input
        if (emailInput) {
          setTimeout(function() {
            emailInput.focus();
            emailInput.classList.add('el-input-pulse');
            setTimeout(function() {
              emailInput.classList.remove('el-input-pulse');
            }, 2500);
          }, 450);
        }
      });
    });

    // Desktop Mega Menu Tabs Switching
    var tabBtns = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-megamenu-tab');
    var tabPanes = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-tab-pane');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var targetId = btn.getAttribute('data-tab');

        tabBtns.forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanes.forEach(function(p) {
          p.classList.remove('is-active');
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        var activePane = document.getElementById(targetId);
        if (activePane) {
          activePane.classList.add('is-active');
        }
      });
    });

    // Desktop Mega Menu Toggle & Close Handling
    var shopParents = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-has-megamenu');
    var megaCloses = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-megamenu-close');
    var shopNavBtns = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-has-megamenu > .el-nav-link');

    // Handle clicking the Close Cross icon (✕)
    megaCloses.forEach(function(closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        shopParents.forEach(function(p) {
          p.classList.remove('is-open');
          p.classList.add('is-closed');
        });
        shopNavBtns.forEach(function(btn) {
          btn.setAttribute('aria-expanded', 'false');
          btn.blur();
        });
      });
    });

    // Reset is-closed state when cursor leaves the megamenu area
    shopParents.forEach(function(p) {
      p.addEventListener('mouseleave', function() {
        p.classList.remove('is-closed');
      });
    });

    // When hovering or clicking the "Shop" link again, remove is-closed so it reopens cleanly
    shopNavBtns.forEach(function(btn) {
      btn.addEventListener('mouseenter', function() {
        var parent = btn.closest('.el-has-megamenu');
        if (parent) {
          parent.classList.remove('is-closed');
        }
      });

      btn.addEventListener('click', function(e) {
        if (window.innerWidth > 991) {
          e.preventDefault();
          e.stopPropagation();
          var parent = btn.closest('.el-has-megamenu');
          if (!parent) return;
          var wasClosed = parent.classList.contains('is-closed');
          parent.classList.remove('is-closed');
          var isOpen = parent.classList.contains('is-open');
          if (isOpen && !wasClosed) {
            parent.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            parent.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });

    // Close Mega Menu when clicking outside or pressing Escape
    document.addEventListener('click', function(e) {
      shopParents.forEach(function(p) {
        if (!p.contains(e.target)) {
          p.classList.remove('is-open');
          p.classList.remove('is-closed');
          var b = p.querySelector(':scope > .el-nav-link');
          if (b) b.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        shopParents.forEach(function(p) {
          p.classList.remove('is-open');
          p.classList.add('is-closed');
          var b = p.querySelector(':scope > .el-nav-link');
          if (b) {
            b.setAttribute('aria-expanded', 'false');
            b.blur();
          }
        });
      }
    });

    // Sticky Scroll Shadow Listener
    window.addEventListener('scroll', function() {
      var hdWrap = document.getElementById('ellora-header-' + sectionId);
      if (hdWrap && hdWrap.getAttribute('data-sticky') === 'true') {
        if (window.scrollY > 15) {
          hdWrap.classList.add('is-scrolled');
        } else {
          hdWrap.classList.remove('is-scrolled');
        }
      }
    }, { passive: true });

    // Mobile Slide-Left Drawer Toggle
    var mobileToggle = document.getElementById('elMobileToggle-' + sectionId);
    var mobileDrawer = document.getElementById('elMobileDrawer-' + sectionId);
    var drawerOverlay = document.getElementById('elDrawerOverlay-' + sectionId);
    var drawerClose = document.getElementById('elDrawerClose-' + sectionId);
    var headerWrapper = document.getElementById('ellora-header-' + sectionId);

    // Initial state: ensure closed drawer is inert & hidden from assistive tech
    if (mobileDrawer) {
      mobileDrawer.setAttribute('inert', '');
      mobileDrawer.setAttribute('aria-hidden', 'true');
    }

    function openDrawer() {
      if (mobileDrawer) {
        mobileDrawer.classList.add('is-open');
        mobileDrawer.removeAttribute('inert');
        mobileDrawer.setAttribute('aria-hidden', 'false');
      }
      if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'true');
      if (drawerOverlay) drawerOverlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      document.body.classList.add('el-mobile-drawer-open');
      if (headerWrapper) {
        headerWrapper.classList.add('has-drawer-open');
        var sectionParent = headerWrapper.closest('.shopify-section');
        if (sectionParent) {
          sectionParent.classList.add('has-drawer-open');
          sectionParent.style.zIndex = '9999999';
        }
      }
      // Focus drawer close button or first interactive element
      setTimeout(function() {
        if (drawerClose) {
          drawerClose.focus();
        } else if (mobileDrawer) {
          var firstFocusable = mobileDrawer.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
          if (firstFocusable) firstFocusable.focus();
        }
      }, 50);
    }

    function closeDrawer() {
      if (mobileDrawer) {
        mobileDrawer.classList.remove('is-open');
        mobileDrawer.setAttribute('inert', '');
        mobileDrawer.setAttribute('aria-hidden', 'true');
      }
      if (mobileToggle) {
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileToggle.focus();
      }
      if (drawerOverlay) drawerOverlay.classList.remove('is-open');
      document.body.style.overflow = '';
      document.body.classList.remove('el-mobile-drawer-open');
      if (headerWrapper) {
        headerWrapper.classList.remove('has-drawer-open');
        var sectionParent = headerWrapper.closest('.shopify-section');
        if (sectionParent) {
          sectionParent.classList.remove('has-drawer-open');
          sectionParent.style.zIndex = '';
        }
      }
    }

    if (mobileToggle) mobileToggle.addEventListener('click', openDrawer);
    if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
    if (drawerOverlay) drawerOverlay.addEventListener('click', closeDrawer);

    // Escape Key to Close Drawer & Restore Focus
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (mobileDrawer && mobileDrawer.classList.contains('is-open')) {
          e.preventDefault();
          closeDrawer();
        }
        if (shopParent && shopParent.classList.contains('is-open')) {
          shopParent.classList.remove('is-open');
        }
      }
    });

    // Focus trap inside mobile drawer
    if (mobileDrawer) {
      mobileDrawer.addEventListener('keydown', function(e) {
        if (e.key !== 'Tab' || !mobileDrawer.classList.contains('is-open')) return;
        var focusable = mobileDrawer.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])');
        if (!focusable.length) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }

    // Mobile Accordions (Supports all dynamic backend menus)
    var accBtns = document.querySelectorAll('#ellora-header-' + sectionId + ' .el-drawer-accordion-btn');
    accBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var content = btn.nextElementSibling;
        if (content) {
          var isOpen = content.classList.contains('is-open');
          if (isOpen) {
            content.classList.remove('is-open');
            btn.classList.remove('is-active');
          } else {
            content.classList.add('is-open');
            btn.classList.add('is-active');
          }
        }
      });
    });

    // Real-Time Wishlist Badge Sync
    function syncHeaderWishlistBadge() {
      try {
        var list = JSON.parse(localStorage.getItem('ellora_wishlist') || '[]');
        var count = Array.isArray(list) ? list.length : 0;
        var badge = document.getElementById('elWishlistBadge-' + sectionId);
        if (badge) {
          if (count > 0) {
            badge.textContent = count;
            badge.style.display = 'flex';
          } else {
            badge.style.display = 'none';
          }
        }
      } catch(e) {}
    }
    syncHeaderWishlistBadge();
    window.addEventListener('ellora:wishlist:updated', syncHeaderWishlistBadge);
    window.addEventListener('storage', syncHeaderWishlistBadge);

    // Real-Time Cart Badge Sync
    function updateCartBadges(count) {
      var badges = document.querySelectorAll('.el-header-cart-badge');
      badges.forEach(function(badge) {
        badge.textContent = count;
        if (count > 0) {
          badge.style.display = 'flex';
        } else {
          badge.style.display = 'none';
        }
      });
    }

    function syncHeaderCartBadge() {
      fetch('/cart.js')
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          if (cart && typeof cart.item_count !== 'undefined') {
            updateCartBadges(cart.item_count);
          }
        })
        .catch(function(err) {});
    }

    // Immediate sync on load
    syncHeaderCartBadge();

    // Listen to all cart events across the theme
    window.addEventListener('ellora:cart:refresh', syncHeaderCartBadge);
    window.addEventListener('ellora:cart:updated', function(e) {
      if (e && e.detail && typeof e.detail.item_count !== 'undefined') {
        updateCartBadges(e.detail.item_count);
      } else {
        syncHeaderCartBadge();
      }
    });
    window.addEventListener('cart:updated', syncHeaderCartBadge);
    window.addEventListener('cart:refresh', syncHeaderCartBadge);
    document.addEventListener('cart:updated', syncHeaderCartBadge);
    window.addEventListener('storage', syncHeaderCartBadge);

    // ========================================================================
    // ELLORA SLIDE CART DRAWER CONTROLLER
    // ========================================================================
    var currencySymbol = {{ cart.currency.symbol | json }} || '£';

    function formatMoney(cents) {
      var val = (Number(cents) / 100).toFixed(2);
      return currencySymbol + val;
    }

    var drawerWrapper = document.getElementById('elCartDrawer-' + sectionId);

    function openSlideCart() {
      // 1. Try our built-in Ellora slide cart drawer
      if (drawerWrapper) {
        drawerWrapper.classList.add('is-open');
        drawerWrapper.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        refreshSlideCart();
        return;
      }

      // 2. Fallback: Any other .el-cart-drawer-wrapper in DOM
      var extDrawers = document.querySelectorAll('.el-cart-drawer-wrapper');
      if (extDrawers.length > 0) {
        extDrawers.forEach(function(el) { el.classList.add('is-open'); });
        document.body.style.overflow = 'hidden';
        return;
      }

      // 3. Fallback: Dawn's native <cart-drawer>
      var dawnDrawer = document.querySelector('cart-drawer');
      if (dawnDrawer) {
        try {
          if (typeof dawnDrawer.open === 'function') dawnDrawer.open();
        } catch(e) {}
        dawnDrawer.classList.add('animate', 'active');
        var inner = dawnDrawer.querySelector('.drawer__inner');
        if (inner) inner.style.transform = 'translateX(0)';
        document.body.classList.add('overflow-hidden');
        return;
      }

      // 4. Fallback: navigate to /cart if no drawer component
      window.location.href = '/cart';
    }

    function closeSlideCart() {
      if (drawerWrapper) {
        drawerWrapper.classList.remove('is-open');
        drawerWrapper.setAttribute('aria-hidden', 'true');
      }
      var extDrawers = document.querySelectorAll('.el-cart-drawer-wrapper');
      extDrawers.forEach(function(el) { el.classList.remove('is-open'); });
      document.body.style.overflow = '';

      var dawnDrawer = document.querySelector('cart-drawer');
      if (dawnDrawer) {
        dawnDrawer.classList.remove('active');
        document.body.classList.remove('overflow-hidden');
      }
    }

    function refreshSlideCart() {
      fetch('/cart.js')
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          renderSlideCart(cart);
          updateCartBadges(cart.item_count);
        })
        .catch(function(err) {
          console.error('Error refreshing cart:', err);
        });
    }

    function renderSlideCart(cart) {
      if (!drawerWrapper) return;
      var countEl = document.getElementById('elDrawerCount-' + sectionId);
      if (countEl) countEl.textContent = '(' + cart.item_count + ')';

      var itemsContainer = document.getElementById('elDrawerItems-' + sectionId);
      var footerContainer = document.getElementById('elDrawerFooter-' + sectionId);
      var subtotalEl = document.getElementById('elDrawerSubtotal-' + sectionId);

      if (!itemsContainer) return;

      if (cart.item_count === 0) {
        itemsContainer.innerHTML = '<div class="el-cd-empty">' +
          '<div class="el-cd-empty-icon">' +
            '<svg viewBox="0 0 24 24"><path d="M2 9h20l-2 11H4L2 9z"></path><path d="M7 9l4.5-6"></path><path d="M17 9l-4.5-6"></path></svg>' +
          '</div>' +
          '<h3 class="el-cd-empty-title">Your basket is empty</h3>' +
          '<p class="el-cd-empty-desc">Explore our curated architectural tiles and natural surfaces to begin.</p>' +
          '<a href="/collections/all" class="el-cd-empty-btn">Explore Collections &rarr;</a>' +
        '</div>';
        if (footerContainer) footerContainer.style.display = 'none';
        return;
      }

      if (footerContainer) {
        footerContainer.style.display = 'flex';
        if (subtotalEl) subtotalEl.textContent = formatMoney(cart.total_price);
      }

      var html = '';
      cart.items.forEach(function(item) {
        var imgHtml = item.image ? '<img src="' + item.image + '" alt="' + (item.title ? item.title.replace(/"/g, '&quot;') : '') + '" loading="lazy">' : '<div style="width:100%; height:100%; background:#ECE7E1;"></div>';
        var variantHtml = (item.variant_title && item.variant_title !== 'Default Title') ? '<div class="el-cd-item-variant">' + item.variant_title + '</div>' : '';
        var linePrice = formatMoney(item.final_line_price || item.line_price);

        html += '<div class="el-cd-item" data-key="' + item.key + '">' +
          '<a href="' + item.url + '" class="el-cd-item-media">' + imgHtml + '</a>' +
          '<div class="el-cd-item-info">' +
            '<div>' +
              '<a href="' + item.url + '" class="el-cd-item-title">' + (item.product_title || item.title) + '</a>' +
              variantHtml +
              '<div class="el-cd-item-price">' + linePrice + '</div>' +
            '</div>' +
            '<div class="el-cd-item-actions">' +
              '<div class="el-cd-stepper">' +
                '<button type="button" class="el-cd-stepper-btn el-cd-minus" data-key="' + item.key + '" aria-label="Decrease">&minus;</button>' +
                '<input type="number" class="el-cd-stepper-input" value="' + item.quantity + '" min="0" data-key="' + item.key + '" aria-label="Quantity">' +
                '<button type="button" class="el-cd-stepper-btn el-cd-plus" data-key="' + item.key + '" aria-label="Increase">&plus;</button>' +
              '</div>' +
              '<button type="button" class="el-cd-item-remove-btn" data-key="' + item.key + '">Remove</button>' +
            '</div>' +
          '</div>' +
        '</div>';
      });

      itemsContainer.innerHTML = html;
    }

    function updateDrawerQuantity(key, quantity) {
      var itemsContainer = document.getElementById('elDrawerItems-' + sectionId);
      if (itemsContainer) itemsContainer.style.opacity = '0.5';

      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ id: key, quantity: quantity })
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Cart change failed');
        return res.json();
      })
      .then(function(cart) {
        renderSlideCart(cart);
        updateCartBadges(cart.item_count);
        window.dispatchEvent(new CustomEvent('ellora:cart:updated', { detail: cart }));
      })
      .catch(function(err) {
        console.error('Error changing cart quantity:', err);
        refreshSlideCart();
      })
      .finally(function() {
        if (itemsContainer) itemsContainer.style.opacity = '1';
      });
    }

    // Bind Drawer Controls
    if (drawerWrapper) {
      var closeBtn = document.getElementById('elCartDrawerClose-' + sectionId);
      var overlay = document.getElementById('elCartDrawerOverlay-' + sectionId);
      if (closeBtn) closeBtn.addEventListener('click', closeSlideCart);
      if (overlay) overlay.addEventListener('click', closeSlideCart);

      drawerWrapper.addEventListener('click', function(e) {
        var plus = e.target.closest('.el-cd-plus');
        if (plus) {
          var key = plus.getAttribute('data-key');
          var input = drawerWrapper.querySelector('.el-cd-stepper-input[data-key="' + key + '"]');
          var cur = input ? (parseInt(input.value, 10) || 0) : 0;
          updateDrawerQuantity(key, cur + 1);
          return;
        }

        var minus = e.target.closest('.el-cd-minus');
        if (minus) {
          var key = minus.getAttribute('data-key');
          var input = drawerWrapper.querySelector('.el-cd-stepper-input[data-key="' + key + '"]');
          var cur = input ? (parseInt(input.value, 10) || 0) : 0;
          updateDrawerQuantity(key, Math.max(0, cur - 1));
          return;
        }

        var removeBtn = e.target.closest('.el-cd-item-remove-btn');
        if (removeBtn) {
          var key = removeBtn.getAttribute('data-key');
          updateDrawerQuantity(key, 0);
          return;
        }
      });

      drawerWrapper.addEventListener('change', function(e) {
        if (e.target.classList.contains('el-cd-stepper-input')) {
          var key = e.target.getAttribute('data-key');
          var val = parseInt(e.target.value, 10);
          if (!isNaN(val) && val >= 0) {
            updateDrawerQuantity(key, val);
          }
        }
      });
    }

    // Escape key closes drawer
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSlideCart();
    });

    // Cart Drawer Toggle Button on Header
    var headerEl = document.getElementById('ellora-header-' + sectionId);
    if (headerEl) {
      var cartBtn = headerEl.querySelector('.el-header-cart-btn');
      if (cartBtn) {
        cartBtn.addEventListener('click', function(e) {
          var isDrawerEnabled = cartBtn.hasAttribute('data-cart-drawer-trigger');
          if (!isDrawerEnabled) {
            return; // Normal navigation to /cart
          }
          e.preventDefault();
          openSlideCart();
        });
      }
    }

    // Delegate any button with [data-cart-drawer-trigger]
    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('[data-cart-drawer-trigger]');
      if (trigger && !trigger.classList.contains('el-header-cart-btn')) {
        e.preventDefault();
        openSlideCart();
      }
    });

    // Global Events
    window.addEventListener('ellora:cart:open', openSlideCart);
    window.addEventListener('ellora:cart:close', closeSlideCart);
    window.addEventListener('ellora:cart:toggle', function() {
      if (drawerWrapper && drawerWrapper.classList.contains('is-open')) {
        closeSlideCart();
      } else {
        openSlideCart();
      }
    });
    window.addEventListener('cart-drawer:open', openSlideCart);
    window.addEventListener('cart:open', openSlideCart);
    document.addEventListener('cart:open', openSlideCart);

    // Side Sign-Up Drawer Listeners (Mandarin Stone inspired)
    var sideSignupWrapper = document.getElementById('elSideSignupWrapper-' + sectionId);
    var sideSignupTab = document.getElementById('elSideSignupTab-' + sectionId);
    var sideSignupDrawer = document.getElementById('elSideSignupDrawer-' + sectionId);
    var sideSignupOverlay = document.getElementById('elSideSignupOverlay-' + sectionId);
    var sideSignupClose = document.getElementById('elSideSignupClose-' + sectionId);

    function openSideSignup() {
      if (sideSignupWrapper) {
        sideSignupWrapper.classList.add('is-open');
        sideSignupWrapper.setAttribute('aria-hidden', 'false');
      }
      if (sideSignupDrawer) sideSignupDrawer.classList.add('is-open');
      if (sideSignupOverlay) sideSignupOverlay.classList.add('is-open');
      document.body.classList.add('el-side-signup-open');
      document.body.style.overflow = 'hidden';
    }

    function closeSideSignup() {
      if (sideSignupWrapper) {
        sideSignupWrapper.classList.remove('is-open');
        sideSignupWrapper.setAttribute('aria-hidden', 'true');
      }
      if (sideSignupDrawer) sideSignupDrawer.classList.remove('is-open');
      if (sideSignupOverlay) sideSignupOverlay.classList.remove('is-open');
      document.body.classList.remove('el-side-signup-open');
      document.body.style.overflow = '';
    }

    if (sideSignupTab) sideSignupTab.addEventListener('click', openSideSignup);
    if (sideSignupClose) sideSignupClose.addEventListener('click', closeSideSignup);
    if (sideSignupOverlay) sideSignupOverlay.addEventListener('click', closeSideSignup);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && sideSignupWrapper && (sideSignupWrapper.classList.contains('is-open') || (sideSignupDrawer && sideSignupDrawer.classList.contains('is-open')))) {
        closeSideSignup();
      }
    });
  })();
</script>


{% comment %}
  ==========================================================================
  ELLORA SPACES — HEADER & ANNOUNCEMENT BAR SECTION
  File: sections/ellora-header.liquid
  Pixel-perfect implementation matching Ellora luxury editorial design
  Features:
  - Dynamic Shopify Menu Picker (choose any menu created in Online Store > Navigation)
  - Multi-level dropdowns & Multi-column Mega Menu support for backend menu items
  - Built-in luxury interactive Mega Menu option for "Shop" (Tiles + Wallpapers tabs, Collections)
  - Top Announcement Bar: Dusty rose/terracotta background (#CC9E8F), left banner text, right utility links / menu
  - Center Logo: Official Ellora final logo CDN with desktop & mobile width sliders + image picker
  - Right Utility Icons: Search, Wishlist, Shopping Basket with real-time cart badge, Customer Account
  - Fully Responsive: Mobile hamburger button with smooth slide-left drawer navigation & multi-accordion
  - Full Shopify Theme Customizer controls for all texts, colors, links, and toggles
  ==========================================================================
{% endcomment %}

<div class="el-header-wrapper" id="ellora-header-{{ section.id }}" data-sticky="{{ section.settings.enable_sticky }}">
  {%- assign hd_top_bg = section.settings.top_bg -%}
  {%- if hd_top_bg == blank or hd_top_bg == '#8E6356' or hd_top_bg == '#8e6356' or hd_top_bg == '#754F43' or hd_top_bg == '#754f43' or hd_top_bg == '#BA9587' or hd_top_bg == '#ba9587' or hd_top_bg == '#734E43' or hd_top_bg == '#734e43' or hd_top_bg == '#A36854' or hd_top_bg == '#a36854' -%}
    {%- assign hd_top_bg = '#CC9E8F' -%}
  {%- endif -%}
  {%- assign hd_accent = section.settings.accent_color -%}
  {%- if hd_accent == blank or hd_accent == '#8E6356' or hd_accent == '#8e6356' or hd_accent == '#754F43' or hd_accent == '#754f43' or hd_accent == '#BA9587' or hd_accent == '#ba9587' or hd_accent == '#734E43' or hd_accent == '#734e43' or hd_accent == '#A36854' or hd_accent == '#a36854' -%}
    {%- assign hd_accent = '#CC9E8F' -%}
  {%- endif -%}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    #ellora-header-{{ section.id }} {
      --el-hd-top-bg: {{ hd_top_bg }};
      --el-hd-top-text: {{ section.settings.top_text_color | default: '#FFFFFF' }};
      --el-hd-bg: {{ section.settings.header_bg | default: '#FFFFFF' }};
      --el-hd-primary: {{ hd_accent }};
      --el-hd-primary-hover: #BF8673;
      --el-hd-dark: {{ section.settings.text_color | default: '#1C1B19' }};
      --el-hd-menu-color: {{ section.settings.menu_link_color | default: section.settings.text_color | default: '#1C1B19' }};
      --el-hd-menu-hover: {{ section.settings.menu_link_hover_color | default: section.settings.accent_color | default: '#805D52' }};
      --el-hd-menu-active: {{ section.settings.menu_link_active_color | default: section.settings.accent_color | default: '#CC9E8F' }};
      --el-hd-text: #44403B;
      --el-hd-muted: #736E67;
      --el-hd-border: #E8E3DC;
      --el-hd-border-light: #EFEAE4;
      --el-hd-sidebar-bg: #FAF4EF;
      --el-hd-font-serif: 'Cormorant Garamond', Georgia, serif;
      --el-hd-font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      width: 100%;
      position: relative;
      z-index: 999;
      font-family: var(--el-hd-font-sans);
      color: var(--el-hd-dark);
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Sticky Header Support */
    .shopify-section-group-header-group,
    #shopify-section-{{ section.id }},
    .shopify-section:has(#ellora-header-{{ section.id }}[data-sticky="true"]) {
      position: sticky !important;
      top: 0 !important;
      z-index: 1000 !important;
    }

    #ellora-header-{{ section.id }}[data-sticky="true"] {
      position: sticky;
      top: 0;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      transition: box-shadow 0.25s ease;
    }

    #ellora-header-{{ section.id }}.is-scrolled {
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
    }

    #ellora-header-{{ section.id }} *,
    #ellora-header-{{ section.id }} *::before,
    #ellora-header-{{ section.id }} *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    #ellora-header-{{ section.id }} .el-hd-container {
      width: 90%;
      max-width: 1720px;
      margin: 0 auto;
      position: relative;
    }

    /* -----------------------------------------------------------------------
       1. TOP ANNOUNCEMENT BAR
       ----------------------------------------------------------------------- */
    #ellora-header-{{ section.id }} .el-announcement-bar {
      background-color: var(--el-hd-top-bg);
      color: var(--el-hd-top-text);
      min-height: 32px;
      padding: 6px 0;
      display: flex;
      align-items: center;
      font-size: 12.5px;
      letter-spacing: 0.01em;
      transition: background-color 0.3s ease;
    }

    #ellora-header-{{ section.id }} .el-announcement-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 16px;
    }

    #ellora-header-{{ section.id }} .el-announcement-left {
      font-family: var(--el-hd-font-sans);
      font-weight: 400;
      color: var(--el-hd-top-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-decoration: none;
    }

    #ellora-header-{{ section.id }} .el-announcement-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    #ellora-header-{{ section.id }} .el-announcement-links a {
      color: var(--el-hd-top-text);
      text-decoration: none;
      font-size: 12.5px;
      font-weight: 400;
      transition: opacity 0.2s ease;
      white-space: nowrap;
    }

    #ellora-header-{{ section.id }} .el-announcement-links a:hover {
      opacity: 0.8;
    }

    /* -----------------------------------------------------------------------
       2. MAIN HEADER
       ----------------------------------------------------------------------- */
    #ellora-header-{{ section.id }} .el-main-header {
      background-color: var(--el-hd-bg);
      {% if section.settings.show_bottom_border %}
        border-bottom: 1px solid var(--el-hd-border);
      {% endif %}
      padding-top: {{ section.settings.header_padding_y | default: 16 }}px;
      padding-bottom: {{ section.settings.header_padding_y | default: 16 }}px;
      display: flex;
      align-items: center;
      position: relative;
    }

    #ellora-header-{{ section.id }} .el-main-header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      position: relative;
    }

    /* Left Navigation */
    #ellora-header-{{ section.id }} .el-header-left {
      display: flex;
      align-items: center;
      gap: 30px;
      flex: 1;
    }

    #ellora-header-{{ section.id }} .el-nav-item {
      display: inline-flex;
      align-items: center;
      position: relative;
    }

    #ellora-header-{{ section.id }} .el-nav-link {
      font-family: var(--el-hd-font-sans);
      font-size: 14.5px;
      font-weight: 500;
      color: var(--el-hd-menu-color, #1C1B19);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 0;
      transition: color 0.2s ease;
      cursor: pointer;
      background: none;
      border: none;
      white-space: nowrap;
      position: relative;
    }

    #ellora-header-{{ section.id }} .el-nav-link:hover {
      color: #805D52;
    }

    #ellora-header-{{ section.id }} .el-nav-link.is-active,
    #ellora-header-{{ section.id }} .el-nav-link[aria-current="page"] {
      color: var(--el-hd-menu-active, #CC9E8F) !important;
      font-weight: 600;
      position: relative;
    }

    #ellora-header-{{ section.id }} .el-nav-link.is-active::after,
    #ellora-header-{{ section.id }} .el-nav-link[aria-current="page"]::after {
      content: '';
      position: absolute;
      bottom: 2px;
      left: 0;
      width: 100%;
      height: 2px;
      background-color: var(--el-hd-menu-active, #CC9E8F);
      border-radius: 1px;
    }

    #ellora-header-{{ section.id }} .el-nav-link.is-active .el-chevron-icon,
    #ellora-header-{{ section.id }} .el-nav-link[aria-current="page"] .el-chevron-icon {
      stroke: var(--el-hd-menu-active, #CC9E8F);
    }

    #ellora-header-{{ section.id }} .el-chevron-icon {
      width: 9px;
      height: 6px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform 0.25s ease;
    }

    #ellora-header-{{ section.id }} .el-has-dropdown:hover > .el-nav-link .el-chevron-icon,
    #ellora-header-{{ section.id }} .el-has-megamenu:hover > .el-nav-link .el-chevron-icon,
    #ellora-header-{{ section.id }} .el-has-megamenu.is-open > .el-nav-link .el-chevron-icon {
      transform: rotate(180deg);
    }

    /* Standard Dropdown Menu */
    #ellora-header-{{ section.id }} .el-has-dropdown {
      position: relative;
    }

    #ellora-header-{{ section.id }} .el-dropdown-menu {
      position: absolute;
      top: calc(100% + 2px);
      left: 0;
      min-width: 210px;
      background: #FFFFFF;
      border: 1px solid var(--el-hd-border);
      border-radius: 4px;
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
      padding: 8px 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
      z-index: 1000;
      list-style: none;
    }

    #ellora-header-{{ section.id }} .el-has-dropdown:hover > .el-dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    #ellora-header-{{ section.id }} .el-dropdown-menu li a {
      display: block;
      padding: 9px 20px;
      font-family: var(--el-hd-font-sans);
      font-size: 13.5px;
      color: var(--el-hd-menu-color, #1C1B19);
      text-decoration: none;
      transition: color 0.15s ease, background-color 0.15s ease;
    }

    #ellora-header-{{ section.id }} .el-dropdown-menu li a:hover {
      color: var(--el-hd-menu-hover, #CC9E8F);
      background-color: #FAF8F5;
    }

    #ellora-header-{{ section.id }} .el-dropdown-menu li a.is-active,
    #ellora-header-{{ section.id }} .el-dropdown-menu li a[aria-current="page"] {
      color: var(--el-hd-menu-active, #CC9E8F) !important;
      background-color: #FAF8F5;
      font-weight: 600;
    }

    /* Multi-Column Mega Dropdown (for 3-level Backend Menus) */
    #ellora-header-{{ section.id }} .el-mega-dropdown {
      position: absolute;
      top: calc(100% + 2px);
      left: 0;
      min-width: 540px;
      max-width: 860px;
      background: #FFFFFF;
      border: 1px solid var(--el-hd-border);
      border-radius: 4px;
      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.08);
      padding: 24px 28px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 24px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
      z-index: 1000;
    }

    #ellora-header-{{ section.id }} .el-has-megamenu:hover > .el-mega-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    #ellora-header-{{ section.id }} .el-mega-col-heading {
      font-family: var(--el-hd-font-serif);
      font-size: 16.5px;
      font-weight: 600;
      color: var(--el-hd-dark);
      text-decoration: none;
      display: block;
      margin-bottom: 12px;
      transition: color 0.2s ease;
    }

    #ellora-header-{{ section.id }} .el-mega-col-heading:hover {
      color: var(--el-hd-primary);
    }

    #ellora-header-{{ section.id }} .el-mega-col-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    #ellora-header-{{ section.id }} .el-mega-col-list a {
      font-family: var(--el-hd-font-sans);
      font-size: 13px;
      color: var(--el-hd-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    #ellora-header-{{ section.id }} .el-mega-col-list a:hover {
      color: var(--el-hd-primary);
    }

    /* Center Brand Logo */
    #ellora-header-{{ section.id }} .el-header-center {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    #ellora-header-{{ section.id }} .el-header-logo-link {
      display: inline-block;
      text-decoration: none;
      transition: opacity 0.25s ease;
    }

    #ellora-header-{{ section.id }} .el-header-logo-link:hover {
      opacity: 0.85;
    }

    #ellora-header-{{ section.id }} .el-header-logo-img {
      width: {{ section.settings.logo_width | default: 110 }}px;
      height: auto;
      display: block;
      margin: 0 auto;
    }

    /* Right Utility Icons */
    #ellora-header-{{ section.id }} .el-header-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 20px;
      flex: 1;
    }

    #ellora-header-{{ section.id }} .el-header-icon-btn {
      background: none;
      border: none;
      padding: 6px;
      cursor: pointer;
      color: var(--el-hd-dark);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      text-decoration: none;
      transition: color 0.2s ease, transform 0.2s ease;
    }

    #ellora-header-{{ section.id }} .el-header-icon-btn:hover {
      color: #805D52;
      transform: translateY(-1px);
    }

    #ellora-header-{{ section.id }} .el-header-icon-btn svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
      display: block;
    }

    #ellora-header-{{ section.id }} .el-header-cart-badge,
    #ellora-header-{{ section.id }} .el-header-wishlist-badge {
      position: absolute;
      top: 0;
      right: -3px;
      background: var(--el-hd-primary);
      color: #FFFFFF;
      font-size: 9px;
      font-weight: 600;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    /* Mobile Hamburger Button */
    #ellora-header-{{ section.id }} .el-mobile-toggle {
      display: none;
      background: none;
      border: none;
      padding: 8px;
      cursor: pointer;
      color: var(--el-hd-dark);
      margin-left: -8px;
    }

    #ellora-header-{{ section.id }} .el-mobile-toggle svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      display: block;
    }

    /* -----------------------------------------------------------------------
       3. LUXURY TABBED MEGA MENU (FOR "SHOP")
       ----------------------------------------------------------------------- */
    #ellora-header-{{ section.id }} .el-megamenu-panel {
      position: absolute;
      top: calc(100% + 2px);
      left: 0;
      width: 1140px;
      max-width: calc(100vw - 80px);
      background: #FFFFFF;
      border: 1px solid var(--el-hd-border);
      border-radius: 4px;
      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.08);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(8px);
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  visibility 0.25s;
      z-index: 1000;
      overflow: hidden;
    }

    @media (max-width: 1200px) {
      #ellora-header-{{ section.id }} .el-megamenu-panel {
        width: 880px;
        max-width: calc(100vw - 80px);
      }
    }

    #ellora-header-{{ section.id }} .el-megamenu-panel::before {
      content: '';
      position: absolute;
      top: -16px;
      left: 0;
      right: 0;
      height: 16px;
      background: transparent;
    }

    #ellora-header-{{ section.id }} .el-has-megamenu:hover > .el-megamenu-panel,
    #ellora-header-{{ section.id }} .el-has-megamenu.is-open > .el-megamenu-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    #ellora-header-{{ section.id }} .el-has-megamenu:not(:hover):not(.is-open) > .el-megamenu-panel,
    #ellora-header-{{ section.id }} .el-has-megamenu:not(:hover):not(.is-open) .el-tab-pane {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }

    #ellora-header-{{ section.id }} .el-has-megamenu.is-closed > .el-megamenu-panel {
      opacity: 0 !important;
      visibility: hidden !important;
      transform: translateY(8px) !important;
      pointer-events: none !important;
      transition: none !important;
    }

    #ellora-header-{{ section.id }} .el-has-megamenu.is-closed > .el-nav-link .el-chevron-icon {
      transform: rotate(0deg) !important;
    }

    #ellora-header-{{ section.id }} .el-megamenu-header {
      height: 50px;
      padding: 0 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--el-hd-border-light);
      background: #FFFFFF;
    }

    #ellora-header-{{ section.id }} .el-megamenu-title {
      font-family: var(--el-hd-font-serif);
      font-size: 20px;
      font-weight: 500;
      color: #805D52;
      margin: 0;
      letter-spacing: 0.01em;
    }

    #ellora-header-{{ section.id }} .el-megamenu-close {
      background: none;
      border: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      color: var(--el-hd-muted);
      cursor: pointer;
      padding: 0;
      border-radius: 4px;
      transition: color 0.2s ease, background-color 0.2s ease;
    }

    #ellora-header-{{ section.id }} .el-megamenu-close:hover {
      color: var(--el-hd-dark);
      background-color: #F5F2EC;
    }

    #ellora-header-{{ section.id }} .el-megamenu-body {
      display: grid;
      grid-template-columns: 215px 1fr;
      min-height: auto;
      align-items: stretch;
    }

    #ellora-header-{{ section.id }} .el-megamenu-sidebar {
      background: var(--el-hd-sidebar-bg);
      padding: 22px 22px 20px;
      border-right: 1px solid #F0ECE6;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: auto;
      box-sizing: border-box;
      max-height: 440px;
      overflow-y: auto;
    }

    #ellora-header-{{ section.id }} .el-megamenu-sidebar::-webkit-scrollbar {
      width: 4px;
    }

    #ellora-header-{{ section.id }} .el-megamenu-sidebar::-webkit-scrollbar-thumb {
      background: #D9D2C9;
      border-radius: 4px;
    }

    #ellora-header-{{ section.id }} .el-sidebar-count {
      font-size: 11.5px;
      color: var(--el-hd-muted);
      margin-left: 3px;
    }

    #ellora-header-{{ section.id }} .el-sidebar-heading {
      font-family: var(--el-hd-font-serif);
      font-size: 17px;
      font-weight: 600;
      color: var(--el-hd-dark);
      margin: 0 0 16px 0;
      letter-spacing: -0.01em;
    }

    #ellora-header-{{ section.id }} .el-sidebar-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    #ellora-header-{{ section.id }} .el-sidebar-list a {
      font-family: var(--el-hd-font-sans);
      font-size: 13px;
      font-weight: 400;
      color: var(--el-hd-text);
      text-decoration: none;
      transition: color 0.2s ease, transform 0.2s ease;
      display: inline-block;
    }

    #ellora-header-{{ section.id }} .el-sidebar-list a:hover {
      color: #805D52;
      transform: translateX(2px);
    }

    #ellora-header-{{ section.id }} .el-megamenu-content {
      padding: 0;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      flex: 1;
      height: 100%;
      min-height: auto;
      box-sizing: border-box;
    }

    #ellora-header-{{ section.id }} .el-megamenu-tabs {
      display: flex;
      gap: 28px;
      border-bottom: 1px solid var(--el-hd-border-light);
      margin-bottom: 0;
      padding: 12px 28px 0;
      flex-shrink: 0;
    }

    #ellora-header-{{ section.id }} .el-megamenu-tab {
      font-family: var(--el-hd-font-sans);
      font-size: 13.5px;
      font-weight: 500;
      color: var(--el-hd-muted);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0 0 10px 0;
      position: relative;
      transition: color 0.2s ease;
    }

    #ellora-header-{{ section.id }} .el-megamenu-tab:hover {
      color: var(--el-hd-dark);
    }

    #ellora-header-{{ section.id }} .el-megamenu-tab.is-active {
      color: var(--el-hd-dark);
      font-weight: 600;
      border-bottom: 2px solid var(--el-hd-dark);
      margin-bottom: -1px;
    }

    #ellora-header-{{ section.id }} .el-megamenu-panes-wrap {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      width: 100%;
      flex: 1;
      min-height: 330px;
    }

    #ellora-header-{{ section.id }} .el-tab-pane {
      grid-column: 1;
      grid-row: 1;
      display: grid;
      grid-template-columns: 1.25fr 1.15fr 1.15fr 1.1fr;
      gap: 28px;
      align-items: start;
      align-content: start;
      padding: 20px 28px 20px;
      box-sizing: border-box;
      width: 100%;
      height: 100%;
      min-height: 330px;
